From efafdd20a644e78ba5a5db6401b502e6ee4e1aea Mon Sep 17 00:00:00 2001
From: Ramachandran Venkataramani <ramavenk@codeaurora.org>
Date: Mon, 15 May 2017 12:14:44 -0700
Subject: [PATCH] ion: Add hvenv driver for ion

Add hvenv driver for ion

Change-Id: Ie99f8f839c9185f440cd7b37bd40f607de392d3d
Signed-off-by: Ramachandran Venkataramani <ramavenk@codeaurora.org>
---
 drivers/staging/android/ion/ion_hvenv_driver.c | 206 +++++++++++++++++++++++++
 1 file changed, 206 insertions(+)
 create mode 100644 drivers/staging/android/ion/ion_hvenv_driver.c

diff --git a/drivers/staging/android/ion/ion_hvenv_driver.c b/drivers/staging/android/ion/ion_hvenv_driver.c
new file mode 100644
index 0000000..dbd3b4a
--- /dev/null
+++ b/drivers/staging/android/ion/ion_hvenv_driver.c
@@ -0,0 +1,206 @@
+/*
+ * drivers/gpu/ion/ion_dummy_driver.c
