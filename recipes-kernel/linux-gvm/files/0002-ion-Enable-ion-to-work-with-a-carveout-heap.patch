--- a/drivers/staging/android/ion/Makefile
+++ b/drivers/staging/android/ion/Makefile
@@ -7,6 +7,6 @@ obj-$(CONFIG_ION_TEST) += ion_test.o
 ifdef CONFIG_COMPAT
 obj-$(CONFIG_ION) += compat_ion.o
 endif
-obj-$(CONFIG_ION_DUMMY) += ion_dummy_driver.o
+obj-$(CONFIG_ION_DUMMY) += ion_hvenv_driver.o
 obj-$(CONFIG_ION_TEGRA) += tegra/
 obj-$(CONFIG_ION_MSM) += msm/
diff --git a/drivers/staging/android/ion/ion_carveout_heap.c b/drivers/staging/android/ion/ion_carveout_heap.c
old mode 100755
new mode 100644
index e702ce6..b71a6d7
--- a/drivers/staging/android/ion/ion_carveout_heap.c
+++ b/drivers/staging/android/ion/ion_carveout_heap.c
@@ -157,7 +157,9 @@ struct ion_heap *ion_carveout_heap_create(struct ion_platform_heap *heap_data)
 	page = pfn_to_page(PFN_DOWN(heap_data->base));
 	size = heap_data->size;
 
+#ifndef CONFIG_MSM_GVM_QUIN
 	ion_pages_sync_for_device(NULL, page, size, DMA_BIDIRECTIONAL);
+#endif
 
 	ret = ion_heap_pages_zero(page, size, pgprot_writecombine(PAGE_KERNEL));
 	if (ret)
diff --git a/drivers/staging/android/ion/ion_hvenv_driver.c b/drivers/staging/android/ion/ion_hvenv_driver.c
index dbd3b4a..d66e716 100644
--- a/drivers/staging/android/ion/ion_hvenv_driver.c
+++ b/drivers/staging/android/ion/ion_hvenv_driver.c
@@ -27,35 +27,29 @@
 #include <linux/genalloc.h>
 #include "ion.h"
 #include "ion_priv.h"
+#include "ion_hvenv_driver.h"
+
+#define ION_SYSTEM_HEAP_ID 25
+#define ION_AUDIO_HEAP_ID 28
 
 static struct ion_device *idev;
 static struct ion_heap **heaps;
 
 static struct ion_platform_heap dummy_heaps[] = {
-		{
-			.id	= ION_HEAP_TYPE_SYSTEM,
-			.type	= ION_HEAP_TYPE_SYSTEM,
-			.name	= "system",
-		},
-		{
-			.id	= ION_HEAP_TYPE_SYSTEM_CONTIG,
-			.type	= ION_HEAP_TYPE_SYSTEM_CONTIG,
-			.name	= "system contig",
-		},
-		{
-			.id	= ION_HEAP_TYPE_CARVEOUT,
-			.type	= ION_HEAP_TYPE_CARVEOUT,
-			.name	= "carveout",
-			.size	= SZ_4M,
-		},
-		{
-			.id	= ION_HEAP_TYPE_CHUNK,
-			.type	= ION_HEAP_TYPE_CHUNK,
-			.name	= "chunk",
-			.size	= SZ_4M,
-			.align	= SZ_16K,
-			.priv	= (void *)(SZ_16K),
-		},
+	{
+		.id	= ION_SYSTEM_HEAP_ID,
+		.type	= ION_HEAP_TYPE_CARVEOUT,
+		.name	= "ion_system_heap",
+		.base	= 0x100000000,
+		.size	= 0x10000000,
+	},
+	{
+		.id	= ION_AUDIO_HEAP_ID,
+		.type	= ION_HEAP_TYPE_CARVEOUT,
+		.name	= "ion_audio_heap",
+		.base	= 0xc8000000,
+		.size	= 0x00400000,
+	},
 };
 
 static struct ion_platform_data dummy_ion_pdata = {
@@ -71,7 +65,7 @@ struct ion_carveout_heap {
 };
 
 /* function derived from ion_carveout_heap.c */
-ion_phys_addr_t ion_carveout_allocate(struct ion_heap *heap,
+static ion_phys_addr_t hvenv_carveout_allocate(struct ion_heap *heap,
 				      unsigned long size,
 				      unsigned long align)
 {
@@ -86,7 +80,7 @@ ion_phys_addr_t ion_carveout_allocate(struct ion_heap *heap,
 }
 
 /* function derived from ion_carveout_heap.c */
-void ion_carveout_free(struct ion_heap *heap, ion_phys_addr_t addr,
+static void hvenv_carveout_free(struct ion_heap *heap, ion_phys_addr_t addr,
 		       unsigned long size)
 {
 	struct ion_carveout_heap *carveout_heap =
@@ -97,12 +91,68 @@ void ion_carveout_free(struct ion_heap *heap, ion_phys_addr_t addr,
 	gen_pool_free(carveout_heap->pool, addr, size);
 }
 
+struct page *hvenv_alloc_pages(int flags, unsigned long num_pages)
+{
+	unsigned long pfn;
+
+	pfn = hvenv_alloc_shm_pages(num_pages);
+
+	return pfn_to_page(pfn);
+}
+
+int hvenv_free_pages(struct page *page, unsigned long num_pages)
+{
+	unsigned long pfn;
+
+	pfn = page_to_pfn(page);
+
+	return hvenv_free_shm_pages(pfn, num_pages);
+}
+
+int hvenv_init(void)
+{
+	return 0;
+}
+EXPORT_SYMBOL(hvenv_init);
+
+unsigned long hvenv_alloc_shm_pages(unsigned long num_pages)
+{
+	unsigned long pfn = 0;
+	ion_phys_addr_t paddr;
+	struct ion_heap *heap = heaps[0];
+	unsigned long size = num_pages*PAGE_SIZE;
+
+	paddr = hvenv_carveout_allocate(heap, size, 0);
+
+	if (paddr != ION_CARVEOUT_ALLOCATE_FAIL)
+		pfn = PFN_DOWN(paddr);
+
+	pr_info("%s: size = %ld paddr = 0x%llx pfn = 0x%lx\n",
+	__func__, size, paddr, pfn);
+
+	return pfn;
+}
+EXPORT_SYMBOL(hvenv_alloc_shm_pages);
+
+int hvenv_free_shm_pages(unsigned long pfn, unsigned long num_pages)
+{
+	struct ion_heap *heap = heaps[0];
+	unsigned long size = num_pages*PAGE_SIZE;
+
+	pr_info("%s: pfn = 0x%lx size = %ld\n", __func__, pfn, size);
+
+	hvenv_carveout_free(heap, PFN_PHYS(pfn), size);
+
+	return 0;
+}
+EXPORT_SYMBOL(hvenv_free_shm_pages);
+
 /* function derived from msm_ion.c */
-struct ion_client *msm_ion_client_create(const char *name)
+struct ion_client *hvenv_ion_client_create(const char *name)
 {
 	/*
 	 * The assumption is that if there is a NULL device, the ion
-	 * driver has not yet probed.
+	 * driver has not yet initialized.
 	 */
 	if (idev == NULL)
 		return ERR_PTR(-EPROBE_DEFER);
@@ -112,72 +162,59 @@ struct ion_client *msm_ion_client_create(const char *name)
 
 	return ion_client_create(idev, name);
 }
+EXPORT_SYMBOL(hvenv_ion_client_create);
 
 static int __init ion_dummy_init(void)
 {
 	int i, err;
 
 	idev = ion_device_create(NULL);
+	if (IS_ERR_OR_NULL(idev)) {
+		/*
+		 * set this to the ERR to indicate to the clients
+		 * that Ion failed to initialize.
+		 */
+		err = PTR_ERR(idev);
+		pr_err("%s: ion_device_create failed %d\n",
+			__func__, err);
+		return err;
+	}
+
 	heaps = kcalloc(dummy_ion_pdata.nr, sizeof(struct ion_heap *),
 			GFP_KERNEL);
-	if (!heaps)
-		return -ENOMEM;
-
-
-	/* Allocate a dummy carveout heap */
-	carveout_ptr = alloc_pages_exact(
-				dummy_heaps[ION_HEAP_TYPE_CARVEOUT].size,
-				GFP_KERNEL);
-	if (carveout_ptr)
-		dummy_heaps[ION_HEAP_TYPE_CARVEOUT].base =
-						virt_to_phys(carveout_ptr);
-	else
-		pr_err("ion_dummy: Could not allocate carveout\n");
-
-	/* Allocate a dummy chunk heap */
-	chunk_ptr = alloc_pages_exact(
-				dummy_heaps[ION_HEAP_TYPE_CHUNK].size,
-				GFP_KERNEL);
-	if (chunk_ptr)
-		dummy_heaps[ION_HEAP_TYPE_CHUNK].base = virt_to_phys(chunk_ptr);
-	else
-		pr_err("ion_dummy: Could not allocate chunk\n");
+	if (!heaps) {
+		err = -ENOMEM;
+		pr_err("%s: heaps kcalloc failed %d\n",
+			__func__, err);
+		goto err1;
+	}
 
 	for (i = 0; i < dummy_ion_pdata.nr; i++) {
 		struct ion_platform_heap *heap_data = &dummy_ion_pdata.heaps[i];
 
-		if (heap_data->type == ION_HEAP_TYPE_CARVEOUT &&
-							!heap_data->base)
-			continue;
-
-		if (heap_data->type == ION_HEAP_TYPE_CHUNK && !heap_data->base)
-			continue;
-
 		heaps[i] = ion_heap_create(heap_data);
 		if (IS_ERR_OR_NULL(heaps[i])) {
 			err = PTR_ERR(heaps[i]);
-			goto err;
+			goto err2;
 		}
 		ion_device_add_heap(idev, heaps[i]);
+
+		pr_info("%s: ion_heap_create id: %d type: %d name: %s\n",
+			__func__, heap_data->id,
+			heap_data->type, heap_data->name);
 	}
+
 	return 0;
-err:
+
+err2:
 	for (i = 0; i < dummy_ion_pdata.nr; i++) {
 		if (heaps[i])
 			ion_heap_destroy(heaps[i]);
 	}
 	kfree(heaps);
+err1:
+	ion_device_destroy(idev);
 
-	if (carveout_ptr) {
-		free_pages_exact(carveout_ptr,
-				dummy_heaps[ION_HEAP_TYPE_CARVEOUT].size);
-		carveout_ptr = NULL;
-	}
-	if (chunk_ptr) {
-		free_pages_exact(chunk_ptr,
-				dummy_heaps[ION_HEAP_TYPE_CHUNK].size);
-		chunk_ptr = NULL;
-	}
 	return err;
 }
 device_initcall(ion_dummy_init);
@@ -186,21 +223,11 @@ static void __exit ion_dummy_exit(void)
 {
 	int i;
 
-	ion_device_destroy(idev);
-
 	for (i = 0; i < dummy_ion_pdata.nr; i++)
 		ion_heap_destroy(heaps[i]);
 	kfree(heaps);
 
-	if (carveout_ptr) {
-		free_pages_exact(carveout_ptr,
-				dummy_heaps[ION_HEAP_TYPE_CARVEOUT].size);
-		carveout_ptr = NULL;
-	}
-	if (chunk_ptr) {
-		free_pages_exact(chunk_ptr,
-				dummy_heaps[ION_HEAP_TYPE_CHUNK].size);
-		chunk_ptr = NULL;
-	}
+	ion_device_destroy(idev);
 }
 __exitcall(ion_dummy_exit);
+
