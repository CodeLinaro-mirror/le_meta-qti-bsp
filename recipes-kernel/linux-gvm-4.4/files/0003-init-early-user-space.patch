 }
@@ -842,6 +842,12 @@ static char *initcall_level_names[] __initdata = {
 	"late",
 };
 
+static char init_prog[128] = "/usr/sbin/early_init";
+static char *init_prog_argv[2] = { init_prog, NULL };
+
+static char touch_early_done[128] = "/bin/touch";
+static char *touch_early_done_argv[3] = { touch_early_done, "/dev/early_driver_done", NULL };
+
 static void __init do_initcall_level(int level)
 {
 	initcall_t *fn;
@@ -855,16 +861,59 @@ static void __init do_initcall_level(int level)
 
 	for (fn = initcall_levels[level]; fn < initcall_levels[level+1]; fn++)
 		do_one_initcall(*fn);
+
 }
 
 static void __init do_initcalls(void)
 {
 	int level;
 
-	for (level = 0; level < ARRAY_SIZE(initcall_levels) - 1; level++)
+	for (level = 0; level < 3; level++)
+		do_initcall_level(level);
+}
+
+static void __init do_initcalls_middle(void)
+{
+	int level;
+
+	for (level = 3; level < 6; level++)
+		do_initcall_level(level);
+}
+
+static void __init do_initcalls_late(void)
+{
+	int level;
+
+	for (level = 6; level < ARRAY_SIZE(initcall_levels) - 1; level++)
 		do_initcall_level(level);
 }
 
+static int early_userspace(void)
+{
+	/*
+	 * check if there is an early userspace init.  If yes, let it do all
+	 * the work
+	 */
+	int rc = 0;
+	
+	if (!ramdisk_execute_command)
+		ramdisk_execute_command = "/init";
+
+	if (sys_access((const char __user *) ramdisk_execute_command, 0) != 0) {
+		ramdisk_execute_command = NULL;
+		prepare_namespace();
+	}
+
+
+	rc = call_usermodehelper(init_prog, init_prog_argv, NULL, 0);
+	if (!rc)
+		pr_info("early_init launched\n");
+	else
+		pr_err("early_init failed\n");
+	
+	return 0;
+} 
+
 /*
  * Ok, the machine is now initialized. None of the devices
  * have been touched yet, but the CPU subsystem is up and
@@ -882,6 +931,9 @@ static void __init do_basic_setup(void)
 	usermodehelper_enable();
 	do_initcalls();
 	random_int_secret_init();
+	/*add a thread and prefetch rootfs*/
+	do_initcalls_middle();
+       early_userspace();
 }
 
