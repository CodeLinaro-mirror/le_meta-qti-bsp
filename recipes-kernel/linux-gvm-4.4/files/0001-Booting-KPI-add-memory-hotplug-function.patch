From 14cbf2d8fb861dbebf7f351ef4bdfdba16930e1e Mon Sep 17 00:00:00 2001
From: Yimin Peng <yiminp@codeaurora.org>
Date: Fri, 22 May 2020 14:24:36 +0800
Subject: [PATCH] Booting KPI:add memory hotplug function

Change-Id: Icadadb858fb3a752bfe61d01c35271c7e981555e
Signed-off-by: Xianbin Zhu <xianzhu@codeaurora.org>
Signed-off-by: Yimin Peng <yiminp@codeaurora.org>
---
 .../boot/dts/qcom/vplatform-lfv-msm8996-ivi.dts    | 15 ++++++++++
 arch/arm64/mm/init.c                               | 17 +++++++++++
 drivers/of/fdt.c                                   | 35 +++++++++++++++++++---
 3 files changed, 63 insertions(+), 4 deletions(-)

diff --git a/arch/arm/boot/dts/qcom/vplatform-lfv-msm8996-ivi.dts b/arch/arm/boot/dts/qcom/vplatform-lfv-msm8996-ivi.dts
index ebdee9e..324b117 100644
--- a/arch/arm/boot/dts/qcom/vplatform-lfv-msm8996-ivi.dts
+++ b/arch/arm/boot/dts/qcom/vplatform-lfv-msm8996-ivi.dts
@@ -67,6 +67,21 @@
 			};
 		};
 	};
+
+	memory {
+		device_type = "memory";
+		reg = <0 0 0 0>;
+		/* for 8G board*/
+		memory-limit-one = <0 0x904D0000> ;
+		end-memory-one = <0x2 0x7fcc0000> ;
+		pmem-start-addr-one = <0x1 0x5ff30000> ;
+		pmem-nomap-addr-one = <0x1 0x80000000> ;
+		pmem-nomap-size-one = <0x0 0x40000000>;
+
+		/* for 4G board*/
+		memory-limit-two = <0 0x504D0000> ;
+		end-memory-two = <0x1 0x7fcc0000> ;
+	};
 };
 
 &ion {
diff --git a/arch/arm64/mm/init.c b/arch/arm64/mm/init.c
index 26b1221..7502dce 100644
--- a/arch/arm64/mm/init.c
+++ b/arch/arm64/mm/init.c
@@ -172,6 +172,11 @@ static int __init early_mem(char *p)
 }
 early_param("mem", early_mem);
 
+extern u64 memory_limit_one;
+extern u64 memory_limit_two;
+extern u64 end_memory_one;
+extern u64 end_memory_two;
+
 void __init arm64_memblock_init(void)
 {
 	const s64 linear_region_size = -(s64)PAGE_OFFSET;
@@ -218,6 +223,18 @@ void __init arm64_memblock_init(void)
 		memblock_add(__pa_symbol(_text), (u64)(_end - _text));
 	}
 
+	if (memblock_end_of_DRAM() == end_memory_one){
+		bootloader_memory_limit = memblock_end_of_DRAM();
+		memblock_enforce_memory_limit(memory_limit_one);
+		memblock_add(__pa_symbol(_text), (u64)(_end - _text));
+		pr_notice("Memory limited to %lldMB\n", memory_limit_one >> 20);
+	} else if (memblock_end_of_DRAM() == end_memory_two){
+		bootloader_memory_limit = memblock_end_of_DRAM();
+		memblock_enforce_memory_limit(memory_limit_two);
+		memblock_add(__pa_symbol(_text), (u64)(_end - _text));
+		pr_notice("Memory limited to %lldMB\n", memory_limit_two >> 20);
+	}
+
 	if (IS_ENABLED(CONFIG_RANDOMIZE_BASE)) {
 		extern u16 memstart_offset_seed;
 		u64 range = linear_region_size -
diff --git a/drivers/of/fdt.c b/drivers/of/fdt.c
index ca17571..d2eb121 100644
--- a/drivers/of/fdt.c
+++ b/drivers/of/fdt.c
@@ -465,7 +465,7 @@ void *initial_boot_params;
 #ifdef CONFIG_OF_EARLY_FLATTREE
 
 static u32 of_fdt_crc32;
-
+u64 memory_limit_one, memory_limit_two, end_memory_one, end_memory_two, pmem_start_addr_one, pmem_nomap_addr_one, pmem_nomap_size_one;
 /**
  * res_mem_reserve_reg() - reserve all memory described in 'reg' property
  */
@@ -504,6 +504,11 @@ static int __init __reserved_mem_reserve_reg(unsigned long node,
 
 		len -= t_len;
 		if (first) {
+			if (base == pmem_start_addr_one) {
+				memblock_remove(pmem_nomap_addr_one, pmem_nomap_size_one);
+				memblock_free(pmem_nomap_addr_one, size - pmem_nomap_addr_one + pmem_start_addr_one);
+				size = pmem_nomap_addr_one - pmem_start_addr_one;
+			}
 			fdt_reserved_mem_save_node(node, uname, base, size);
 			first = 0;
 		}
@@ -908,7 +913,7 @@ int __init early_init_dt_scan_memory(unsigned long node, const char *uname,
 				     int depth, void *data)
 {
 	const char *type = of_get_flat_dt_prop(node, "device_type", NULL);
-	const __be32 *reg, *endp;
+	const __be32 *reg, *endp, *reg_1;
 	int l;
 
 	/* We are scanning "memory" nodes only */
@@ -921,7 +926,7 @@ int __init early_init_dt_scan_memory(unsigned long node, const char *uname,
 			return 0;
 	} else if (strcmp(type, "memory") != 0)
 		return 0;
-
+	
 	reg = of_get_flat_dt_prop(node, "linux,usable-memory", &l);
 	if (reg == NULL)
 		reg = of_get_flat_dt_prop(node, "reg", &l);
@@ -929,9 +934,31 @@ int __init early_init_dt_scan_memory(unsigned long node, const char *uname,
 		return 0;
 
 	endp = reg + (l / sizeof(__be32));
-
 	pr_debug("memory scan node %s, reg size %d,\n", uname, l);
 
+	reg_1 = of_get_flat_dt_prop(node, "memory-limit-one", &l);
+	if (reg_1){
+		memory_limit_one = dt_mem_next_cell(dt_root_addr_cells, &reg_1);
+
+		reg_1 = of_get_flat_dt_prop(node, "memory-limit-two", &l);
+		memory_limit_two = dt_mem_next_cell(dt_root_addr_cells, &reg_1);
+		
+		reg_1 = of_get_flat_dt_prop(node, "end-memory-one", &l);
+		end_memory_one = dt_mem_next_cell(dt_root_addr_cells, &reg_1);
+		
+		reg_1 = of_get_flat_dt_prop(node, "end-memory-two", &l);
+		end_memory_two = dt_mem_next_cell(dt_root_addr_cells, &reg_1);
+		
+		reg_1 = of_get_flat_dt_prop(node, "pmem-start-addr-one", &l);
+		pmem_start_addr_one = dt_mem_next_cell(dt_root_addr_cells, &reg_1);
+		
+		reg_1 = of_get_flat_dt_prop(node, "pmem-nomap-addr-one", &l);
+		pmem_nomap_addr_one = dt_mem_next_cell(dt_root_addr_cells, &reg_1);
+		
+		reg_1 = of_get_flat_dt_prop(node, "pmem-nomap-size-one", &l);
+		pmem_nomap_size_one = dt_mem_next_cell(dt_root_addr_cells, &reg_1);
+	}
+
 	while ((endp - reg) >= (dt_root_addr_cells + dt_root_size_cells)) {
 		u64 base, size;
 
-- 
2.7.4

