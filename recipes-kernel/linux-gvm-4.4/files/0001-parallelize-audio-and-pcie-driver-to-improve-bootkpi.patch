+	apq8096_soc_platform_init();
+	apq8096_asoc_machine_driver_init();
+	alsa_sound_last_init();
+	apr_late_init();
+}
+
+int __init early_audio_init_async_start(void)
+{
+	async_schedule(early_audio_init_async, NULL);
+	return 0;
+}
