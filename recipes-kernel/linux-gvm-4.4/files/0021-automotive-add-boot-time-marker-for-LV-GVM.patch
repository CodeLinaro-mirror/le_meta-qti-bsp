From a2d1487e7305e6f5c9c42a57e80f143d814d41ff Mon Sep 17 00:00:00 2001
From: Zhiqiang Tu <ztu@codeaurora.org>
Date: Mon, 19 Mar 2018 13:38:20 +0800
Subject: [PATCH] automotive: add boot time marker for LV GVM

Add boot time marker for boot KPI measurement.

Change-Id: Idb669bf15b215b0acec9434e3c7fb52faa92d415
Signed-off-by: Zhiqiang Tu <ztu@codeaurora.org>
---
 drivers/mmc/host/sdhci-msm.c          |  3 +++
 drivers/pci/host/pci-host-generic.c   |  6 ++++++
 drivers/scsi/scsi.c                   |  3 +++
 drivers/spi/spi_qsd.c                 | 19 ++++++++++++++++++-
 drivers/tty/serial/msm_serial_hs.c    |  3 +++
 drivers/usb/dwc3/dwc3-msm.c           |  8 ++++++++
 init/do_mounts.c                      |  6 +++++-
 init/main.c                           |  2 ++
 net/ipv4/af_inet.c                    |  3 +++
 sound/soc/msm/apq8096-auto.c          |  3 +++
 sound/soc/msm/qdsp6v2/msm-dai-q6-v2.c |  3 +++
 11 files changed, 57 insertions(+), 2 deletions(-)

diff --git a/drivers/mmc/host/sdhci-msm.c b/drivers/mmc/host/sdhci-msm.c
index aea00ce..7c996ba 100644
--- a/drivers/mmc/host/sdhci-msm.c
+++ b/drivers/mmc/host/sdhci-msm.c
@@ -39,6 +39,7 @@
 #include <linux/msm-bus.h>
 #include <linux/pm_runtime.h>
 #include <trace/events/mmc.h>
+#include <soc/qcom/boot_stats.h>
 
 #include "sdhci-msm.h"
 #include "sdhci-msm-ice.h"
@@ -4251,6 +4252,7 @@ static int sdhci_msm_probe(struct platform_device *pdev)
 	unsigned long flags;
 	bool force_probe;
 
+	place_marker("M - DRIVER SDHCI Init");
 	pr_debug("%s: Enter %s\n", dev_name(&pdev->dev), __func__);
 	msm_host = devm_kzalloc(&pdev->dev, sizeof(struct sdhci_msm_host),
 				GFP_KERNEL);
@@ -4748,6 +4750,7 @@ static int sdhci_msm_probe(struct platform_device *pdev)
 		mmc_flush_detect_work(host->mmc);
 
 	/* Successful initialization */
+	place_marker("M - DRIVER SDHCI Ready");
 	goto out;
 
 remove_max_bus_bw_file:
diff --git a/drivers/pci/host/pci-host-generic.c b/drivers/pci/host/pci-host-generic.c
index 5434c90..fe6c83e 100644
--- a/drivers/pci/host/pci-host-generic.c
+++ b/drivers/pci/host/pci-host-generic.c
@@ -24,6 +24,7 @@
 #include <linux/of_address.h>
 #include <linux/of_pci.h>
 #include <linux/platform_device.h>
+#include <soc/qcom/boot_stats.h>
 
 struct gen_pci_cfg_bus_ops {
 	u32 bus_shift;
@@ -218,6 +219,8 @@ static int gen_pci_probe(struct platform_device *pdev)
 	struct gen_pci *pci = devm_kzalloc(dev, sizeof(*pci), GFP_KERNEL);
 	struct pci_bus *bus, *child;
 
+	place_marker("M - DRIVER PCIe Init");
+
 	if (!pci)
 		return -ENOMEM;
 
@@ -270,6 +273,9 @@ static int gen_pci_probe(struct platform_device *pdev)
 	}
 
 	pci_bus_add_devices(bus);
+
+	place_marker("M - DRIVER PCIe Ready");
+
 	return 0;
 }
 
diff --git a/drivers/scsi/scsi.c b/drivers/scsi/scsi.c
index d07fb65..53680ea 100644
--- a/drivers/scsi/scsi.c
+++ b/drivers/scsi/scsi.c
@@ -71,6 +71,7 @@
 
 #define CREATE_TRACE_POINTS
 #include <trace/events/scsi.h>
+#include <soc/qcom/boot_stats.h>
 
 /*
  * Definitions and constants.
@@ -1150,6 +1151,7 @@ static int __init init_scsi(void)
 {
 	int error;
 
+	place_marker("M - DRIVER SCSI Init");
 	error = scsi_init_queue();
 	if (error)
 		return error;
@@ -1172,6 +1174,7 @@ static int __init init_scsi(void)
 	scsi_netlink_init();
 
 	printk(KERN_NOTICE "SCSI subsystem initialized\n");
+	place_marker("M - DRIVER SCSI Ready");
 	return 0;
 
 cleanup_sysctl:
diff --git a/drivers/spi/spi_qsd.c b/drivers/spi/spi_qsd.c
index aa73863..0c6f22d 100644
--- a/drivers/spi/spi_qsd.c
+++ b/drivers/spi/spi_qsd.c
@@ -45,6 +45,7 @@
 #include <linux/msm-bus.h>
 #include <linux/msm-bus-board.h>
 #include "spi_qsd.h"
+#include <soc/qcom/boot_stats.h>
 
 #define SPI_MAX_BYTES_PER_WORD			(4)
 
@@ -2925,7 +2926,23 @@ static struct platform_driver msm_spi_driver = {
 	.probe		= msm_spi_probe,
 };
 
-module_platform_driver(msm_spi_driver);
+static int __init msm_spi_init_module(void)
+{
+	int ret;
+
+	place_marker("M - DRIVER SPI Init");
+	ret = platform_driver_register(&msm_spi_driver);
+	place_marker("M - DRIVER SPI Ready");
+	return ret;
+}
+
+static void __exit msm_spi_exit_module(void)
+{
+	platform_driver_unregister(&msm_spi_driver);
+}
+
+module_init(msm_spi_init_module);
+module_exit(msm_spi_exit_module);
 
 MODULE_LICENSE("GPL v2");
 MODULE_VERSION("0.4");
diff --git a/drivers/tty/serial/msm_serial_hs.c b/drivers/tty/serial/msm_serial_hs.c
index 5da2f14..ddf0bef 100644
--- a/drivers/tty/serial/msm_serial_hs.c
+++ b/drivers/tty/serial/msm_serial_hs.c
@@ -66,6 +66,7 @@
 #include <linux/msm-sps.h>
 #include <linux/platform_data/msm_serial_hs.h>
 #include <linux/msm-bus.h>
+#include <soc/qcom/boot_stats.h>
 
 #include "msm_serial_hs_hwreg.h"
 #define UART_SPS_CONS_PERIPHERAL 0
@@ -3701,6 +3702,7 @@ static int __init msm_serial_hs_init(void)
 {
 	int ret;
 
+	place_marker("M - DRIVER HS-UART Init");
 	ret = uart_register_driver(&msm_hs_driver);
 	if (unlikely(ret)) {
 		pr_err("%s failed to load\n", __func__);
@@ -3717,6 +3719,7 @@ static int __init msm_serial_hs_init(void)
 		uart_unregister_driver(&msm_hs_driver);
 		return ret;
 	}
+	place_marker("M - DRIVER HS-UART Ready");
 
 	pr_info("msm_serial_hs module loaded\n");
 	return ret;
diff --git a/drivers/usb/dwc3/dwc3-msm.c b/drivers/usb/dwc3/dwc3-msm.c
index 2cd600a..663e393 100644
--- a/drivers/usb/dwc3/dwc3-msm.c
+++ b/drivers/usb/dwc3/dwc3-msm.c
@@ -53,6 +53,7 @@
 #include "dbm.h"
 #include "debug.h"
 #include "xhci.h"
+#include <soc/qcom/boot_stats.h>
 
 #define SDP_CONNETION_CHECK_TIME 10000 /* in ms */
 
@@ -3258,6 +3259,11 @@ static int dwc3_msm_probe(struct platform_device *pdev)
 		dwc3_ext_event_notify(mdwc);
 	}
 
+	if (mdwc->ss_phy_irq > 0) {
+		place_marker("M - DRIVER USB Host Ready");
+		place_marker("M - DRIVER USB Device Ready");
+	}
+
 	return 0;
 
 put_dwc3:
@@ -4105,6 +4111,8 @@ MODULE_DESCRIPTION("DesignWare USB3 MSM Glue Layer");
 
 static int dwc3_msm_init(void)
 {
+	place_marker("M - DRIVER USB Host Init");
+	place_marker("M - DRIVER USB Device Init");
 	return platform_driver_register(&dwc3_msm_driver);
 }
 module_init(dwc3_msm_init);
diff --git a/init/do_mounts.c b/init/do_mounts.c
index 1902a1c8..f6f0fc1 100644
--- a/init/do_mounts.c
+++ b/init/do_mounts.c
@@ -34,6 +34,7 @@
 #include <linux/nfs_mount.h>
 
 #include "do_mounts.h"
+#include <soc/qcom/boot_stats.h>
 
 int __initdata rd_doload;	/* 1 = load RAM disk, 0 = don't load */
 
@@ -363,7 +364,9 @@ static void __init get_fs_names(char *page)
 static int __init do_mount_root(char *name, char *fs, int flags, void *data)
 {
 	struct super_block *s;
-	int err = sys_mount(name, "/root", fs, flags, data);
+	int err;
+	place_marker("M - DRIVER F/S Init");
+	err = sys_mount(name, "/root", fs, flags, data);
 	if (err)
 		return err;
 
@@ -375,6 +378,7 @@ static int __init do_mount_root(char *name, char *fs, int flags, void *data)
 	       s->s_type->name,
 	       s->s_flags & MS_RDONLY ?  " readonly" : "",
 	       MAJOR(ROOT_DEV), MINOR(ROOT_DEV));
+	place_marker("M - DRIVER F/S Ready");
 	return 0;
 }
 
diff --git a/init/main.c b/init/main.c
index e0390d3..4b5e7c0 100644
--- a/init/main.c
+++ b/init/main.c
@@ -88,6 +88,7 @@
