From 5c6613d4021d2592205f58529861e953ca5a535a Mon Sep 17 00:00:00 2001
From: xianzhu <xianzhu@codeaurora.org>
Date: Tue, 28 Aug 2018 11:21:48 +0800
Subject: [PATCH] automotive: add boot time marker for LV GVM

Add boot time marker for boot KPI measurement.

Change-Id: I6f2986f697098b46ae388267f992103744327537
Signed-off-by: xianzhu <xianzhu@codeaurora.org>
---
 arch/arm64/kernel/head.S            |  6 ++++++
 drivers/pci/host/pci-host-generic.c |  6 ++++++
 drivers/soc/qcom/boot_marker.c      | 11 +++++++++++
 init/do_mounts.c                    |  6 +++++-
 net/ipv4/af_inet.c                  |  3 +++
 5 files changed, 31 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/kernel/head.S b/arch/arm64/kernel/head.S
index d5d4afb..c97ff37 100644
--- a/arch/arm64/kernel/head.S
+++ b/arch/arm64/kernel/head.S
@@ -207,6 +207,12 @@ efi_header_end:
 	__INIT
 
 ENTRY(stext)
+#ifdef	CONFIG_MSM_GVM_QUIN
+	ldr     x21, =0x004a3000                // read mpm timer
+	ldr     x22, [x21]
+	ldr     x21, =0x0066bf6b8               // store the mpm timer value to shared memory
+	str     x22, [x21]
+#endif
 	bl	preserve_boot_args
 	bl	el2_setup			// Drop to EL1, w20=cpu_boot_mode
 	adrp	x24, __PHYS_OFFSET
diff --git a/drivers/pci/host/pci-host-generic.c b/drivers/pci/host/pci-host-generic.c
index 5434c90..fe6c83e 100644
--- a/drivers/pci/host/pci-host-generic.c
+++ b/drivers/pci/host/pci-host-generic.c
@@ -24,6 +24,7 @@
 #include <linux/of_address.h>
 #include <linux/of_pci.h>
 #include <linux/platform_device.h>
+#include <soc/qcom/boot_stats.h>
 
 struct gen_pci_cfg_bus_ops {
 	u32 bus_shift;
@@ -218,6 +219,8 @@ static int gen_pci_probe(struct platform_device *pdev)
 	struct gen_pci *pci = devm_kzalloc(dev, sizeof(*pci), GFP_KERNEL);
 	struct pci_bus *bus, *child;
 
+	place_marker("M - DRIVER PCIe Init");
+
 	if (!pci)
 		return -ENOMEM;
 
@@ -270,6 +273,9 @@ static int gen_pci_probe(struct platform_device *pdev)
 	}
 
 	pci_bus_add_devices(bus);
+
+	place_marker("M - DRIVER PCIe Ready");
+
 	return 0;
 }
 
diff --git a/drivers/soc/qcom/boot_marker.c b/drivers/soc/qcom/boot_marker.c
index 0b72d76..c5ccb3b 100644
--- a/drivers/soc/qcom/boot_marker.c
+++ b/drivers/soc/qcom/boot_marker.c
@@ -65,6 +65,16 @@ static void _create_boot_marker(const char *name,
 
 static void set_bootloader_stats(void)
 {
+#ifdef CONFIG_MSM_GVM_QUIN
+
+	/* Kernel Start in GVM is read from boot_stats->bootloader_display
+	 * This is a hack to save Kernel_Start when host boots the kernel
+	 * instead of a bootloader.
+	 */
+
+	_create_boot_marker("M - Kernel Start  - ",
+		readl_relaxed(&boot_stats->bootloader_display));
+#else
 	_create_boot_marker("M - APPSBL Start - ",
 		readl_relaxed(&boot_stats->bootloader_start));
 	_create_boot_marker("M - APPSBL Display Init - ",
@@ -77,6 +87,7 @@ static void set_bootloader_stats(void)
 		readl_relaxed(&boot_stats->bootloader_checksum));
 	_create_boot_marker("M - APPSBL End - ",
 		readl_relaxed(&boot_stats->bootloader_end));
+#endif
 }
 
 void place_marker(const char *name)
diff --git a/init/do_mounts.c b/init/do_mounts.c
index 1bbc506..4986c61 100644
--- a/init/do_mounts.c
+++ b/init/do_mounts.c
@@ -34,6 +34,7 @@
 #include <linux/nfs_mount.h>
 
 #include "do_mounts.h"
+#include <soc/qcom/boot_stats.h>
 
 int __initdata rd_doload;	/* 1 = load RAM disk, 0 = don't load */
 
@@ -363,7 +364,9 @@ static void __init get_fs_names(char *page)
 static int __init do_mount_root(char *name, char *fs, int flags, void *data)
 {
 	struct super_block *s;
-	int err = sys_mount(name, "/root", fs, flags, data);
+	int err;
+	place_marker("M - DRIVER F/S Init");
+	err = sys_mount(name, "/root", fs, flags, data);
 	if (err)
 		return err;
 
@@ -375,6 +378,7 @@ static int __init do_mount_root(char *name, char *fs, int flags, void *data)
 	       s->s_type->name,
 	       s->s_flags & MS_RDONLY ?  " readonly" : "",
 	       MAJOR(ROOT_DEV), MINOR(ROOT_DEV));
+	place_marker("M - DRIVER F/S Ready");
 	return 0;
 }
 
diff --git a/net/ipv4/af_inet.c b/net/ipv4/af_inet.c
index aad274c..eed912a 100644
--- a/net/ipv4/af_inet.c
+++ b/net/ipv4/af_inet.c
@@ -121,6 +121,7 @@
 #include <linux/mroute.h>
 #endif
 #include <net/l3mdev.h>
+#include <soc/qcom/boot_stats.h>
 
 #ifdef CONFIG_ANDROID_PARANOID_NETWORK
 #include <linux/android_aid.h>
@@ -1737,6 +1738,7 @@ static int __init inet_init(void)
 	struct list_head *r;
 	int rc = -EINVAL;
 
+	place_marker("M - DRIVER IP stack Init");
 	sock_skb_cb_check_size(sizeof(struct inet_skb_parm));
 
 	rc = proto_register(&tcp_prot, 1);
@@ -1845,6 +1847,7 @@ static int __init inet_init(void)
 	ip_tunnel_core_init();
 
 	rc = 0;
+	place_marker("M - DRIVER IP stack Ready");
 out:
 	return rc;
 out_unregister_raw_proto:
-- 
1.9.1

