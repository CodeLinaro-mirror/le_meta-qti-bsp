+
 
 static struct dbm *of_usb_find_dbm(struct device_node *node)
 {
diff --git a/drivers/usb/dwc3/dwc3-msm.c b/drivers/usb/dwc3/dwc3-msm.c
index 95e27e0..22c0767 100644
--- a/drivers/usb/dwc3/dwc3-msm.c
+++ b/drivers/usb/dwc3/dwc3-msm.c
@@ -2920,7 +2920,6 @@ static int dwc3_msm_probe(struct platform_device *pdev)
 	int ext_hub_reset_gpio;
 	u32 val;
 	char boot_marker[40];
-
 	mdwc = devm_kzalloc(&pdev->dev, sizeof(*mdwc), GFP_KERNEL);
 	if (!mdwc)
 		return -ENOMEM;
@@ -4196,7 +4195,7 @@ static int dwc3_msm_init(void)
 {
 	return platform_driver_register(&dwc3_msm_driver);
 }
-module_init(dwc3_msm_init);
+subsys_initcall(dwc3_msm_init);
 
 static void __exit dwc3_msm_exit(void)
 {
diff --git a/drivers/usb/host/xhci-plat.c b/drivers/usb/host/xhci-plat.c
index efe1924..f7a6fd5 100644
--- a/drivers/usb/host/xhci-plat.c
+++ b/drivers/usb/host/xhci-plat.c
@@ -484,7 +484,7 @@ static int __init xhci_plat_init(void)
 	xhci_init_driver(&xhci_plat_hc_driver, &xhci_plat_overrides);
 	return platform_driver_register(&usb_xhci_driver);
 }
-module_init(xhci_plat_init);
+subsys_initcall(xhci_plat_init);
 
 static void __exit xhci_plat_exit(void)
 {
