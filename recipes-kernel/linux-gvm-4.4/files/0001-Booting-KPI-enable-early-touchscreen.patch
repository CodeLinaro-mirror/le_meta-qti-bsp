From f1ce52c07379dc214a3d2411293a8400e6794254 Mon Sep 17 00:00:00 2001
From: xianzhu <xianzhu@codeaurora.org>
Date: Wed, 22 Aug 2018 18:05:58 +0800
Subject: [PATCH] Booting KPI:enable early touchscreen

enable early touchscreen in ICAS3.

Change-Id: I64b37113c93df592e49e80796e356a779d60b1e0
Signed-off-by: xianzhu <xianzhu@codeaurora.org>
---
 drivers/hid/hid-core.c                |  2 +-
 drivers/hid/hid-input.c               |  4 ++--
 drivers/hid/hid-multitouch.c          | 13 +++++++++++--
 drivers/hid/usbhid/hid-core.c         |  3 +--
 drivers/platform/msm/gpio-usbdetect.c | 12 ++++++++++--
 drivers/usb/dwc3/core.c               | 16 ++++++++++++----
 drivers/usb/dwc3/dbm.c                | 13 ++++++++++++-
 drivers/usb/dwc3/dwc3-msm.c           |  3 +--
 drivers/usb/host/xhci-plat.c          |  2 +-
 drivers/usb/phy/phy-msm-qusb.c        | 11 ++++++++++-
 drivers/usb/phy/phy-msm-ssusb-qmp.c   | 11 ++++++++++-
 11 files changed, 71 insertions(+), 19 deletions(-)

diff --git a/drivers/hid/hid-core.c b/drivers/hid/hid-core.c
index d1d399cc..52c1132 100644
--- a/drivers/hid/hid-core.c
+++ b/drivers/hid/hid-core.c
@@ -2808,7 +2808,7 @@ static void __exit hid_exit(void)
 	bus_unregister(&hid_bus_type);
 }
 
-module_init(hid_init);
+subsys_initcall(hid_init);
 module_exit(hid_exit);
 
 MODULE_AUTHOR("Andreas Gal");
diff --git a/drivers/hid/hid-input.c b/drivers/hid/hid-input.c
index 8d74e69..5774908 100644
--- a/drivers/hid/hid-input.c
+++ b/drivers/hid/hid-input.c
@@ -31,7 +31,7 @@
 
 #include <linux/hid.h>
 #include <linux/hid-debug.h>
-
+#include <soc/qcom/boot_stats.h>
 #include "hid-ids.h"
 
 #define unk	KEY_UNKNOWN
@@ -1548,7 +1548,7 @@ int hidinput_connect(struct hid_device *hid, unsigned int force)
 		if (input_register_device(hidinput->input))
 			goto out_cleanup;
 	}
-
+	place_marker("M - DRIVER TouchInput Ready");
 	return 0;
 
 out_cleanup:
diff --git a/drivers/hid/hid-multitouch.c b/drivers/hid/hid-multitouch.c
index 9de379c..f27e48d 100644
--- a/drivers/hid/hid-multitouch.c
+++ b/drivers/hid/hid-multitouch.c
@@ -1076,7 +1076,6 @@ static int mt_probe(struct hid_device *hdev, const struct hid_device_id *id)
 	int ret, i;
 	struct mt_device *td;
 	struct mt_class *mtclass = mt_classes; /* MT_CLS_DEFAULT */
-
 	for (i = 0; mt_classes[i].name ; i++) {
 		if (id->driver_data == mt_classes[i].name) {
 			mtclass = &(mt_classes[i]);
@@ -1504,4 +1503,14 @@ static struct hid_driver mt_driver = {
 	.resume = mt_resume,
 #endif
 };
-module_hid_driver(mt_driver);
+
+static int mt_driver_init(void)
+{
+	return hid_register_driver(&mt_driver);
+}
+fs_initcall(mt_driver_init);
+static void mt_driver_exit(void)
+{
+	hid_unregister_driver(&mt_driver);
+}
+module_exit(mt_driver_exit);
diff --git a/drivers/hid/usbhid/hid-core.c b/drivers/hid/usbhid/hid-core.c
index b0eeb50..2f28ad9 100644
--- a/drivers/hid/usbhid/hid-core.c
+++ b/drivers/hid/usbhid/hid-core.c
@@ -1284,7 +1284,6 @@ static int usbhid_probe(struct usb_interface *intf, const struct usb_device_id *
 	unsigned int n, has_in = 0;
 	size_t len;
 	int ret;
-
 	dbg_hid("HID probe called for ifnum %d\n",
 			intf->altsetting->desc.bInterfaceNumber);
 
@@ -1663,7 +1662,7 @@ static void __exit hid_exit(void)
 	usbhid_quirks_exit();
 }
 
-module_init(hid_init);
+fs_initcall(hid_init);
 module_exit(hid_exit);
 
 MODULE_AUTHOR("Andreas Gal");
diff --git a/drivers/platform/msm/gpio-usbdetect.c b/drivers/platform/msm/gpio-usbdetect.c
index 9768243..cd4efe2 100644
--- a/drivers/platform/msm/gpio-usbdetect.c
+++ b/drivers/platform/msm/gpio-usbdetect.c
@@ -245,8 +245,16 @@ static struct platform_driver gpio_usbdetect_driver = {
 	.remove		= gpio_usbdetect_remove,
 };
 
-module_driver(gpio_usbdetect_driver, platform_driver_register,
-		platform_driver_unregister);
+static int gpio_usbdetect_driver_init(void)
+{
+       return platform_driver_register(&gpio_usbdetect_driver);
+}
+subsys_initcall(gpio_usbdetect_driver_init);
+static void gpio_usbdetect_driver_exit(void)
+{
+       platform_driver_unregister(&gpio_usbdetect_driver);
+}
+module_exit(gpio_usbdetect_driver_exit);
 
 MODULE_DESCRIPTION("GPIO USB VBUS Detection driver");
 MODULE_LICENSE("GPL v2");
diff --git a/drivers/usb/dwc3/core.c b/drivers/usb/dwc3/core.c
index 3191825..1f0fac9 100644
--- a/drivers/usb/dwc3/core.c
+++ b/drivers/usb/dwc3/core.c
@@ -823,7 +823,6 @@ static int dwc3_core_get_phy(struct dwc3 *dwc)
 		dwc->usb2_phy = devm_usb_get_phy(dev, USB_PHY_TYPE_USB2);
 		dwc->usb3_phy = devm_usb_get_phy(dev, USB_PHY_TYPE_USB3);
 	}
-
 	if (IS_ERR(dwc->usb2_phy)) {
 		ret = PTR_ERR(dwc->usb2_phy);
 		if (ret == -ENXIO || ret == -ENODEV) {
@@ -1035,7 +1034,6 @@ static int dwc3_probe(struct platform_device *pdev)
 
 	void __iomem		*regs;
 	void			*mem;
-
 	mem = devm_kzalloc(dev, sizeof(*dwc) + DWC3_ALIGN_MASK, GFP_KERNEL);
 	if (!mem)
 		return -ENOMEM;
@@ -1311,7 +1309,8 @@ err0:
 	 * memory region the next time probe is called.
 	 */
 	res->start -= DWC3_GLOBALS_REGS_START;
-	destroy_workqueue(dwc->dwc_wq);
+	if (dwc->dwc_wq)
+		destroy_workqueue(dwc->dwc_wq);
 
 	return ret;
 }
@@ -1497,8 +1496,17 @@ static struct platform_driver dwc3_driver = {
 	},
 };
 
-module_platform_driver(dwc3_driver);
+static int dwc3_driver_init(void)
+{
+	return platform_driver_register(&dwc3_driver);
+}
+subsys_initcall(dwc3_driver_init);
 
+static void dwc3_driver_exit(void)
+{
+	platform_driver_unregister(&dwc3_driver);
+}
+module_exit(dwc3_driver_exit);
 MODULE_ALIAS("platform:dwc3");
 MODULE_AUTHOR("Felipe Balbi <balbi@ti.com>");
 MODULE_LICENSE("GPL v2");
