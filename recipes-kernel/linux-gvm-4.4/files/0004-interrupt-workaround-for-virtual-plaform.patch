+				IRQF_ONESHOT | IRQF_TRIGGER_RISING, desc->name, desc);
+#endif
 		if (ret < 0) {
 			dev_err(desc->dev, "[%s]: Unable to register error fatal IRQ handler!: %d\n",
 				desc->name, ret);
@@ -1551,9 +1557,15 @@ static int subsys_setup_irqs(struct subsys_device *subsys)
 	}
 
 	if (desc->stop_ack_irq && desc->stop_ack_handler) {
