diff --git a/drivers/i2c/busses/i2c-msm-v2.c b/drivers/i2c/busses/i2c-msm-v2.c
index f4ed71f..d738dc9 100644
--- a/drivers/i2c/busses/i2c-msm-v2.c
+++ b/drivers/i2c/busses/i2c-msm-v2.c
@@ -2566,8 +2566,13 @@ static int i2c_msm_rsrcs_irq_init(struct platform_device *pdev,
 		return irq;
 	}
 
+#ifndef CONFIG_MSM_GVM_QUIN
 	ret = request_irq(irq, i2c_msm_qup_isr, IRQF_TRIGGER_HIGH,
 						"i2c-msm-v2-irq", ctrl);
+#else
+	ret = request_irq(irq, i2c_msm_qup_isr, IRQF_TRIGGER_HIGH |
+					IRQF_ONESHOT, "i2c-msm-v2-irq", ctrl);
+#endif
 	if (ret) {
 		dev_err(ctrl->dev, "error request_irq(irq_num:%d ) ret:%d\n",
 								irq, ret);
diff --git a/drivers/mmc/host/sdhci-msm.c b/drivers/mmc/host/sdhci-msm.c
index 45d2f69..a982ee8 100644
--- a/drivers/mmc/host/sdhci-msm.c
+++ b/drivers/mmc/host/sdhci-msm.c
@@ -4683,10 +4683,17 @@ static int sdhci_msm_probe(struct platform_device *pdev)
 		dev_info(&pdev->dev, "%s: sdiowakeup_irq = %d\n", __func__,
 				msm_host->pdata->sdiowakeup_irq);
 		msm_host->is_sdiowakeup_enabled = true;
+#ifndef CONFIG_MSM_GVM_QUIN
 		ret = request_irq(msm_host->pdata->sdiowakeup_irq,
 				  sdhci_msm_sdiowakeup_irq,
 				  IRQF_SHARED | IRQF_TRIGGER_HIGH,
 				  "sdhci-msm sdiowakeup", host);
+#else
+		ret = request_irq(msm_host->pdata->sdiowakeup_irq,
+				  sdhci_msm_sdiowakeup_irq,
+				  IRQF_SHARED | IRQF_TRIGGER_HIGH | IRQF_ONESHOT,
+				  "sdhci-msm sdiowakeup", host);
+#endif
 		if (ret) {
 			dev_err(&pdev->dev, "%s: request sdiowakeup IRQ %d: failed: %d\n",
 				__func__, msm_host->pdata->sdiowakeup_irq, ret);
diff --git a/drivers/mmc/host/sdhci.c b/drivers/mmc/host/sdhci.c
index 5906bba..fe64786 100644
--- a/drivers/mmc/host/sdhci.c
+++ b/drivers/mmc/host/sdhci.c
@@ -3482,9 +3482,15 @@ int sdhci_resume_host(struct sdhci_host *host)
 	}
 
 	if (!device_may_wakeup(mmc_dev(host->mmc))) {
+#ifndef CONFIG_MSM_GVM_QUIN
 		ret = request_threaded_irq(host->irq, sdhci_irq,
 					   sdhci_thread_irq, IRQF_SHARED,
 					   mmc_hostname(host->mmc), host);
+#else
+		ret = request_threaded_irq(host->irq, sdhci_irq,
+					   sdhci_thread_irq, IRQF_SHARED | IRQF_ONESHOT,
+					   mmc_hostname(host->mmc), host);
+#endif
 		if (ret)
 			return ret;
 	} else {
@@ -4367,8 +4373,13 @@ int sdhci_add_host(struct sdhci_host *host)
 
 	sdhci_init(host, 0);
 
+#ifndef CONFIG_MSM_GVM_QUIN
 	ret = request_threaded_irq(host->irq, sdhci_irq, sdhci_thread_irq,
 				   IRQF_SHARED,	mmc_hostname(mmc), host);
+#else
+	ret = request_threaded_irq(host->irq, sdhci_irq, sdhci_thread_irq,
+				   IRQF_SHARED | IRQF_ONESHOT, mmc_hostname(mmc), host);
+#endif
 	if (ret) {
 		pr_err("%s: Failed to request IRQ %d: %d\n",
 		       mmc_hostname(mmc), host->irq, ret);
diff --git a/drivers/net/can/spi/rh850.c b/drivers/net/can/spi/rh850.c
index d2b6e8c..9d9c21d 100644
--- a/drivers/net/can/spi/rh850.c
+++ b/drivers/net/can/spi/rh850.c
@@ -1134,9 +1134,15 @@ static int rh850_probe(struct spi_device *spi)
 		}
 	}
 
+#ifndef CONFIG_MSM_GVM_QUIN
 	err = request_threaded_irq(spi->irq, NULL, rh850_irq,
 				   IRQF_TRIGGER_FALLING | IRQF_ONESHOT,
 				   "rh850", priv_data);
+#else
+	err = request_threaded_irq(spi->irq, NULL, rh850_irq,
+			IRQF_TRIGGER_HIGH | IRQF_ONESHOT,
+			"rh850", priv_data);
+#endif
 	if (err) {
 		dev_err(dev, "Failed to request irq: %d", err);
 		goto unregister_candev;
diff --git a/drivers/platform/msm/ipa/ipa_v2/ipa_interrupts.c b/drivers/platform/msm/ipa/ipa_v2/ipa_interrupts.c
index c17dee9..7db2770 100644
--- a/drivers/platform/msm/ipa/ipa_v2/ipa_interrupts.c
+++ b/drivers/platform/msm/ipa/ipa_v2/ipa_interrupts.c
@@ -366,8 +366,13 @@ int ipa_interrupts_init(u32 ipa_irq, u32 ee, struct device *ipa_dev)
 	/*Clearing interrupts status*/
 	ipa_write_reg(ipa_ctx->mmio, IPA_IRQ_CLR_EE_n_ADDR(ipa_ee), reg);
 
+#ifndef CONFIG_MSM_GVM_QUIN
 	res = request_irq(ipa_irq, (irq_handler_t) ipa_isr,
 				IRQF_TRIGGER_RISING, "ipa", ipa_dev);
+#else
+	res = request_irq(ipa_irq, (irq_handler_t) ipa_isr,
+				IRQF_TRIGGER_RISING | IRQF_ONESHOT, "ipa", ipa_dev);
+#endif
 	if (res) {
 		IPAERR("fail to register IPA IRQ handler irq=%d\n", ipa_irq);
 		return -ENODEV;
diff --git a/drivers/platform/msm/sps/sps_bam.c b/drivers/platform/msm/sps/sps_bam.c
index 38a6474..2b24da2 100644
--- a/drivers/platform/msm/sps/sps_bam.c
+++ b/drivers/platform/msm/sps/sps_bam.c
@@ -295,16 +295,28 @@ int sps_bam_enable(struct sps_bam *dev)
 		/* Register BAM ISR */
 		if (dev->props.irq > 0) {
 			if (dev->props.options & SPS_BAM_RES_CONFIRM) {
+#ifndef CONFIG_MSM_GVM_QUIN
 				result = request_irq(dev->props.irq,
 					(irq_handler_t) bam_isr,
 					IRQF_TRIGGER_RISING, "sps", dev);
+#else
+				result = request_irq(dev->props.irq,
+					(irq_handler_t) bam_isr,
+					IRQF_TRIGGER_RISING | IRQF_ONESHOT, "sps", dev);
+#endif
 				SPS_DBG3(dev,
 					"sps:BAM %pa uses edge for IRQ# %d\n",
 					BAM_ID(dev), dev->props.irq);
 			} else {
+#ifndef CONFIG_MSM_GVM_QUIN
 				result = request_irq(dev->props.irq,
 					(irq_handler_t) bam_isr,
 					IRQF_TRIGGER_HIGH, "sps", dev);
+#else
+				result = request_irq(dev->props.irq,
+					(irq_handler_t) bam_isr,
+					IRQF_TRIGGER_HIGH | IRQF_ONESHOT, "sps", dev);
+#endif
 				SPS_DBG3(dev,
 					"sps:BAM %pa uses level for IRQ# %d\n",
 					BAM_ID(dev), dev->props.irq);
diff --git a/drivers/soc/qcom/glink_smem_native_xprt.c b/drivers/soc/qcom/glink_smem_native_xprt.c
index 042108d..290ec00 100644
