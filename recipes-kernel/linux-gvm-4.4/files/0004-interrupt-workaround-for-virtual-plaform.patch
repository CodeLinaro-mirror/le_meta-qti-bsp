 		if (ret < 0) {
 			dev_err(desc->dev,
 				"[%s]: Unable to register err ready handler\n",
diff --git a/drivers/spi/spi_qsd.h b/drivers/spi/spi_qsd.h
index 47d6996..0451b9b 100644
--- a/drivers/spi/spi_qsd.h
+++ b/drivers/spi/spi_qsd.h
@@ -470,8 +470,13 @@ static inline int msm_spi_request_irq(struct msm_spi *dd,
 	if (dd->irq_in < 0)
 		return -EINVAL;
 
+#ifndef CONFIG_MSM_GVM_QUIN
 	return devm_request_irq(dd->dev, dd->irq_in, msm_spi_qup_irq,
 		IRQF_TRIGGER_HIGH, pdev->name, dd);
+#else
+	return devm_request_irq(dd->dev, dd->irq_in, msm_spi_qup_irq,
+		IRQF_TRIGGER_HIGH | IRQF_ONESHOT, pdev->name, dd);
+#endif
 }
 
 static inline void msm_spi_disable_irqs(struct msm_spi *dd)
diff --git a/drivers/tty/serial/msm_serial_hs.c b/drivers/tty/serial/msm_serial_hs.c
index 416006a..e93b5f1 100644
--- a/drivers/tty/serial/msm_serial_hs.c
+++ b/drivers/tty/serial/msm_serial_hs.c
@@ -2691,9 +2691,15 @@ static int msm_hs_startup(struct uart_port *uport)
 	msm_hs_resource_vote(msm_uport);
 
 	if (is_use_low_power_wakeup(msm_uport)) {
+#ifndef CONFIG_MSM_GVM_QUIN
 		ret = request_irq(msm_uport->wakeup.irq, msm_hs_wakeup_isr,
 					IRQF_TRIGGER_FALLING | IRQF_ONESHOT,
 					"msm_hs_wakeup", msm_uport);
+#else
+		ret = request_irq(msm_uport->wakeup.irq, msm_hs_wakeup_isr,
+					IRQF_TRIGGER_HIGH | IRQF_ONESHOT,
+					"msm_hs_wakeup", msm_uport);
+#endif
 		if (unlikely(ret)) {
 			MSM_HS_ERR("%s():Err getting uart wakeup_irq %d\n",
 				  __func__, ret);
@@ -2796,8 +2802,13 @@ static int msm_hs_startup(struct uart_port *uport)
 	 */
 	mb();
 
+#ifndef CONFIG_MSM_GVM_QUIN
 	ret = request_irq(uport->irq, msm_hs_isr, IRQF_TRIGGER_HIGH,
 			  "msm_hs_uart", msm_uport);
+#else
+	ret = request_irq(uport->irq, msm_hs_isr, IRQF_TRIGGER_HIGH |
+			IRQF_ONESHOT, "msm_hs_uart", msm_uport);
+#endif
 	if (unlikely(ret)) {
 		MSM_HS_ERR("%s():Error %d getting uart irq\n", __func__, ret);
 		goto sps_disconnect_rx;
