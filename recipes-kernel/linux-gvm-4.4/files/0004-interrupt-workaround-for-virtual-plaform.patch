From 93df4ea9136e5e5eb90297bf3e8e1dc6dc3f9442 Mon Sep 17 00:00:00 2001
From: Zhiqiang Tu <ztu@codeaurora.org>
Date: Tue, 15 Aug 2017 14:32:35 +0800
Subject: [PATCH] interrupt workaround for virtual plaform

Change-Id: I349ecd2b87c1c85b72c1f3870052f610b13d803a
Signed-off-by: Zhiqiang Tu <ztu@codeaurora.org>
---
 drivers/i2c/busses/i2c-msm-v2.c                  |  5 ++++
 drivers/net/can/spi/rh850.c                      |  6 +++++
 drivers/platform/msm/ipa/ipa_v2/ipa_interrupts.c |  5 ++++
 drivers/platform/msm/sps/sps_bam.c               | 12 +++++++++
 drivers/soc/qcom/glink_smem_native_xprt.c        | 18 +++++++++++++
 drivers/soc/qcom/smd_init_dt.c                   | 16 ++++++++++++
 drivers/soc/qcom/smp2p.c                         |  5 ++++
 drivers/soc/qcom/subsystem_restart.c             | 32 ++++++++++++++++++++++++
 drivers/spi/spi_qsd.h                            |  5 ++++
 drivers/tty/serial/msm_serial_hs.c               | 11 ++++++++
 10 files changed, 115 insertions(+)

diff --git a/drivers/i2c/busses/i2c-msm-v2.c b/drivers/i2c/busses/i2c-msm-v2.c
index f4ed71f..d738dc9 100644
--- a/drivers/i2c/busses/i2c-msm-v2.c
+++ b/drivers/i2c/busses/i2c-msm-v2.c
@@ -2566,8 +2566,13 @@ static int i2c_msm_rsrcs_irq_init(struct platform_device *pdev,
 		return irq;
 	}
 
+#ifndef CONFIG_MSM_GVM_QUIN
 	ret = request_irq(irq, i2c_msm_qup_isr, IRQF_TRIGGER_HIGH,
 						"i2c-msm-v2-irq", ctrl);
+#else
+	ret = request_irq(irq, i2c_msm_qup_isr, IRQF_TRIGGER_HIGH |
+					IRQF_ONESHOT, "i2c-msm-v2-irq", ctrl);
+#endif
 	if (ret) {
 		dev_err(ctrl->dev, "error request_irq(irq_num:%d ) ret:%d\n",
 								irq, ret);
diff --git a/drivers/net/can/spi/rh850.c b/drivers/net/can/spi/rh850.c
index a93f979..bd1090f 100644
--- a/drivers/net/can/spi/rh850.c
+++ b/drivers/net/can/spi/rh850.c
@@ -1132,9 +1132,15 @@ static int rh850_probe(struct spi_device *spi)
 		}
 	}
 
+#ifndef CONFIG_MSM_GVM_QUIN
 	err = request_threaded_irq(spi->irq, NULL, rh850_irq,
 				   IRQF_TRIGGER_FALLING | IRQF_ONESHOT,
 				   "rh850", priv_data);
+#else
+	err = request_threaded_irq(spi->irq, NULL, rh850_irq,
+			IRQF_TRIGGER_HIGH | IRQF_ONESHOT,
+			"rh850", priv_data);
+#endif
 	if (err) {
 		dev_err(dev, "Failed to request irq: %d", err);
 		goto unregister_candev;
diff --git a/drivers/platform/msm/ipa/ipa_v2/ipa_interrupts.c b/drivers/platform/msm/ipa/ipa_v2/ipa_interrupts.c
index c17dee9..7db2770 100644
--- a/drivers/platform/msm/ipa/ipa_v2/ipa_interrupts.c
+++ b/drivers/platform/msm/ipa/ipa_v2/ipa_interrupts.c
@@ -366,8 +366,13 @@ int ipa_interrupts_init(u32 ipa_irq, u32 ee, struct device *ipa_dev)
 	/*Clearing interrupts status*/
 	ipa_write_reg(ipa_ctx->mmio, IPA_IRQ_CLR_EE_n_ADDR(ipa_ee), reg);
 
+#ifndef CONFIG_MSM_GVM_QUIN
 	res = request_irq(ipa_irq, (irq_handler_t) ipa_isr,
 				IRQF_TRIGGER_RISING, "ipa", ipa_dev);
+#else
+	res = request_irq(ipa_irq, (irq_handler_t) ipa_isr,
+				IRQF_TRIGGER_RISING | IRQF_ONESHOT, "ipa", ipa_dev);
+#endif
 	if (res) {
 		IPAERR("fail to register IPA IRQ handler irq=%d\n", ipa_irq);
 		return -ENODEV;
diff --git a/drivers/platform/msm/sps/sps_bam.c b/drivers/platform/msm/sps/sps_bam.c
index 38a6474..2b24da2 100644
--- a/drivers/platform/msm/sps/sps_bam.c
+++ b/drivers/platform/msm/sps/sps_bam.c
@@ -295,16 +295,28 @@ int sps_bam_enable(struct sps_bam *dev)
 		/* Register BAM ISR */
 		if (dev->props.irq > 0) {
 			if (dev->props.options & SPS_BAM_RES_CONFIRM) {
+#ifndef CONFIG_MSM_GVM_QUIN
 				result = request_irq(dev->props.irq,
 					(irq_handler_t) bam_isr,
 					IRQF_TRIGGER_RISING, "sps", dev);
+#else
+				result = request_irq(dev->props.irq,
+					(irq_handler_t) bam_isr,
+					IRQF_TRIGGER_RISING | IRQF_ONESHOT, "sps", dev);
+#endif
 				SPS_DBG3(dev,
 					"sps:BAM %pa uses edge for IRQ# %d\n",
 					BAM_ID(dev), dev->props.irq);
 			} else {
+#ifndef CONFIG_MSM_GVM_QUIN
 				result = request_irq(dev->props.irq,
 					(irq_handler_t) bam_isr,
 					IRQF_TRIGGER_HIGH, "sps", dev);
+#else
+				result = request_irq(dev->props.irq,
+					(irq_handler_t) bam_isr,
+					IRQF_TRIGGER_HIGH | IRQF_ONESHOT, "sps", dev);
+#endif
 				SPS_DBG3(dev,
 					"sps:BAM %pa uses level for IRQ# %d\n",
 					BAM_ID(dev), dev->props.irq);
diff --git a/drivers/soc/qcom/glink_smem_native_xprt.c b/drivers/soc/qcom/glink_smem_native_xprt.c
index 37193bb..5ad05b2 100644
--- a/drivers/soc/qcom/glink_smem_native_xprt.c
+++ b/drivers/soc/qcom/glink_smem_native_xprt.c
@@ -2425,9 +2425,15 @@ static int glink_smem_native_probe(struct platform_device *pdev)
 	}
 
 	einfo->irq_line = irq_line;
+#ifndef CONFIG_MSM_GVM_QUIN
 	rc = request_irq(irq_line, irq_handler,
 			IRQF_TRIGGER_RISING | IRQF_NO_SUSPEND | IRQF_SHARED,
 			node->name, einfo);
+#else
+	rc = request_irq(irq_line, irq_handler,
+			IRQF_ONESHOT | IRQF_TRIGGER_RISING | IRQF_NO_SUSPEND | IRQF_SHARED,
+			node->name, einfo);
+#endif
 	if (rc < 0) {
 		pr_err("%s: request_irq on %d failed: %d\n", __func__, irq_line,
 									rc);
@@ -2674,9 +2680,15 @@ static int glink_rpm_native_probe(struct platform_device *pdev)
 	}
 
 	einfo->irq_line = irq_line;
+#ifndef CONFIG_MSM_GVM_QUIN
 	rc = request_irq(irq_line, irq_handler,
 			IRQF_TRIGGER_RISING | IRQF_NO_SUSPEND | IRQF_SHARED,
 			node->name, einfo);
+#else
+	rc = request_irq(irq_line, irq_handler,
+			IRQF_ONESHOT | IRQF_TRIGGER_RISING | IRQF_NO_SUSPEND | IRQF_SHARED,
+			node->name, einfo);
+#endif
 	if (rc < 0) {
 		pr_err("%s: request_irq on %d failed: %d\n", __func__, irq_line,
 									rc);
@@ -2918,9 +2930,15 @@ static int glink_mailbox_probe(struct platform_device *pdev)
 	}
 
 	einfo->irq_line = irq_line;
+#ifndef CONFIG_MSM_GVM_QUIN
 	rc = request_irq(irq_line, irq_handler,
 			IRQF_TRIGGER_HIGH | IRQF_NO_SUSPEND | IRQF_SHARED,
 			node->name, einfo);
+#else
+	rc = request_irq(irq_line, irq_handler,
+			IRQF_ONESHOT | IRQF_TRIGGER_HIGH | IRQF_NO_SUSPEND | IRQF_SHARED,
+			node->name, einfo);
+#endif
 	if (rc < 0) {
 		pr_err("%s: request_irq on %d failed: %d\n", __func__, irq_line,
 									rc);
diff --git a/drivers/soc/qcom/smd_init_dt.c b/drivers/soc/qcom/smd_init_dt.c
index 1d722d8..c2b0521 100644
--- a/drivers/soc/qcom/smd_init_dt.c
+++ b/drivers/soc/qcom/smd_init_dt.c
@@ -124,11 +124,19 @@ static int msm_smsm_probe(struct platform_device *pdev)
 	remote_pid = smd_edge_to_remote_pid(edge);
 	interrupt_stats[remote_pid].smsm_interrupt_id = irq_line;
 
+#ifndef CONFIG_MSM_GVM_QUIN
 	ret = request_irq(irq_line,
 				private_irq->irq_handler,
 				IRQF_TRIGGER_RISING | IRQF_NO_SUSPEND,
 				node->name,
 				NULL);
+#else
+	ret = request_irq(irq_line,
+				private_irq->irq_handler,
+				IRQF_ONESHOT | IRQF_TRIGGER_RISING | IRQF_NO_SUSPEND,
+				node->name,
+				NULL);
+#endif
 	if (ret < 0) {
 		pr_err("%s: request_irq() failed on %d\n", __func__, irq_line);
 		return ret;
@@ -259,11 +267,19 @@ static int msm_smd_probe(struct platform_device *pdev)
 	remote_pid = smd_edge_to_remote_pid(edge);
 	interrupt_stats[remote_pid].smd_interrupt_id = irq_line;
 
+#ifndef CONFIG_MSM_GVM_QUIN
 	ret = request_irq(irq_line,
 			private_irq->irq_handler,
 			IRQF_TRIGGER_RISING | IRQF_NO_SUSPEND | IRQF_SHARED,
 			node->name,
 			&pdev->dev);
+#else
+	ret = request_irq(irq_line,
+			private_irq->irq_handler,
+			IRQF_ONESHOT | IRQF_TRIGGER_RISING | IRQF_NO_SUSPEND | IRQF_SHARED,
+			node->name,
+			&pdev->dev);
+#endif
 	if (ret < 0) {
 		pr_err("%s: request_irq() failed on %d\n", __func__, irq_line);
 		return ret;
diff --git a/drivers/soc/qcom/smp2p.c b/drivers/soc/qcom/smp2p.c
index 1de38bf..8ff82dc 100644
--- a/drivers/soc/qcom/smp2p.c
+++ b/drivers/soc/qcom/smp2p.c
@@ -1865,8 +1865,13 @@ static int msm_smp2p_probe(struct platform_device *pdev)
 		goto fail;
 	}
 
+#ifndef CONFIG_MSM_GVM_QUIN
 	ret = request_irq(irq_line, smp2p_interrupt_handler,
 			IRQF_TRIGGER_RISING, "smp2p", (void *)(uintptr_t)edge);
+#else
+	ret = request_irq(irq_line, smp2p_interrupt_handler,
+			IRQF_TRIGGER_RISING | IRQF_ONESHOT, "smp2p", (void *)(uintptr_t)edge);
+#endif
 	if (ret < 0) {
 		SMP2P_ERR("%s: request_irq() failed on %d (edge %d)\n",
 				__func__, irq_line, edge);
diff --git a/drivers/soc/qcom/subsystem_restart.c b/drivers/soc/qcom/subsystem_restart.c
index ae249f3..625ce71 100644
--- a/drivers/soc/qcom/subsystem_restart.c
+++ b/drivers/soc/qcom/subsystem_restart.c
@@ -1539,9 +1539,15 @@ static int subsys_setup_irqs(struct subsys_device *subsys)
 	int ret;
 
 	if (desc->err_fatal_irq && desc->err_fatal_handler) {
+#ifndef CONFIG_MSM_GVM_QUIN
 		ret = devm_request_irq(desc->dev, desc->err_fatal_irq,
 				desc->err_fatal_handler,
 				IRQF_TRIGGER_RISING, desc->name, desc);
+#else
+		ret = devm_request_irq(desc->dev, desc->err_fatal_irq,
+				desc->err_fatal_handler,
+				IRQF_ONESHOT | IRQF_TRIGGER_RISING, desc->name, desc);
+#endif
 		if (ret < 0) {
 			dev_err(desc->dev, "[%s]: Unable to register error fatal IRQ handler!: %d\n",
 				desc->name, ret);
@@ -1551,9 +1557,15 @@ static int subsys_setup_irqs(struct subsys_device *subsys)
 	}
 
 	if (desc->stop_ack_irq && desc->stop_ack_handler) {
+#ifndef CONFIG_MSM_GVM_QUIN
 		ret = devm_request_irq(desc->dev, desc->stop_ack_irq,
 			desc->stop_ack_handler,
 			IRQF_TRIGGER_RISING, desc->name, desc);
+#else
+		ret = devm_request_irq(desc->dev, desc->stop_ack_irq,
+			desc->stop_ack_handler,
+			IRQF_ONESHOT | IRQF_TRIGGER_RISING, desc->name, desc);
+#endif
 		if (ret < 0) {
 			dev_err(desc->dev, "[%s]: Unable to register stop ack handler!: %d\n",
 				desc->name, ret);
@@ -1563,9 +1575,15 @@ static int subsys_setup_irqs(struct subsys_device *subsys)
 	}
 
 	if (desc->wdog_bite_irq && desc->wdog_bite_handler) {
+#ifndef CONFIG_MSM_GVM_QUIN
 		ret = devm_request_irq(desc->dev, desc->wdog_bite_irq,
 			desc->wdog_bite_handler,
 			IRQF_TRIGGER_RISING, desc->name, desc);
+#else
+		ret = devm_request_irq(desc->dev, desc->wdog_bite_irq,
+			desc->wdog_bite_handler,
+			IRQF_ONESHOT | IRQF_TRIGGER_RISING, desc->name, desc);
+#endif
 		if (ret < 0) {
 			dev_err(desc->dev, "[%s]: Unable to register wdog bite handler!: %d\n",
 				desc->name, ret);
@@ -1575,9 +1593,15 @@ static int subsys_setup_irqs(struct subsys_device *subsys)
 	}
 
 	if (desc->generic_irq && desc->generic_handler) {
+#ifndef CONFIG_MSM_GVM_QUIN
 		ret = devm_request_irq(desc->dev, desc->generic_irq,
 			desc->generic_handler,
 			IRQF_TRIGGER_HIGH, desc->name, desc);
+#else
+		ret = devm_request_irq(desc->dev, desc->generic_irq,
+			desc->generic_handler,
+			IRQF_ONESHOT | IRQF_TRIGGER_HIGH, desc->name, desc);
+#endif
 		if (ret < 0) {
 			dev_err(desc->dev, "[%s]: Unable to register generic irq handler!: %d\n",
 				desc->name, ret);
@@ -1587,11 +1611,19 @@ static int subsys_setup_irqs(struct subsys_device *subsys)
 	}
 
 	if (desc->err_ready_irq) {
+#ifndef CONFIG_MSM_GVM_QUIN
 		ret = devm_request_irq(desc->dev,
 					desc->err_ready_irq,
 					subsys_err_ready_intr_handler,
 					IRQF_TRIGGER_RISING,
 					"error_ready_interrupt", subsys);
+#else
+		ret = devm_request_irq(desc->dev,
+					desc->err_ready_irq,
+					subsys_err_ready_intr_handler,
+					IRQF_ONESHOT | IRQF_TRIGGER_RISING,
+					"error_ready_interrupt", subsys);
+#endif
 		if (ret < 0) {
 			dev_err(desc->dev,
 				"[%s]: Unable to register err ready handler\n",
diff --git a/drivers/spi/spi_qsd.h b/drivers/spi/spi_qsd.h
index 47d6996..0451b9b 100644
--- a/drivers/spi/spi_qsd.h
+++ b/drivers/spi/spi_qsd.h
@@ -470,8 +470,13 @@ static inline int msm_spi_request_irq(struct msm_spi *dd,
 	if (dd->irq_in < 0)
 		return -EINVAL;
 
+#ifndef CONFIG_MSM_GVM_QUIN
 	return devm_request_irq(dd->dev, dd->irq_in, msm_spi_qup_irq,
 		IRQF_TRIGGER_HIGH, pdev->name, dd);
+#else
+	return devm_request_irq(dd->dev, dd->irq_in, msm_spi_qup_irq,
+		IRQF_TRIGGER_HIGH | IRQF_ONESHOT, pdev->name, dd);
+#endif
 }
 
 static inline void msm_spi_disable_irqs(struct msm_spi *dd)
diff --git a/drivers/tty/serial/msm_serial_hs.c b/drivers/tty/serial/msm_serial_hs.c
index b80e75f..74de8b7 100644
--- a/drivers/tty/serial/msm_serial_hs.c
+++ b/drivers/tty/serial/msm_serial_hs.c
@@ -2614,9 +2614,15 @@ static int msm_hs_startup(struct uart_port *uport)
 	msm_hs_resource_vote(msm_uport);
 
 	if (is_use_low_power_wakeup(msm_uport)) {
+#ifndef CONFIG_MSM_GVM_QUIN
 		ret = request_irq(msm_uport->wakeup.irq, msm_hs_wakeup_isr,
 					IRQF_TRIGGER_FALLING | IRQF_ONESHOT,
 					"msm_hs_wakeup", msm_uport);
+#else
+		ret = request_irq(msm_uport->wakeup.irq, msm_hs_wakeup_isr,
+					IRQF_TRIGGER_HIGH | IRQF_ONESHOT,
+					"msm_hs_wakeup", msm_uport);
+#endif
 		if (unlikely(ret)) {
 			MSM_HS_ERR("%s():Err getting uart wakeup_irq %d\n",
 				  __func__, ret);
@@ -2716,8 +2722,13 @@ static int msm_hs_startup(struct uart_port *uport)
 	 */
 	mb();
 
+#ifndef CONFIG_MSM_GVM_QUIN
 	ret = request_irq(uport->irq, msm_hs_isr, IRQF_TRIGGER_HIGH,
 			  "msm_hs_uart", msm_uport);
+#else
+	ret = request_irq(uport->irq, msm_hs_isr, IRQF_TRIGGER_HIGH |
+			IRQF_ONESHOT, "msm_hs_uart", msm_uport);
+#endif
 	if (unlikely(ret)) {
 		MSM_HS_ERR("%s():Error %d getting uart irq\n", __func__, ret);
 		goto sps_disconnect_rx;
