diff --git a/drivers/clk/msm/clock-dummy.c b/drivers/clk/msm/clock-dummy.c
index e874fcc..9206a6d 100644
--- a/drivers/clk/msm/clock-dummy.c
+++ b/drivers/clk/msm/clock-dummy.c
@@ -14,6 +14,51 @@
 #include <linux/platform_device.h>
 #include <linux/of.h>
 #include <soc/qcom/msm-clock-controller.h>
+#include <linux/reset-controller.h>
+
+static int dummy_reset_assert(struct reset_controller_dev *rcdev,
+				unsigned long id)
+{
+	return 0;
+}
+
+static int dummy_reset_deassert(struct reset_controller_dev *rcdev,
+				unsigned long id)
+{
+	return 0;
+}
+
+static int dummy_reset(struct reset_controller_dev *rcdev, unsigned long id)
+{
+	return 0;
+}
+
+struct reset_control_ops dummy_reset_ops = {
+	.reset = dummy_reset,
+	.assert = dummy_reset_assert,
+	.deassert = dummy_reset_deassert,
+};
+
+int dummy_reset_controller_register(struct platform_device *pdev)
+{
+	struct reset_controller_dev *prcdev;
+	int ret = 0;
+
+	prcdev = devm_kzalloc(&pdev->dev, sizeof(*prcdev), GFP_KERNEL);
+	if (!prcdev)
+		return -ENOMEM;
+
+	prcdev->of_node = pdev->dev.of_node;
+	prcdev->ops = &dummy_reset_ops;
+	prcdev->owner = pdev->dev.driver->owner;
+	prcdev->nr_resets = 17; // based on size of gcc_msm8996_resets
+
+	ret = reset_controller_register(prcdev);
+	if (ret)
+		dev_err(&pdev->dev, "%s: Failed to register with reset controller %d\n", __func__, ret);
+
+	return ret;
+}
 
 static int dummy_clk_reset(struct clk *clk, enum clk_reset_action action)
 {
@@ -98,10 +143,19 @@ static int msm_clock_dummy_probe(struct platform_device *pdev)
 	int ret;
 
 	ret = of_clk_add_provider(pdev->dev.of_node, of_dummy_get, NULL);
-	if (ret)
+	if (ret) {
+		dev_err(&pdev->dev, "%s: of_clk_add_provider error %d", __func__, ret);
 		return -ENOMEM;
+	}
+
+	ret = dummy_reset_controller_register(pdev);
+	if (ret) {
+		dev_err(&pdev->dev, "%s: dummy_reset_controller_register error %d", __func__, ret);
+		return -ENOMEM;
+	}
 
 	dev_info(&pdev->dev, "Registered DUMMY provider.\n");
+
 	return ret;
 }
 
diff --git a/drivers/platform/msm/gpio-usbdetect.c b/drivers/platform/msm/gpio-usbdetect.c
index 1628253..5d13689 100644
--- a/drivers/platform/msm/gpio-usbdetect.c
+++ b/drivers/platform/msm/gpio-usbdetect.c
@@ -46,6 +46,9 @@ static irqreturn_t gpio_usbdetect_vbus_irq(int irq, void *data)
 {
 	struct gpio_usbdetect *usb = data;
 
+	if (!usb->gpio)
+		return IRQ_HANDLED;
+
 	usb->vbus_state = gpio_get_value(usb->gpio);
 	if (usb->vbus_state) {
 		dev_dbg(&usb->pdev->dev, "setting vbus notification\n");
@@ -97,6 +100,7 @@ static int gpio_usbdetect_probe(struct platform_device *pdev)
 {
 	struct gpio_usbdetect *usb;
 	int rc;
+	bool skip_vbus_detect;
 
 	usb = devm_kzalloc(&pdev->dev, sizeof(*usb), GFP_KERNEL);
 	if (!usb)
@@ -136,68 +140,97 @@ static int gpio_usbdetect_probe(struct platform_device *pdev)
 		}
 	}
 
-	usb->gpio = of_get_named_gpio(pdev->dev.of_node,
-				"qcom,vbus-det-gpio", 0);
-	if (usb->gpio < 0) {
-		dev_err(&pdev->dev, "Failed to get gpio: %d\n", usb->gpio);
-		rc = usb->gpio;
-		goto error;
-	}
+	skip_vbus_detect = of_property_read_bool(pdev->dev.of_node,
+		"qcom,skip-vbus-detect");
+	if(!skip_vbus_detect) {
+		usb->gpio = of_get_named_gpio(pdev->dev.of_node,
+					"qcom,vbus-det-gpio", 0);
+		if (usb->gpio < 0) {
+			dev_err(&pdev->dev, "Failed to get gpio: %d\n", usb->gpio);
+			rc = usb->gpio;
+			goto error;
+		}
 
-	rc = gpio_request(usb->gpio, "vbus-det-gpio");
-	if (rc < 0) {
-		dev_err(&pdev->dev, "Failed to request gpio: %d\n", rc);
-		goto error;
-	}
+		rc = gpio_request(usb->gpio, "vbus-det-gpio");
+		if (rc < 0) {
+			dev_err(&pdev->dev, "Failed to request gpio: %d\n", rc);
+			goto error;
+		}
 
-	usb->vbus_det_irq = gpio_to_irq(usb->gpio);
-	if (usb->vbus_det_irq < 0) {
-		dev_err(&pdev->dev, "get vbus_det_irq failed\n");
-		rc = usb->vbus_det_irq;
-		goto error;
-	}
+		usb->vbus_det_irq = gpio_to_irq(usb->gpio);
+		if (usb->vbus_det_irq < 0) {
+			dev_err(&pdev->dev, "get vbus_det_irq failed\n");
+			rc = usb->vbus_det_irq;
+			goto error;
+		}
 
-	rc = devm_request_threaded_irq(&pdev->dev, usb->vbus_det_irq,
-				NULL, gpio_usbdetect_vbus_irq,
-			      IRQF_TRIGGER_RISING | IRQF_TRIGGER_FALLING |
-			      IRQF_ONESHOT, "vbus_det_irq", usb);
-	if (rc) {
-		dev_err(&pdev->dev, "request for vbus_det_irq failed: %d\n",
-			rc);
-		goto error;
-	}
+		rc = devm_request_threaded_irq(&pdev->dev, usb->vbus_det_irq,
+					NULL, gpio_usbdetect_vbus_irq,
+				      IRQF_TRIGGER_RISING | IRQF_TRIGGER_FALLING |
+				      IRQF_ONESHOT, "vbus_det_irq", usb);
+		if (rc) {
+			dev_err(&pdev->dev, "request for vbus_det_irq failed: %d\n",
+				rc);
+			goto error;
+		}
 
-	usb->id_det_irq = platform_get_irq_byname(pdev, "pmic_id_irq");
-	if (usb->id_det_irq < 0) {
-		dev_err(&pdev->dev, "get id_det_irq failed\n");
-		rc = usb->id_det_irq;
-		goto error;
-	}
+		usb->id_det_irq = platform_get_irq_byname(pdev, "pmic_id_irq");
+		if (usb->id_det_irq < 0) {
+			dev_err(&pdev->dev, "get id_det_irq failed\n");
+			rc = usb->id_det_irq;
+			goto error;
+		}
 
-	rc = devm_request_threaded_irq(&pdev->dev, usb->id_det_irq,
-				gpio_usbdetect_id_irq,
-				gpio_usbdetect_id_irq_thread,
-				IRQF_TRIGGER_RISING | IRQF_TRIGGER_FALLING |
-				IRQF_ONESHOT, "id_det_irq", usb);
-	if (rc) {
-		dev_err(&pdev->dev, "request for id_det_irq failed: %d\n", rc);
-		goto error;
+		rc = devm_request_threaded_irq(&pdev->dev, usb->id_det_irq,
+					gpio_usbdetect_id_irq,
+					gpio_usbdetect_id_irq_thread,
+					IRQF_TRIGGER_RISING | IRQF_TRIGGER_FALLING |
+					IRQF_ONESHOT, "id_det_irq", usb);
+		if (rc) {
+			dev_err(&pdev->dev, "request for id_det_irq failed: %d\n", rc);
+			goto error;
+		}
+
+		enable_irq_wake(usb->vbus_det_irq);
+		enable_irq_wake(usb->id_det_irq);
+	}
+	else
+	{
+		dev_info(&pdev->dev, "%s: skipping vbus_detect\n", __func__);
+		usb->vbus_det_irq = 0;
+		usb->id_det_irq = 0;
+		usb->gpio = 0;
 	}
 
-	enable_irq_wake(usb->vbus_det_irq);
-	enable_irq_wake(usb->id_det_irq);
 	dev_set_drvdata(&pdev->dev, usb);
 
-	if (usb->id_det_irq) {
-		gpio_usbdetect_id_irq(usb->id_det_irq, usb);
-		if (!usb->id_state) {
-			gpio_usbdetect_id_irq_thread(usb->id_det_irq, usb);
-			return 0;
+	if (!skip_vbus_detect) {
+		if (usb->id_det_irq) {
+			gpio_usbdetect_id_irq(usb->id_det_irq, usb);
+			if (!usb->id_state) {
+				gpio_usbdetect_id_irq_thread(usb->id_det_irq, usb);
+				return 0;
+			}
 		}
+
+		/* Read and report initial VBUS state */
+		gpio_usbdetect_vbus_irq(usb->vbus_det_irq, usb);
 	}
 
-	/* Read and report initial VBUS state */
-	gpio_usbdetect_vbus_irq(usb->vbus_det_irq, usb);
+	if(skip_vbus_detect && of_property_read_bool(pdev->dev.of_node,
+		"qcom,force-vbus-status-on"))
+	{
+		dev_info(&pdev->dev, "%s: force vbus status to ON\n", __func__);
+		extcon_set_cable_state_(usb->extcon_dev, EXTCON_USB_HOST, 0);
+		extcon_set_cable_state_(usb->extcon_dev, EXTCON_USB, 1);
+	}
+	else if(skip_vbus_detect && of_property_read_bool(pdev->dev.of_node,
+		"qcom,force-vbus-status-off"))
+	{
+		dev_info(&pdev->dev, "%s: force vbus status to OFF\n", __func__);
+		extcon_set_cable_state_(usb->extcon_dev, EXTCON_USB_HOST, 1);
+		extcon_set_cable_state_(usb->extcon_dev, EXTCON_USB, 0);
+	}
 
 	return 0;
 
