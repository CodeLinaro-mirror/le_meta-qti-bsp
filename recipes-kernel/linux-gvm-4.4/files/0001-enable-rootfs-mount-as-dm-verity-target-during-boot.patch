From 56f33fa9120f0a83e44cd305160595953a2eda84 Mon Sep 17 00:00:00 2001
From: Parai Wang <fpwang@codeaurora.org>
Date: Mon, 8 Jan 2018 17:04:53 +0800
Subject: [PATCH] enable rootfs mount as dm-verity target during boot without
 support of ramdisk

Change-Id: Iae8446c8b1f65aa65c8c11bd0f720731d46e9be6
Signed-off-by: Parai Wang <fpwang@codeaurora.org>
---
 arch/arm/boot/dts/qcom/dm-verity-boot.dtsi        |  27 ++
 arch/arm/boot/dts/qcom/vplatform-lfv-msm8996.dtsi |   2 +
 drivers/md/dm-ioctl.c                             |  33 +++
 init/Makefile                                     |   1 +
 init/do_mounts.c                                  |   1 +
 init/do_mounts.h                                  |  10 +
 init/do_mounts_verity.c                           | 298 ++++++++++++++++++++++
 7 files changed, 372 insertions(+)
 create mode 100644 arch/arm/boot/dts/qcom/dm-verity-boot.dtsi
 create mode 100644 init/do_mounts_verity.c

diff --git a/arch/arm/boot/dts/qcom/dm-verity-boot.dtsi b/arch/arm/boot/dts/qcom/dm-verity-boot.dtsi
new file mode 100644
index 0000000..fe8be7d
--- /dev/null
+++ b/arch/arm/boot/dts/qcom/dm-verity-boot.dtsi
@@ -0,0 +1,27 @@
