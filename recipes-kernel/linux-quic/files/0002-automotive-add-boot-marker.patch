diff --git a/drivers/net/can/spi/rh850.c b/drivers/net/can/spi/rh850.c
index 2dc2022..42915e4 100644
--- a/drivers/net/can/spi/rh850.c
+++ b/drivers/net/can/spi/rh850.c
@@ -19,6 +19,7 @@
 #include <linux/can.h>
 #include <linux/can/dev.h>
 #include <linux/completion.h>
+#include <soc/qcom/boot_stats.h>
 
 #define DEBUG_RH850	0
 #if DEBUG_RH850 == 1
@@ -1191,7 +1192,23 @@ static struct spi_driver rh850_driver = {
 	.probe = rh850_probe,
 	.remove = rh850_remove,
 };
-module_spi_driver(rh850_driver);
+
+static int __init rh850_driver_init(void)
+{
+	int ret;
+
+	place_marker("M - DRIVER Can Init");
+	ret = spi_register_driver(&rh850_driver);
+	place_marker("M - DRIVER Can Ready");
+	return ret;
+}
+module_init(rh850_driver_init);
+
+static void __exit rh850_driver_exit(void)
+{
+	spi_unregister_driver(&rh850_driver);
+}
+module_exit(rh850_driver_exit);
 
 MODULE_DESCRIPTION("RH850 SPI-CAN module");
 MODULE_LICENSE("GPL v2");
diff --git a/drivers/pci/host/pci-msm.c b/drivers/pci/host/pci-msm.c
index dc42ef1..e862bd0 100644
--- a/drivers/pci/host/pci-msm.c
+++ b/drivers/pci/host/pci-msm.c
@@ -45,6 +45,7 @@
 #include <soc/qcom/scm.h>
 #include <linux/ipc_logging.h>
 #include <linux/msm_pcie.h>
+#include <soc/qcom/boot_stats.h>
 
 #ifdef CONFIG_ARCH_SDXHEDGEHOG
 #define PCIE_VENDOR_ID_RCP		0x17cb
@@ -4292,6 +4293,7 @@ int msm_pcie_enable(struct msm_pcie_dev_t *dev, u32 options)
 	uint32_t val;
 	long int retries = 0;
 	int link_check_count = 0;
+	char boot_marker[40];
 
 	PCIE_DBG(dev, "RC%d: entry\n", dev->rc_idx);
 
@@ -4477,6 +4479,9 @@ int msm_pcie_enable(struct msm_pcie_dev_t *dev, u32 options)
 
 	if ((val & XMLH_LINK_UP) &&
 		msm_pcie_confirm_linkup(dev, false, false, NULL)) {
+		snprintf(boot_marker, sizeof(boot_marker),
+				"M - DRIVER PCIe(RC%d) Ready", dev->rc_idx);
+		place_marker(boot_marker);
 		PCIE_DBG(dev, "Link is up after %d checkings\n",
 			link_check_count);
 		PCIE_INFO(dev, "PCIe RC%d link initialized\n", dev->rc_idx);
@@ -6288,6 +6293,7 @@ int __init pcie_init(void)
 	char rc_name[MAX_RC_NAME_LEN];
 
 	pr_alert("pcie:%s.\n", __func__);
+	place_marker("M - DRIVER PCIe Init");
 
 	pcie_drv.rc_num = 0;
 	mutex_init(&pcie_drv.drv_lock);
