 #include <trace/events/mmc.h>
@@ -4112,6 +4113,7 @@ static int mmc_blk_probe(struct mmc_card *card)
 
 	string_get_size((u64)get_capacity(md->disk) << 9, STRING_UNITS_2,
 			cap_str, sizeof(cap_str));
+	place_marker("M - DRIVER eMMC Ready");
 	pr_info("%s: %s %s %s %s\n",
