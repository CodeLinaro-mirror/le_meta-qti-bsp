diff --git a/drivers/gpu/drm/msm/msm_drv.c b/drivers/gpu/drm/msm/msm_drv.c
index 62e3047..614ebb3 100644
--- a/drivers/gpu/drm/msm/msm_drv.c
+++ b/drivers/gpu/drm/msm/msm_drv.c
@@ -23,6 +23,7 @@
 #include "display_manager.h"
 #include "sde_wb.h"
 #include "msm_mmu.h"
+#include <soc/qcom/boot_stats.h>
 
 static void msm_fb_output_poll_changed(struct drm_device *dev)
 {
@@ -361,6 +362,9 @@ static int msm_load(struct drm_device *dev, unsigned long flags)
 	struct msm_kms *kms;
 	int ret, i;
 
+	place_marker("M - DRIVER Display Init");
+	place_marker("M - DRIVER GPU Init");
+
 	priv = kzalloc(sizeof(*priv), GFP_KERNEL);
 	if (!priv) {
 		dev_err(dev->dev, "failed to allocate private data\n");
@@ -483,6 +487,9 @@ static int msm_load(struct drm_device *dev, unsigned long flags)
 
 	drm_kms_helper_poll_init(dev);
 
+	place_marker("M - DRIVER Display Ready");
+	place_marker("M - DRIVER GPU Ready");
+
 	return 0;
 
 fail:
diff --git a/drivers/i2c/busses/i2c-msm-v2.c b/drivers/i2c/busses/i2c-msm-v2.c
index beb5656..6f72a5f 100644
--- a/drivers/i2c/busses/i2c-msm-v2.c
+++ b/drivers/i2c/busses/i2c-msm-v2.c
@@ -36,6 +36,7 @@
 #include <linux/msm-bus.h>
 #include <linux/msm-bus-board.h>
 #include <linux/i2c/i2c-msm-v2.h>
+#include <soc/qcom/boot_stats.h>
 
 #ifdef DEBUG
 static const enum msm_i2_debug_level DEFAULT_DBG_LVL = MSM_DBG;
@@ -2999,7 +3000,12 @@ static struct platform_driver i2c_msm_driver = {
 
 static int i2c_msm_init(void)
 {
-	return platform_driver_register(&i2c_msm_driver);
+	int ret;
+
+	place_marker("M - DRIVER I2C Init");
+	ret = platform_driver_register(&i2c_msm_driver);
+	place_marker("M - DRIVER I2C Ready");
+	return ret;
 }
 subsys_initcall(i2c_msm_init);
 
