@@ -363,7 +364,9 @@ static void __init get_fs_names(char *page)
 static int __init do_mount_root(char *name, char *fs, int flags, void *data)
 {
 	struct super_block *s;
-	int err = sys_mount(name, "/root", fs, flags, data);
+	int err;
+	place_marker("M - DRIVER F/S Init");
+	err = sys_mount(name, "/root", fs, flags, data);
 	if (err)
 		return err;
 
@@ -375,6 +378,7 @@ static int __init do_mount_root(char *name, char *fs, int flags, void *data)
 	       s->s_type->name,
 	       s->s_flags & MS_RDONLY ?  " readonly" : "",
 	       MAJOR(ROOT_DEV), MINOR(ROOT_DEV));
+	place_marker("M - DRIVER F/S Ready");
 	return 0;
 }
 
