 module_init(dwc3_msm_init);
diff --git a/init/do_mounts.c b/init/do_mounts.c
index 1902a1c8..f6f0fc1 100644
--- a/init/do_mounts.c
+++ b/init/do_mounts.c
@@ -34,6 +34,7 @@
 #include <linux/nfs_mount.h>
 
