From 7e7749ab92ab5453fa50190936aaa3f489d78db3 Mon Sep 17 00:00:00 2001
From: Bharathraj Nagaraju <snbraj@codeaurora.org>
Date: Thu, 26 Oct 2017 11:32:01 -0700
Subject: [PATCH 2/4] Revert "ntb: add DMA error handling for RX DMA"

This reverts commit 72203572afd7aef243c182f19925e5a77a1dc6a1.

Change-Id: If87b45ad27111e710b3b5420c9d0a76af079ad3b
Signed-off-by: Bharathraj Nagaraju <snbraj@codeaurora.org>
---
 drivers/ntb/ntb_transport.c | 98 ++++++++++++++-------------------------------
 1 file changed, 29 insertions(+), 69 deletions(-)

diff --git a/drivers/ntb/ntb_transport.c b/drivers/ntb/ntb_transport.c
index f58d8e3..9404b3d 100644
--- a/drivers/ntb/ntb_transport.c
+++ b/drivers/ntb/ntb_transport.c
@@ -109,13 +109,13 @@ struct ntb_queue_entry {
 	int retries;
 	int errors;
 	unsigned int tx_index;
-	unsigned int rx_index;
 
 	struct ntb_transport_qp *qp;
 	union {
 		struct ntb_payload_header __iomem *tx_hdr;
 		struct ntb_payload_header *rx_hdr;
 	};
+	unsigned int index;
 };
 
 struct ntb_rx_info {
@@ -262,9 +262,6 @@ static struct ntb_client ntb_transport_client;
 static int ntb_async_tx_submit(struct ntb_transport_qp *qp,
 			       struct ntb_queue_entry *entry);
 static void ntb_memcpy_tx(struct ntb_queue_entry *entry, void __iomem *offset);
-static int ntb_async_rx_submit(struct ntb_queue_entry *entry, void *offset);
-static void ntb_memcpy_rx(struct ntb_queue_entry *entry, void *offset);
-
 
 static int ntb_transport_bus_match(struct device *dev,
 				   struct device_driver *drv)
@@ -1244,7 +1241,7 @@ static void ntb_complete_rxc(struct ntb_transport_qp *qp)
 			break;
 
 		entry->rx_hdr->flags = 0;
-		iowrite32(entry->rx_index, &qp->rx_info->entry);
+		iowrite32(entry->index, &qp->rx_info->entry);
 
 		cb_data = entry->cb_data;
 		len = entry->len;
@@ -1262,36 +1259,10 @@ static void ntb_complete_rxc(struct ntb_transport_qp *qp)
 	spin_unlock_irqrestore(&qp->ntb_rx_q_lock, irqflags);
 }
 
-static void ntb_rx_copy_callback(void *data,
-				 const struct dmaengine_result *res)
+static void ntb_rx_copy_callback(void *data)
 {
 	struct ntb_queue_entry *entry = data;
 
-	/* we need to check DMA results if we are using DMA */
-	if (res) {
-		enum dmaengine_tx_result dma_err = res->result;
-
-		switch (dma_err) {
-		case DMA_TRANS_READ_FAILED:
-		case DMA_TRANS_WRITE_FAILED:
-			entry->errors++;
-		case DMA_TRANS_ABORTED:
-		{
-			struct ntb_transport_qp *qp = entry->qp;
-			void *offset = qp->rx_buff + qp->rx_max_frame *
-					qp->rx_index;
-
-			ntb_memcpy_rx(entry, offset);
-			qp->rx_memcpy++;
-			return;
-		}
-
-		case DMA_TRANS_NOERROR:
-		default:
-			break;
-		}
-	}
-
 	entry->flags |= DESC_DONE_FLAG;
 
 	ntb_complete_rxc(entry->qp);
@@ -1307,10 +1278,10 @@ static void ntb_memcpy_rx(struct ntb_queue_entry *entry, void *offset)
 	/* Ensure that the data is fully copied out before clearing the flag */
 	wmb();
 
-	ntb_rx_copy_callback(entry, NULL);
+	ntb_rx_copy_callback(entry);
 }
 
-static int ntb_async_rx_submit(struct ntb_queue_entry *entry, void *offset)
+static void ntb_async_rx(struct ntb_queue_entry *entry, void *offset)
 {
 	struct dma_async_tx_descriptor *txd;
 	struct ntb_transport_qp *qp = entry->qp;
@@ -1322,6 +1293,13 @@ static int ntb_async_rx_submit(struct ntb_queue_entry *entry, void *offset)
 	void *buf = entry->buf;
 
 	len = entry->len;
+
+	if (!chan)
+		goto err;
+
+	if (len < copy_bytes)
+		goto err;
+
 	device = chan->device;
 	pay_off = (size_t)offset & ~PAGE_MASK;
 	buff_off = (size_t)buf & ~PAGE_MASK;
@@ -1348,13 +1326,23 @@ static int ntb_async_rx_submit(struct ntb_queue_entry *entry, void *offset)
 
 	unmap->from_cnt = 1;
 
-	txd = device->device_prep_dma_memcpy(chan, unmap->addr[1],
-					     unmap->addr[0], len,
-					     DMA_PREP_INTERRUPT);
-	if (!txd)
+	for (retries = 0; retries < DMA_RETRIES; retries++) {
+		txd = device->device_prep_dma_memcpy(chan, unmap->addr[1],
+						     unmap->addr[0], len,
+						     DMA_PREP_INTERRUPT);
+		if (txd)
+			break;
+
+		set_current_state(TASK_INTERRUPTIBLE);
+		schedule_timeout(DMA_OUT_RESOURCE_TO);
+	}
+
+	if (!txd) {
+		qp->dma_rx_prep_err++;
 		goto err_get_unmap;
+	}
 
-	txd->callback_result = ntb_rx_copy_callback;
+	txd->callback = ntb_rx_copy_callback;
 	txd->callback_param = entry;
 	dma_set_unmap(txd, unmap);
 
@@ -1368,38 +1356,13 @@ static int ntb_async_rx_submit(struct ntb_queue_entry *entry, void *offset)
 
 	qp->rx_async++;
 
-	return 0;
+	return;
 
 err_set_unmap:
 	dmaengine_unmap_put(unmap);
 err_get_unmap:
 	dmaengine_unmap_put(unmap);
 err:
-	return -ENXIO;
-}
-
-static void ntb_async_rx(struct ntb_queue_entry *entry, void *offset)
-{
-	struct ntb_transport_qp *qp = entry->qp;
-	struct dma_chan *chan = qp->rx_dma_chan;
-	int res;
-
-	if (!chan)
-		goto err;
-
-	if (entry->len < copy_bytes)
-		goto err;
-
-	res = ntb_async_rx_submit(entry, offset);
-	if (res < 0)
-		goto err;
-
-	if (!entry->retries)
-		qp->rx_async++;
-
-	return;
-
-err:
 	ntb_memcpy_rx(entry, offset);
 	qp->rx_memcpy++;
 }
@@ -1445,7 +1408,7 @@ static int ntb_process_rxc(struct ntb_transport_qp *qp)
 	}
 
 	entry->rx_hdr = hdr;
-	entry->rx_index = qp->rx_index;
+	entry->index = qp->rx_index;
 
 	if (hdr->len > entry->len) {
 		dev_dbg(&qp->ndev->pdev->dev,
@@ -2011,9 +1974,6 @@ int ntb_transport_rx_enqueue(struct ntb_transport_qp *qp, void *cb, void *data,
 	entry->buf = data;
 	entry->len = len;
 	entry->flags = 0;
-	entry->retries = 0;
-	entry->errors = 0;
-	entry->rx_index = 0;
 
 	ntb_list_add(&qp->ntb_rx_q_lock, &entry->entry, &qp->rx_pend_q);
 
-- 
1.9.1

