From 9c7b5615bb4dd587cae134b0bc234f4bdd4d0e9e Mon Sep 17 00:00:00 2001
From: Jiacheng Zheng <jiaczhen@codeaurora.org>
Date: Fri, 9 Feb 2018 18:42:59 +0800
Subject: [PATCH] remove unused reserve memory to get more free memory

Signed-off-by: Jiacheng Zheng <jiaczhen@codeaurora.org>
---
 arch/arm/boot/dts/qcom/msm8996-agave-adp.dtsi |  9 ---------
 arch/arm/boot/dts/qcom/msm8996.dtsi           | 10 ++++------
 2 files changed, 4 insertions(+), 15 deletions(-)

diff --git a/arch/arm/boot/dts/qcom/msm8996-agave-adp.dtsi b/arch/arm/boot/dts/qcom/msm8996-agave-adp.dtsi
index 9c6d12f..af08ab3 100644
--- a/arch/arm/boot/dts/qcom/msm8996-agave-adp.dtsi
+++ b/arch/arm/boot/dts/qcom/msm8996-agave-adp.dtsi
@@ -1520,18 +1520,9 @@
 
 / {
 	reserved-memory {
-		lk_mem: lk_pool@0x91600000 {
-			reg = <0 0x91600000 0 0x00600000>;
-			label = "lk_pool";
-		};
-
 		early_camera_mem: early_camera_mem@b3fff000 {
 			reg = <0 0xb3fff000 0 0x800000>;
 			label = "early_camera_mem";
 		};
-		early_audio_mem: early_audio_mem@0xb5fff000 {
-			reg = <0x0 0xb5fff000 0x0 0x3FFFFC>;
-			label = "early_audio_mem";
-		};
 	};
 };
diff --git a/arch/arm/boot/dts/qcom/msm8996.dtsi b/arch/arm/boot/dts/qcom/msm8996.dtsi
index 3b067e6..2df112d 100644
--- a/arch/arm/boot/dts/qcom/msm8996.dtsi
+++ b/arch/arm/boot/dts/qcom/msm8996.dtsi
@@ -206,12 +206,6 @@
 		#size-cells = <2>;
 		ranges;
 
-		removed_regions: removed_regions@85800000 {
-			compatible = "removed-dma-pool";
-			no-map;
-			reg = <0 0x85800000 0 0x3000000>;
-		};
-
 		peripheral_mem: peripheral_region@8ea00000 {
 			compatible = "removed-dma-pool";
 			no-map;
@@ -240,12 +234,14 @@
 			reusable;
 			alignment = <0 0x200000>;
 			size = <0 0x5c00000>;
+			status = "disabled";
 		};
 
 		modem_mem: modem_region@88800000 {
 			compatible = "removed-dma-pool";
 			no-map;
 			reg = <0 0x88800000 0 0x6200000>;
+			status = "disabled";
 		};
 
 		dfps_data_mem: dfps_data_mem@83400000 {
@@ -256,11 +252,13 @@
 		cont_splash_mem: cont_splash_mem@83401000 {
 			reg = <0 0x83401000 0 0x23FF000>;
 			label = "cont_splash_mem";
+			status = "disabled";
 		};
 
 		cont_splash_mem_hdmi: cont_splash_mem_hdmi@bdd00000 {
 			reg = <0 0xbdd00000 0 0x23ff000>;
 			label = "cont_splash_mem_hdmi";
+			status = "disabled";
 		};
 	};
 };
-- 
1.9.1

