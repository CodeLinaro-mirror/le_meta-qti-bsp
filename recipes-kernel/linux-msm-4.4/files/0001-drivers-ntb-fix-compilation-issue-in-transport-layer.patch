From f7cd24fc9c51e3364b180e815c15a3b9b8fcbec1 Mon Sep 17 00:00:00 2001
From: Bharathraj Nagaraju <snbraj@codeaurora.org>
Date: Thu, 26 Oct 2017 16:05:49 -0700
Subject: [PATCH 4/4] drivers:ntb: fix compilation issue in transport layer.

Fix compilation issue introduce in backporting the NTB
framework.

Change-Id: I1843999ac6257a05e6b461abe7c1cb54b9e0e01e
Signed-off-by: Bharathraj Nagaraju <snbraj@codeaurora.org>
---
 drivers/ntb/ntb_transport.c | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/drivers/ntb/ntb_transport.c b/drivers/ntb/ntb_transport.c
index 35e36cc..92ae197 100644
--- a/drivers/ntb/ntb_transport.c
+++ b/drivers/ntb/ntb_transport.c
@@ -68,6 +68,9 @@
 #define NTB_TRANSPORT_DESC	"Software Queue-Pair Transport over NTB"
 #define NTB_TRANSPORT_MIN_SPADS (MW0_SZ_HIGH + 2)
 
+#define DMA_RETRIES             20
+#define DMA_OUT_RESOURCE_TO     msecs_to_jiffies(50)
+
 MODULE_DESCRIPTION(NTB_TRANSPORT_DESC);
 MODULE_VERSION(NTB_TRANSPORT_VER);
 MODULE_LICENSE("Dual BSD/GPL");
@@ -1282,6 +1285,7 @@ static void ntb_async_rx(struct ntb_queue_entry *entry, void *offset)
 	struct dma_chan *chan = qp->rx_dma_chan;
 	struct dma_device *device;
 	size_t pay_off, buff_off, len;
+	int retries = 0;
 	struct dmaengine_unmap_data *unmap;
 	dma_cookie_t cookie;
 	void *buf = entry->buf;
@@ -1331,10 +1335,8 @@ static void ntb_async_rx(struct ntb_queue_entry *entry, void *offset)
 		schedule_timeout(DMA_OUT_RESOURCE_TO);
 	}
 
-	if (!txd) {
-		qp->dma_rx_prep_err++;
+	if (!txd)
 		goto err_get_unmap;
-	}
 
 	txd->callback = ntb_rx_copy_callback;
 	txd->callback_param = entry;
@@ -1574,8 +1576,7 @@ static void ntb_async_tx(struct ntb_transport_qp *qp,
 		schedule_timeout(DMA_OUT_RESOURCE_TO);
 	}
 
-	if (!txd) {
-		qp->dma_tx_prep_err++;
+	if (!txd)
 		goto err_get_unmap;
 
 	txd->callback = ntb_tx_copy_callback;
-- 
1.9.1

