+/*============================================================================
+ *
+ *           Add SPAD support using reserved fields of the switch. Since
+ *           NTB transport uses spad's it is needed for time being.
+ *
+ *           Since IDT doesnt have SPAD we will use unsed registers
+ *           as scratch pads
+ *
+ *
+ *           Partion 0 SPAD 0 - NUM_SPADS-1
+ *           Partion 1 SPAD 0 - NUM_SPADS-1
+ *           PArtion 2 SPAD 0 - NUM_SPADS-1
+ *           PARTION N SPAD 0 - NUM_SPADS-1
+ *
+ *           Note this only works on PES24NTAG6 switch
+ *
+ *           Each SPAD will be 32 bits
+ *            SPARE register found:
+ *
+ *            0x3e7f0, 0x3e7f4, 0x3f100, 0x3a528, 0x3a52c, 0x3a530, 0x3a534
+ *
+ *
+ *=============================================================================
+ */
+#define NUM_SPADS 3
+#define SPAD_BASE 0x3e7f0
+
+//parttition x, spad  y
+u32 spad_address[3][3]=
+{
+   {0x3e7f0, 0x3e7f4, 0x3a528}, /* PARTITION 0 */
+   {0x3f100, 0x3f100, 0x3f100}, /* PARTITION 1 */ //not supportd
+   {0x3a52C, 0x3a530, 0x3a534}, /* PARTITION 2 */
+};
+int idt_ntb_spad_is_unsafe(struct ntb_dev *ntb)
+{
+   return 0;
+}
+int idt_ntb_spad_count(struct ntb_dev *ntb)
+{
+   /* Allocate 8 SPADS for each peer */
+   return NUM_SPADS;
+}
+
+u32 idt_ntb_spad_read(struct ntb_dev *ntb, int sidx)
+{
+	struct idt_ntb_dev *ndev = to_ndev_ntb(ntb);
+   return idt_sw_read(ndev, spad_address[ndev->part][sidx]);
+}
+int idt_ntb_spad_write(struct ntb_dev *ntb, int sidx, u32 val)
+{
+	struct idt_ntb_dev *ndev = to_ndev_ntb(ntb);
+   idt_sw_write(ndev, spad_address[ndev->part][sidx], val);
+   return 0;
+}
+
+int idt_ntb_peer_spad_addr(struct ntb_dev *ntb, int pidx, int sidx,
+			      phys_addr_t *spad_addr)
+{
+   /* Not needed */
+   return 0;
+}
+u32 idt_ntb_peer_spad_read(struct ntb_dev *ntb, int pidx, int sidx)
+{
+	struct idt_ntb_dev *ndev = to_ndev_ntb(ntb);
+   return idt_sw_read(ndev, spad_address[ndev->part][sidx]);
+}
+int idt_ntb_peer_spad_write(struct ntb_dev *ntb, int pidx, int sidx,
+			       u32 val)
+{
+	struct idt_ntb_dev *ndev = to_ndev_ntb(ntb);
+   idt_sw_write(ndev, spad_address[ndev->part][sidx], val);
+
+   return 0;
+}
+
 /*=============================================================================
  *                           8. ISRs related operations
  *
@@ -2077,6 +2173,12 @@ static const struct ntb_dev_ops idt_ntb_ops = {
