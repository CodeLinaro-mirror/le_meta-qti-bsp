+/* MODIFICATION
+ *
+ * IDT switches dont assign 32 doorbells per port rather each port can set
+ * up to 32 doorbells and any port can listen to any of the 32 doorbells. this makes
+ * it rather complicating because when one client tries to set a DB it could bounce back
+ * to itself. The GDBLSTATUS is used to set which dorbells map to which partition.
+ * Modify the below API's to work with logical dorbells 0- 3 lets say and then map those
+ * to the physical 32 dorbells that map to each paritition */
+
+#define NUM_DB 4
+#define DB_MASK ((1<<NUM_DB)-1)
+
 /*
  * idt_db_isr() - doorbell event ISR
  * @ndev:	IDT NTB hardware driver descriptor
@@ -1449,7 +1464,11 @@ static void idt_db_isr(struct idt_ntb_dev *ndev, u32 ntint_sts)
  */
 static u64 idt_ntb_db_valid_mask(struct ntb_dev *ntb)
 {
-	return IDT_DBELL_MASK;
+  struct idt_ntb_dev *ndev = to_ndev_ntb(ntb);
+
+   /* Return dorbells we support per partition */
+   return DB_MASK;
+  //return IDT_DBELL_MASK;
 }
 
