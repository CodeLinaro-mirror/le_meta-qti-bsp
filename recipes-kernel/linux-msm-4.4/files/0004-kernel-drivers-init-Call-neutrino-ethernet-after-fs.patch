From 0b5eb933fc4e928639b8c952273309aca9e7238a Mon Sep 17 00:00:00 2001
From: Lei wang <leiwan@codeaurora.org>
Date: Sat, 10 Feb 2018 11:14:25 +0800
Subject: [PATCH] Call neutrino ethernet after fs ready

Change-Id: Ide2dad4794b7a2bab8e42d4bae52b3e83a10a08d
Signed-off-by: Zou Shunxiang <shunxian@codeaurora.org>
Signed-off-by: Lei wang <leiwan@codeaurora.org>
---
 init/main.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/init/main.c b/init/main.c
index 562dd7e..c27bdfc 100644
--- a/init/main.c
+++ b/init/main.c
@@ -842,6 +842,7 @@ static char *initcall_level_names[] __initdata = {
 	"late",
 };
 
+extern int __DWC_ETH_QOS_pcie_init(void);
 static char init_prog[128] = "/usr/sbin/early_init";
 static char *init_prog_argv[2] = { init_prog, NULL };
 
@@ -1068,6 +1069,12 @@ static noinline void __init kernel_init_freeable(void)
 	else
 		pr_err("early_init failed\n");
 
+	rc = __DWC_ETH_QOS_pcie_init();
+	if (!rc)
+		pr_info("__DWC_ETH_QOS_pcie_init launched\n");
+	else
+		pr_err("__DWC_ETH_QOS_pcie_init failed\n");
+
 	wait_for_device_probe();
 	rc = call_usermodehelper(touch_early_done, touch_early_done_argv, NULL, 0);
 	if (!rc)
-- 
