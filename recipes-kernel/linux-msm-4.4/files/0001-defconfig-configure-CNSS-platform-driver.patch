Subject: [PATCH] defconfig: configure CNSS platform driver

Change-Id: I1aad888deaf99308a7af6e101c9d6d4e6a0f721a
---
 arch/arm64/configs/msm-auto_defconfig | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/configs/msm-auto_defconfig b/arch/arm64/configs/msm-auto_defconfig
index 85916a5..0ac4d0e 100644
--- a/arch/arm64/configs/msm-auto_defconfig
+++ b/arch/arm64/configs/msm-auto_defconfig
@@ -280,8 +280,8 @@ CONFIG_ATH_CARDS=y
 CONFIG_WIL6210=m
 CONFIG_CLD_LL_CORE=y
 CONFIG_BUS_AUTO_SUSPEND=y
-CONFIG_CNSS2=y
-CONFIG_CNSS2_DEBUG=y
+CONFIG_CNSS=y
+CONFIG_CNSS_ASYNC=y
 CONFIG_INPUT_EVDEV=y
 CONFIG_INPUT_KEYRESET=y
 CONFIG_KEYBOARD_GPIO=y
