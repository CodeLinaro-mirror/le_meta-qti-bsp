diff --git a/arch/arm/boot/dts/qcom/msm8996-camera-sensor-adp.dtsi b/arch/arm/boot/dts/qcom/msm8996-camera-sensor-adp.dtsi
index 31139c0..77ef34d 100644
--- a/arch/arm/boot/dts/qcom/msm8996-camera-sensor-adp.dtsi
+++ b/arch/arm/boot/dts/qcom/msm8996-camera-sensor-adp.dtsi
@@ -25,6 +25,7 @@
 	actuator0: qcom,actuator@0 {
 		cell-index = <0>;
 		reg = <0x0>;
+		status = "disabled";
 		compatible = "qcom,actuator";
 		qcom,cci-master = <0>;
 		cam_vaf-supply = <&pm8994_l23>;
@@ -37,6 +38,7 @@
 	actuator1: qcom,actuator@1 {
 		cell-index = <1>;
 		reg = <0x1>;
+		status = "disabled";
 		compatible = "qcom,actuator";
 		qcom,cci-master = <1>;
 		cam_vaf-supply = <&pm8994_l23>;
@@ -188,7 +190,7 @@
 		qcom,sensor-position = <0>;
 		qcom,sensor-mode = <0>;
 		qcom,cci-master = <0>;
-		status = "ok";
+		status = "disabled";
 		clocks = <&clock_mmss clk_mclk1_clk_src>,
 			<&clock_mmss clk_camss_mclk1_clk>;
 		clock-names = "cam_src_clk", "cam_clk";
