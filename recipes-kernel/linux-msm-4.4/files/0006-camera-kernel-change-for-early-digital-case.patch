+
 #include "msm_isp.h"
 #include "msm_isp_util.h"
 #include "msm_isp_axi_util.h"
@@ -503,6 +505,8 @@ static int vfe_probe(struct platform_device *pdev)
 			break;
 	}
 
+	place_marker("# isp out");
+
 	return rc;
 }
 
@@ -635,12 +639,14 @@ static struct platform_driver vfe_driver = {
 	.driver = {
 		.name = "msm_vfe",
 		.owner = THIS_MODULE,
+		.probe_type = PROBE_PREFER_ASYNCHRONOUS,
 		.of_match_table = msm_vfe_dt_match,
 	},
 };
 
 static int __init msm_vfe_init_module(void)
 {
+	place_marker("# isp in");
 	return platform_driver_register(&vfe_driver);
 }
 
@@ -649,7 +655,7 @@ static void __exit msm_vfe_exit_module(void)
 	platform_driver_unregister(&vfe_driver);
 }
 
-late_initcall(msm_vfe_init_module);
+fs_initcall_sync(msm_vfe_init_module);
 module_exit(msm_vfe_exit_module);
 MODULE_DESCRIPTION("MSM VFE driver");
 MODULE_LICENSE("GPL v2");
