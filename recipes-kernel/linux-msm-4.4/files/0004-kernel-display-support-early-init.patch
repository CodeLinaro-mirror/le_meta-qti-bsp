diff --git a/drivers/regulator/fan53555.c b/drivers/regulator/fan53555.c
index 28a2619..5b7c7e4 100644
--- a/drivers/regulator/fan53555.c
+++ b/drivers/regulator/fan53555.c
@@ -468,7 +468,22 @@ static struct i2c_driver fan53555_regulator_driver = {
 	.id_table = fan53555_id,
 };
 
-module_i2c_driver(fan53555_regulator_driver);
+//module_i2c_driver(fan53555_regulator_driver);
+
+static int __init fan53555_regulator_driver_init(void)
+{
+    return i2c_add_driver(&fan53555_regulator_driver);
+}
+
+fs_initcall(fan53555_regulator_driver_init);
+
+static void __exit fan53555_regulator_driver_exit(void)
+{
+    return i2c_del_driver(&fan53555_regulator_driver);
+}
+
+module_exit(fan53555_regulator_driver_exit);
+
 
 MODULE_AUTHOR("Yunfan Zhang <yfzhang@marvell.com>");
 MODULE_DESCRIPTION("FAN53555 regulator driver");
