From b9403b5d8861f0c4b9fa70dd4341ad487f49c468 Mon Sep 17 00:00:00 2001
From: Guchun Chen <guchunc@codeaurora.org>
Date: Thu, 12 Jul 2018 14:52:36 +0800
Subject: [PATCH] kernel: display support early init

Change-Id: I78c5c807e1ac6d073d2d1980d0e2a5dcee18993c
Signed-off-by: Guchun Chen <guchunc@codeaurora.org>
---
 drivers/gpu/drm/drm_drv.c                     |  2 +-
 drivers/gpu/drm/drm_fb_helper.c               |  2 +-
 drivers/gpu/drm/msm/dsi-staging/dsi_display.c |  2 +-
 drivers/gpu/drm/msm/hdmi-staging/sde_hdmi.c   |  2 +-
 drivers/gpu/drm/msm/msm_atomic.c              |  7 +++++++
 drivers/gpu/drm/msm/msm_drv.c                 |  2 +-
 drivers/gpu/drm/msm/sde/sde_kms.c             |  2 +-
 drivers/gpu/drm/msm/sde/sde_plane.c           |  6 +++---
 drivers/gpu/drm/msm/sde/sde_wb.c              |  2 +-
 drivers/regulator/fan53555.c                  | 17 ++++++++++++++++-
 drivers/soc/qcom/subsys-pil-tz.c              |  2 +-
 drivers/video/fbdev/msm/msm_dba/adv7533.c     |  2 +-
 12 files changed, 35 insertions(+), 13 deletions(-)

diff --git a/drivers/gpu/drm/drm_drv.c b/drivers/gpu/drm/drm_drv.c
index ccc2044..760410e 100644
--- a/drivers/gpu/drm/drm_drv.c
+++ b/drivers/gpu/drm/drm_drv.c
@@ -927,5 +927,5 @@ static void __exit drm_core_exit(void)
 	idr_destroy(&drm_minors_idr);
 }
 
-module_init(drm_core_init);
+fs_initcall(drm_core_init);
 module_exit(drm_core_exit);
diff --git a/drivers/gpu/drm/drm_fb_helper.c b/drivers/gpu/drm/drm_fb_helper.c
index 5ad0367..b9d2b76 100644
--- a/drivers/gpu/drm/drm_fb_helper.c
+++ b/drivers/gpu/drm/drm_fb_helper.c
@@ -2189,5 +2189,5 @@ static int __init drm_fb_helper_modinit(void)
 	return 0;
 }
 
-module_init(drm_fb_helper_modinit);
+fs_initcall(drm_fb_helper_modinit);
 #endif
diff --git a/drivers/gpu/drm/msm/dsi-staging/dsi_display.c b/drivers/gpu/drm/msm/dsi-staging/dsi_display.c
index c468a6f..c5a3c67 100644
--- a/drivers/gpu/drm/msm/dsi-staging/dsi_display.c
+++ b/drivers/gpu/drm/msm/dsi-staging/dsi_display.c
@@ -2868,5 +2868,5 @@ static void __exit dsi_display_unregister(void)
 	dsi_phy_drv_unregister();
 }
 
-module_init(dsi_display_register);
+fs_initcall(dsi_display_register);
 module_exit(dsi_display_unregister);
diff --git a/drivers/gpu/drm/msm/hdmi-staging/sde_hdmi.c b/drivers/gpu/drm/msm/hdmi-staging/sde_hdmi.c
index 0d0f2a7..86801ef 100644
--- a/drivers/gpu/drm/msm/hdmi-staging/sde_hdmi.c
+++ b/drivers/gpu/drm/msm/hdmi-staging/sde_hdmi.c
@@ -3268,5 +3268,5 @@ static void __exit sde_hdmi_unregister(void)
 	platform_driver_unregister(&sde_hdmi_driver);
 }
 
-module_init(sde_hdmi_register);
+fs_initcall(sde_hdmi_register);
 module_exit(sde_hdmi_unregister);
diff --git a/drivers/gpu/drm/msm/msm_atomic.c b/drivers/gpu/drm/msm/msm_atomic.c
index 0c119ec..a659367 100644
--- a/drivers/gpu/drm/msm/msm_atomic.c
+++ b/drivers/gpu/drm/msm/msm_atomic.c
@@ -20,6 +20,7 @@
 #include "msm_kms.h"
 #include "msm_gem.h"
 #include "sde_trace.h"
+#include <soc/qcom/boot_stats.h>
 
 struct msm_commit {
 	struct drm_device *dev;
@@ -403,6 +404,7 @@ static void complete_commit(struct msm_commit *commit)
 	struct drm_device *dev = state->dev;
 	struct msm_drm_private *priv = dev->dev_private;
 	struct msm_kms *kms = priv->kms;
+	static int commit_count = 0;
 
 	kms->funcs->prepare_commit(kms, state);
 
@@ -431,6 +433,11 @@ static void complete_commit(struct msm_commit *commit)
 
 	kms->funcs->complete_commit(kms, state);
 
+	if(commit_count++ < 3)
+	{
+	    place_marker("M - Commit finished");
+	}
+
 	drm_atomic_state_free(state);
 
 	commit_destroy(commit);
diff --git a/drivers/gpu/drm/msm/msm_drv.c b/drivers/gpu/drm/msm/msm_drv.c
index 6f968e9..e186e56 100644
--- a/drivers/gpu/drm/msm/msm_drv.c
+++ b/drivers/gpu/drm/msm/msm_drv.c
@@ -2250,7 +2250,7 @@ static void __exit msm_drm_unregister(void)
 	msm_smmu_driver_cleanup();
 }
 
-module_init(msm_drm_register);
+fs_initcall(msm_drm_register);
 module_exit(msm_drm_unregister);
 
 MODULE_AUTHOR("Rob Clark <robdclark@gmail.com");
diff --git a/drivers/gpu/drm/msm/sde/sde_kms.c b/drivers/gpu/drm/msm/sde/sde_kms.c
index 86a5c23..102e721 100644
--- a/drivers/gpu/drm/msm/sde/sde_kms.c
+++ b/drivers/gpu/drm/msm/sde/sde_kms.c
@@ -69,7 +69,7 @@
  *
  *	This is disabled by default.
  */
-static bool sdecustom = true;
+static bool sdecustom;
 module_param(sdecustom, bool, 0400);
 MODULE_PARM_DESC(sdecustom, "Enable customizations for sde clients");
 
diff --git a/drivers/gpu/drm/msm/sde/sde_plane.c b/drivers/gpu/drm/msm/sde/sde_plane.c
index ceac5a9..038011e 100644
--- a/drivers/gpu/drm/msm/sde/sde_plane.c
+++ b/drivers/gpu/drm/msm/sde/sde_plane.c
@@ -1661,9 +1661,9 @@ static int sde_plane_atomic_check(struct drm_plane *plane,
 			ret = -E2BIG;
 
 		/* valid yuv image */
-		} else if (SDE_FORMAT_IS_YUV(fmt) && ((src.x & 0x1)
-					|| (src.y & 0x1) || (src.w & 0x1)
-					|| (src.h & 0x1))) {
+		} else if (SDE_FORMAT_IS_YUV(fmt) &&
+			(fmt->base.pixel_format != DRM_FORMAT_UYVY) &&
+			((src.x & 0x1) || (src.y & 0x1) || (src.w & 0x1) || (src.h & 0x1))) {
 			SDE_ERROR_PLANE(psde, "invalid yuv source %u, %u,\"\
 				%ux%u\n", src.x, src.y, src.w, src.h);
 			ret = -EINVAL;
diff --git a/drivers/gpu/drm/msm/sde/sde_wb.c b/drivers/gpu/drm/msm/sde/sde_wb.c
index 647cb58..af91691 100644
--- a/drivers/gpu/drm/msm/sde/sde_wb.c
+++ b/drivers/gpu/drm/msm/sde/sde_wb.c
@@ -741,5 +741,5 @@ static void __exit sde_wb_unregister(void)
 	platform_driver_unregister(&sde_wb_driver);
 }
 
-module_init(sde_wb_register);
+fs_initcall(sde_wb_register);
 module_exit(sde_wb_unregister);
diff --git a/drivers/regulator/fan53555.c b/drivers/regulator/fan53555.c
index 0781c71..245ccad 100644
--- a/drivers/regulator/fan53555.c
+++ b/drivers/regulator/fan53555.c
@@ -471,7 +471,22 @@ static struct i2c_driver fan53555_regulator_driver = {
 	.id_table = fan53555_id,
 };
 
-module_i2c_driver(fan53555_regulator_driver);
+//module_i2c_driver(fan53555_regulator_driver);
+
+static int __init fan53555_regulator_driver_init(void)
+{
+    return i2c_add_driver(&fan53555_regulator_driver);
+}
+
+fs_initcall(fan53555_regulator_driver_init);
+
+static void __exit fan53555_regulator_driver_exit(void)
+{
+    return i2c_del_driver(&fan53555_regulator_driver);
+}
+
+module_exit(fan53555_regulator_driver_exit);
+
 
 MODULE_AUTHOR("Yunfan Zhang <yfzhang@marvell.com>");
 MODULE_DESCRIPTION("FAN53555 regulator driver");
diff --git a/drivers/soc/qcom/subsys-pil-tz.c b/drivers/soc/qcom/subsys-pil-tz.c
index 2a23519..2abc97c 100644
--- a/drivers/soc/qcom/subsys-pil-tz.c
+++ b/drivers/soc/qcom/subsys-pil-tz.c
@@ -1211,7 +1211,7 @@ static int __init pil_tz_init(void)
 {
 	return platform_driver_register(&pil_tz_driver);
 }
-module_init(pil_tz_init);
+fs_initcall(pil_tz_init);
 
 static void __exit pil_tz_exit(void)
 {
diff --git a/drivers/video/fbdev/msm/msm_dba/adv7533.c b/drivers/video/fbdev/msm/msm_dba/adv7533.c
index 5b7fb9c..0fe9550 100644
--- a/drivers/video/fbdev/msm/msm_dba/adv7533.c
+++ b/drivers/video/fbdev/msm/msm_dba/adv7533.c
@@ -2170,7 +2170,7 @@ static void __exit adv7533_exit(void)
 
 module_param_string(panel, mdss_mdp_panel, MDSS_MAX_PANEL_LEN, 0);
 
-module_init(adv7533_init);
+fs_initcall(adv7533_init);
 module_exit(adv7533_exit);
 MODULE_LICENSE("GPL v2");
 MODULE_DESCRIPTION("adv7533 driver");
-- 
