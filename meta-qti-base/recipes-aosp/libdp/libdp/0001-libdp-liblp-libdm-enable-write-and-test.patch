---
 fs_mgr/libdm/Makefile.am      | 15 +++++++++++++++
 fs_mgr/libdm/loop_control.cpp |  3 ++-
 fs_mgr/liblp/Makefile.am      | 31 ++++++++++++++++++++++++++++---
 fs_mgr/liblp/builder_test.cpp |  4 ++--
 fs_mgr/liblp/io_test.cpp      |  4 ++--
 5 files changed, 49 insertions(+), 8 deletions(-)

diff --git a/fs_mgr/libdm/Makefile.am b/fs_mgr/libdm/Makefile.am
index 7494c65..4f47ce7 100644
--- a/fs_mgr/libdm/Makefile.am
+++ b/fs_mgr/libdm/Makefile.am
@@ -15,3 +15,18 @@ dm_include_HEADERS := $(srcdir)/include/libdm/dm.h \
                       $(srcdir)/include/libdm/dm_table.h \
                       $(srcdir)/include/libdm/dm_target.h \
                       $(srcdir)/include/libdm/loop_control.h
+
+bin_PROGRAMS := dm_test
+
+dm_test_SOURCES := dm_test.cpp \
+                   loop_control_test.cpp \
+                   test_util.cpp
+
+dm_test_CPPFLAGS := -I$(top_srcdir)/base/include \
+                     -I$(srcdir)/include \
+                     -std=c++17
+dm_test_LDFLAGS := -version-info $(LT_VERSION_INFO)
+dm_test_LDADD := $(top_builddir)/base/libbase_q.la
+dm_test_LDADD += libdm.la
+dm_test_LDADD += -lgtest -lgtest_main
+
diff --git a/fs_mgr/libdm/loop_control.cpp b/fs_mgr/libdm/loop_control.cpp
index 0beb1a6..192db6b 100644
--- a/fs_mgr/libdm/loop_control.cpp
+++ b/fs_mgr/libdm/loop_control.cpp
@@ -87,7 +87,8 @@ bool LoopControl::FindFreeLoopDevice(std::string* loopdev) const {
     // Ueventd on android creates all loop devices as /dev/block/loopX
     // The total number of available devices is determined by 'loop.max_part'
     // kernel command line argument.
-    *loopdev = ::android::base::StringPrintf("/dev/block/loop%d", rc);
+    //*loopdev = ::android::base::StringPrintf("/dev/block/loop%d", rc);
+    *loopdev = ::android::base::StringPrintf("/dev/loop%d", rc);
     return true;
 }
 
diff --git a/fs_mgr/liblp/Makefile.am b/fs_mgr/liblp/Makefile.am
index 3e02a63..bf70a8b 100644
--- a/fs_mgr/liblp/Makefile.am
+++ b/fs_mgr/liblp/Makefile.am
@@ -2,14 +2,39 @@ lib_LTLIBRARIES := liblp.la
 
 liblp_la_SOURCES := partition_opener.cpp \
                     reader.cpp \
-                    utility.cpp
+                    utility.cpp \
+                    writer.cpp \
+                    builder.cpp \
+                    images.cpp
 
 liblp_la_CPPFLAGS := -I$(srcdir)/include -I$(top_srcdir)/base/include
 liblp_la_LDFLAGS  := -version-info $(LT_VERSION_INFO) -lcrypto
-liblp_la_LIBADD   := $(top_builddir)/base/libbase_q.la
+liblp_la_LIBADD   := $(top_builddir)/base/libbase_q.la -lsparse
+
+lp_includedir = $(includedir)/liblp
+#lp_includedir += $(top_srcdir)/libsparse/include
 
-lp_includedir=$(includedir)/liblp
 lp_include_HEADERS := $(srcdir)/include/liblp/liblp.h \
                       $(srcdir)/include/liblp/metadata_format.h \
                       $(srcdir)/include/liblp/partition_opener.h
 
+bin_PROGRAMS := lp_test
+lp_test_SOURCES := builder_test.cpp \
+                   io_test.cpp \
+                   test_partition_opener.cpp \
+                   utility.cpp
+
+lp_test_CPPFLAGS := -I$(srcdir)/include \
+                    -I$(top_srcdir)/base/include \
+                    -I$(top_srcdir)/fs_mgr/include \
+                    -I$(top_srcdir)/fs_mgr/include_fstab \
+                    -I$(top_srcdir)/libsparse/include
+
+lp_test_LDFLAGS  := -version-info $(LT_VERSION_INFO) -lcrypto
+lp_test_LDADD   := $(top_builddir)/base/libbase_q.la
+lp_test_LDADD += liblp.la
+lp_test_LDADD += -lgtest -lgtest_main
+
+lp_test_includedir=$(includedir)/liblp
+
+
