+ * Copyright (c) 2023 Qualcomm Innovation Center, Inc. All rights reserved.
+ * SPDX-License-Identifier: BSD-3-Clause-Clear
+ */
+
 #include <ctype.h>
 #include <dirent.h>
 #include <errno.h>
@@ -33,7 +40,10 @@
 #include <android-base/properties.h>
 #include <android-base/stringprintf.h>
 #include <android-base/strings.h>
+//disable DSU for android container
+#if defined(__ANDROID__)
 #include <libgsi/libgsi.h>
+#endif
 
 #include "fs_mgr_priv.h"
 
@@ -582,6 +592,8 @@ bool EraseFstabEntry(Fstab* fstab, const std::string& mount_point) {
 
 }  // namespace
 
+//disable DSU for android container
+#if defined(__ANDROID__)
 void TransformFstabForDsu(Fstab* fstab, const std::vector<std::string>& dsu_partitions) {
     static constexpr char kDsuKeysDir[] = "/avb";
     // Convert userdata
@@ -655,6 +667,7 @@ void TransformFstabForDsu(Fstab* fstab, const std::vector<std::string>& dsu_part
         }
     }
 }
+#endif
 
 void EnableMandatoryFlags(Fstab* fstab) {
     // Devices launched in R and after should enable fs_verity on userdata. The flag causes tune2fs
@@ -684,11 +697,14 @@ bool ReadFstabFromFile(const std::string& path, Fstab* fstab) {
         LERROR << __FUNCTION__ << "(): failed to load fstab from : '" << path << "'";
         return false;
     }
+//disable DSU for android container
+#if defined(__ANDROID__)
     if (!is_proc_mounts && !access(android::gsi::kGsiBootedIndicatorFile, F_OK)) {
-        std::string lp_names;
-        ReadFileToString(gsi::kGsiLpNamesFile, &lp_names);
-        TransformFstabForDsu(fstab, Split(lp_names, ","));
+       std::string lp_names;
+       ReadFileToString(gsi::kGsiLpNamesFile, &lp_names);
+       TransformFstabForDsu(fstab, Split(lp_names, ","));
     }
+#endif
 
 #ifndef NO_SKIP_MOUNT
     SkipMountingPartitions(fstab);
diff --git a/fs_mgr/libfs_avb/Makefile.am b/fs_mgr/libfs_avb/Makefile.am
new file mode 100644
index 0000000000..12686dba64
--- /dev/null
+++ b/fs_mgr/libfs_avb/Makefile.am
@@ -0,0 +1,24 @@
+ACLOCAL_AMFLAGS = -I m4
+
+lib_LTLIBRARIES := libfs_avb.la
+
+libfs_avb_la_SOURCES := avb_ops.cpp avb_util.cpp fs_avb_util.cpp fs_avb.cpp types.cpp util.cpp
+
+libfs_avb_la_CPPFLAGS := -I$(top_srcdir)/include \
+    -I$(top_srcdir)/base/include \
+    -I$(top_srcdir)/fs_mgr/include \
+    -I$(top_srcdir)/fs_mgr/include_fstab \
+    -I$(top_srcdir)/fs_mgr/libdm/include \
+    -I$(srcdir)/include \
+    -std=c++17
+
+libfs_avb_includedir=$(includedir)/libfs_avb
+libfs_avb_include_HEADERS := $(srcdir)/avb_ops.h \
+    $(srcdir)/avb_util.h \
+    $(srcdir)/sha.h \
+    $(srcdir)/util.h \
+    $(srcdir)/include/fs_avb/fs_avb.h \
+    $(srcdir)/include/fs_avb/fs_avb_util.h \
+    $(srcdir)/include/fs_avb/types.h
+
+libfs_avb_la_LDFLAGS := -Wall -Werror -version-info $(LT_VERSION_INFO)
