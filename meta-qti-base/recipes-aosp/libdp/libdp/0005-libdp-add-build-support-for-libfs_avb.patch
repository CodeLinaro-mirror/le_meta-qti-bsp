From ab6416353b92bf33e869aa1ec2620105be6a0f40 Mon Sep 17 00:00:00 2001
From: naiwyu <quic_naiwyu@quicinc.com>
Date: Tue, 28 Feb 2023 16:40:12 +0800
Subject: [PATCH] avb-lxc: add build support for libfs_avb

Modifications:
1. add libfs_avb
2. adb avb_tool depends
3. add fs_mgr slot
4. disable DSU

Upstream-Status:Inappropriate [Android has similar design already]

Change-Id: I2e0e813553e347661f37cb7d136722597e2923e8
---
 configure.ac                  |  3 ++-
 fs_mgr/Makefile.am            | 11 ++++++++---
 fs_mgr/fs_mgr_fstab.cpp       | 22 +++++++++++++++++++---
 fs_mgr/libfs_avb/Makefile.am  | 24 ++++++++++++++++++++++++
 fs_mgr/libfs_avb/avb_util.cpp | 11 +++++++++--
 fs_mgr/libfs_avb/avb_util.h   |  9 +++++++++
 fs_mgr/libfs_avb/fs_avb.cpp   | 12 ++++++++++++
 7 files changed, 83 insertions(+), 9 deletions(-)
 create mode 100644 fs_mgr/libfs_avb/Makefile.am

diff --git a/configure.ac b/configure.ac
index 3f4bbe1a1d..3d7dbdc5ea 100644
--- a/configure.ac
+++ b/configure.ac
@@ -24,7 +24,8 @@ AC_CONFIG_FILES([ \
     base/Makefile \
     fs_mgr/Makefile \
     fs_mgr/liblp/Makefile \
-    fs_mgr/libdm/Makefile
+    fs_mgr/libdm/Makefile \
+    fs_mgr/libfs_avb/Makefile
 ])
 AC_OUTPUT
 
diff --git a/fs_mgr/Makefile.am b/fs_mgr/Makefile.am
index 74babc12d0..64b83a87c3 100644
--- a/fs_mgr/Makefile.am
+++ b/fs_mgr/Makefile.am
@@ -1,17 +1,22 @@
-SUBDIRS := liblp libdm
+SUBDIRS := liblp libdm libfs_avb
 
 lib_LTLIBRARIES := libfsmgr_dmlinear.la
 
-libfsmgr_dmlinear_la_SOURCES := fs_mgr_dm_linear.cpp
+libfsmgr_dmlinear_la_SOURCES := fs_mgr_dm_linear.cpp \
+                                fs_mgr_fstab.cpp \
+                                fs_mgr_slotselect.cpp \
+                                fs_mgr_boot_config.cpp
 
 libfsmgr_dmlinear_la_CPPFLAGS := -I$(srcdir)/include \
                            -I$(srcdir)/libdm/include \
                            -I$(srcdir)/liblp/include \
                            -I$(top_srcdir)/base/include \
                            -I$(srcdir)/include_fstab \
+                           -I$(srcdir)/libfs_avb/include \
                            -std=c++17
-libfsmgr_dmlinear_la_LDFLAGS  := -version-info $(LT_VERSION_INFO) -lcrypto
+libfsmgr_dmlinear_la_LDFLAGS  := -version-info $(LT_VERSION_INFO) -lcrypto -lavb
 libfsmgr_dmlinear_la_LIBADD   := ./libdm/libdm.la
+libfsmgr_dmlinear_la_LIBADD   := ./libfs_avb/libfs_avb.la
 
 fsmgr_dmlinear_includedir=$(includedir)
 fsmgr_dmlinear_include_HEADERS := $(srcdir)/include/fs_mgr_dm_linear.h
diff --git a/fs_mgr/fs_mgr_fstab.cpp b/fs_mgr/fs_mgr_fstab.cpp
index 8a2207870f..05fdf39bd2 100644
--- a/fs_mgr/fs_mgr_fstab.cpp
+++ b/fs_mgr/fs_mgr_fstab.cpp
@@ -14,6 +14,13 @@
  * limitations under the License.
  */
 
+/*
+ * Changes from Qualcomm Innovation Center are provided under the following license:
