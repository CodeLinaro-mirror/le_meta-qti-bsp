 }
 
+bool SetDmVerity(const FsAvbHashtreeDescriptor& hashtree_desc, std::string image,
+                 std::string blk_device, bool wait_for_verity_dev) {
+    android::dm::DmTable table;
+    if (!ConstructVerityTable(hashtree_desc, blk_device, &table) || !table.valid()) {
+        LERROR << "Failed to construct verity table.";
+        return false;
+    }
+    table.set_readonly(true);
+
+    std::chrono::milliseconds timeout = {};
+    if (wait_for_verity_dev) timeout = 1s;
+
+    std::string dev_path;
+    android::dm::DeviceMapper& dm = android::dm::DeviceMapper::Instance();
+
+    if (!dm.CreateDevice(image + "-verity", table, &dev_path, timeout)) {
+        LERROR << "Couldn't create verity device!";
+        return false;
+    }
+
+    LINFO << "dev_path for" << blk_device << " is: " << dev_path;
+
+    return true;
+}
