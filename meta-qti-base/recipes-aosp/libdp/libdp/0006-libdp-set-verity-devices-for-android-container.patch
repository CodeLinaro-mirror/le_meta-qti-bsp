+AvbUniquePtr AvbHandle::Init(std::string ab_suffix, std::vector<std::string> vbmeta_images,
+                             std::vector<std::string> verity_images) {
+    AvbUniquePtr avb_handle(new AvbHandle());
+    if (!avb_handle) {
+        LERROR << "Failed to allocate AvbHandle";
+        return nullptr;
+    }
+
+    for (auto image : vbmeta_images) {
+        std::unique_ptr<VBMetaData> vbmeta_image = avb_handle->LoadVbmetaByPath(image + ab_suffix);
+        avb_handle->vbmeta_images_.emplace_back(std::move(*vbmeta_image));
+    }
+
+    for (auto image : verity_images) {
+        auto hashtree_desc = GetHashtreeDescriptor(image, avb_handle->vbmeta_images_);
+        if (hashtree_desc == nullptr) {
+            continue;
+        }
+        std::string linear_device_path = "/dev/device-mapper/" + image + ab_suffix;
+        if (!SetDmVerity(*hashtree_desc, image, linear_device_path, true)) {
+            LERROR << "Failed to set verity device for " << image;
+        }
+    }
+
+    return avb_handle;
+}
+
+std::unique_ptr<VBMetaData> AvbHandle::LoadVbmetaByPath(std::string partition_name) {
+    uint64_t vbmeta_offset = 0;
+    uint64_t vbmeta_size = VBMetaData::kMaxVBMetaSize;
+    uint64_t vbmeta_num_read = 0;
+
+    auto vbmeta = std::make_unique<VBMetaData>(vbmeta_size, partition_name);
+
+    FsManagerAvbOps avb_ops;
+    AvbIOResult load_result =
+            avb_ops.ReadFromPartition(partition_name.c_str(), 0, vbmeta_size, vbmeta->data(), &vbmeta_num_read);
+    if (load_result) {
+        LERROR << partition_name << " load fail, result: " << load_result;
+        return nullptr;
+    }
+
+    std::unique_ptr<AvbVBMetaImageHeader> vbmeta_header =
+            vbmeta->GetVBMetaHeader(true /* update_vbmeta_size */);
+    if (!vbmeta_header) {
+        LERROR << partition_name << ": Failed to get vbmeta header";
+        return nullptr;
+    }
+
+    return vbmeta;
+}
+
 AvbHashtreeResult AvbHandle::SetUpStandaloneAvbHashtree(FstabEntry* fstab_entry,
                                                         bool wait_for_verity_dev) {
     auto avb_handle = LoadAndVerifyVbmeta(*fstab_entry);
