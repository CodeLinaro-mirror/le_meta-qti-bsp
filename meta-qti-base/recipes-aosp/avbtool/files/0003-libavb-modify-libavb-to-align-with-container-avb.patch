 #if !defined(AVB_INSIDE_LIBAVB_H) && !defined(AVB_COMPILATION)
 #error "Never include this file directly, include libavb.h instead."
 #endif
@@ -109,6 +116,12 @@ struct AvbOps {
    */
   struct AvbAtxOps* atx_ops;
 
+  /* FIXME
+   * The container_id is set when passed from the container_verified_boot API,
+   * and holds the id of the container for which image are verified.
+   */
+  uint32_t container_id;
+
   /* Reads |num_bytes| from offset |offset| from partition with name
    * |partition| (NUL-terminated UTF-8 string). If |offset| is
    * negative, its absolute value should be interpreted as the number
@@ -331,6 +344,19 @@ struct AvbOps {
       size_t public_key_metadata_length,
       bool* out_is_trusted,
       uint32_t* out_rollback_index_location);
+
+//FIXME
+
+  /* Set the container_id for this ops instance.
+   * Returns AVB_IO_RESULT_OK on success, otherwise an error code.
+   */
+  AvbIOResult (*set_container_id)(AvbOps* ops, uint32_t container_id);
+
+  /* Get the container_id for this ops instance.
+   * Returns AVB_IO_RESULT_OK on success, otherwise an error code.
+   */
+  AvbIOResult (*get_container_id)(AvbOps* ops, uint32_t* out_container_id);
+
 };
 
