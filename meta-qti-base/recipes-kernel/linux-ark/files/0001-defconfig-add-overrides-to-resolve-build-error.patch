 redhat/configs/custom-overrides/generic/CONFIG_DEBUG_INFO_DWARF5 | 1 +
 2 files changed, 2 insertions(+)
 create mode 100644 redhat/configs/custom-overrides/generic/CONFIG_DEBUG_INFO_BTF
 create mode 100644 redhat/configs/custom-overrides/generic/CONFIG_DEBUG_INFO_DWARF5

diff --git a/redhat/configs/custom-overrides/generic/CONFIG_DEBUG_INFO_BTF b/redhat/configs/custom-overrides/generic/CONFIG_DEBUG_INFO_BTF
new file mode 100644
index 000000000000..3b5ac748f282
--- /dev/null
+++ b/redhat/configs/custom-overrides/generic/CONFIG_DEBUG_INFO_BTF
@@ -0,0 +1 @@
+# CONFIG_DEBUG_INFO_BTF is not set
diff --git a/redhat/configs/custom-overrides/generic/CONFIG_DEBUG_INFO_DWARF5 b/redhat/configs/custom-overrides/generic/CONFIG_DEBUG_INFO_DWARF5
new file mode 100644
index 000000000000..e31a11334fce
--- /dev/null
+++ b/redhat/configs/custom-overrides/generic/CONFIG_DEBUG_INFO_DWARF5
