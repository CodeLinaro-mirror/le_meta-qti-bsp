diff --git a/arch/arm64/gunyah/irq.c b/arch/arm64/gunyah/irq.c
index a81eb08..0cb4e06 100644
--- a/arch/arm64/gunyah/irq.c
+++ b/arch/arm64/gunyah/irq.c
@@ -35,7 +35,7 @@ int gh_get_irq(u32 virq, u32 type, struct fwnode_handle *fw_handle)
 	struct irq_fwspec fwspec = {};
 	int ret;
 
-	ret = arch_gunyah_fill_irq_fwspec_params(virq, &fwspec);
+	ret = arch_gh_fill_irq_fwspec_params(virq, &fwspec);
 	if (ret) {
 		pr_err("Failed to translate interrupt: type: %d virq: %d: ret: %d\n",
 		       type, virq, ret);
diff --git a/drivers/soc/qcom/debug_symbol.c b/drivers/soc/qcom/debug_symbol.c
index 9f83739..7edbc64 100644
--- a/drivers/soc/qcom/debug_symbol.c
+++ b/drivers/soc/qcom/debug_symbol.c
@@ -26,7 +26,7 @@
 #include <linux/of_reserved_mem.h>
 #include <linux/kallsyms.h>
 #include "debug_symbol.h"
-#include "drivers/android/debug_kinfo.h"
+#include "../../android/debug_kinfo.h"
 
 struct debug_symbol_data {
 	const unsigned long *addresses;
@@ -84,7 +84,7 @@ bool debug_symbol_available(void)
 
 	if (!debug_symbol.addresses) {
 		debug_symbol.addresses = (unsigned long *)
-						__phys_to_kimg(kinfo->_text_pa);
+						__phys_to_kimg(kinfo->_stext_pa);
 		debug_symbol.offsets = (int *)
 						__phys_to_kimg(kinfo->_offsets_pa);
 		debug_symbol.names = (u8 *)
@@ -201,6 +201,10 @@ unsigned long debug_symbol_lookup_name(const char *name)
 	if (!*name)
 		return 0;
 
+	/* Fallback to kallsyms if debug_symbol is not available */
+	if (!debug_symbol_available())
+		return kallsyms_lookup_name(name);
+
 	ret = find_in_ds_entries(name);
 	if (ret)
 		return ret;
diff --git a/drivers/soc/qcom/minidump_log.c b/drivers/soc/qcom/minidump_log.c
index afd53c8..fde0e5d 100644
--- a/drivers/soc/qcom/minidump_log.c
+++ b/drivers/soc/qcom/minidump_log.c
@@ -45,7 +45,7 @@
 #include <asm/memory.h>
 
 #include <linux/sched/cputime.h>
-#include "kernel/sched/sched.h"
+#include <kernel/sched/sched.h>
 #include <linux/sched/walt.h>
 
 #include <linux/kdebug.h>
@@ -58,13 +58,17 @@
 #include <linux/cma.h>
 #include <linux/dma-map-ops.h>
 #include <linux/sched/clock.h>
+#if IS_ENABLED(CONFIG_ANDROID_VENDOR_HOOKS)
 #include <trace/hooks/cpufreq.h>
+#endif
 #ifdef CONFIG_QCOM_MINIDUMP_PANIC_CPU_CONTEXT
 #include <trace/hooks/debug.h>
 #endif
+#ifdef CONFIG_QCOM_MINIDUMP_PANIC_MEMORY_INFO
 #include "minidump_memory.h"
 #endif
-#include "kernel/time/tick-internal.h"
+#endif
+#include <kernel/time/tick-internal.h>
 
 #ifdef CONFIG_QCOM_DYN_MINIDUMP_STACK
 
@@ -99,7 +103,9 @@ static struct md_suspend_context_data md_suspend_context;
 static bool is_vmap_stack __read_mostly;
 
 #ifdef CONFIG_QCOM_MINIDUMP_FTRACE
+#if IS_ENABLED(CONFIG_ANDROID_VENDOR_HOOKS)
 #include <trace/hooks/ftrace_dump.h>
+#endif
 #include <linux/ring_buffer.h>
 #include <linux/trace_seq.h>
 
@@ -1244,7 +1250,9 @@ dump_rq:
 #ifdef CONFIG_QCOM_MINIDUMP_PANIC_KTASK_STACK
 	md_dump_ktask_stack();
 #endif
+#ifdef CONFIG_QCOM_MINIDUMP_PANIC_MEMORY_INFO
 	md_dump_memory();
+#endif
 	dump_stack_minidump(0);
 	md_in_oops_handler = false;
 }
@@ -1319,11 +1327,13 @@ static void md_register_panic_data(void)
 {
 	int ret;
 
+#ifdef CONFIG_QCOM_MINIDUMP_PANIC_MEMORY_INFO
 	ret = md_minidump_memory_init();
 	if (ret) {
 		pr_err("Failed to look up all minidump memory symbols, rc: %d\n", ret);
 		return;
 	}
+#endif
 
 #ifdef CONFIG_QCOM_MINIDUMP_PANIC_CPU_CONTEXT
 	md_register_panic_entries(MD_CPU_CNTXT_PAGES, "KCNTXT",
@@ -1512,9 +1522,11 @@ static void register_cpufreq_log(void)
 	if (msm_minidump_add_region(&md_entry) < 0)
 		pr_err("Failed to add %s in Minidump\n", md_entry.name);
 
+#if IS_ENABLED(CONFIG_ANDROID_VENDOR_HOOKS)
 	register_trace_android_vh_cpufreq_resolve_freq(log_cpu_freq, NULL);
 	register_trace_android_vh_cpufreq_fast_switch(log_cpu_freq, NULL);
 	register_trace_android_vh_cpufreq_target(log_cpu_freq, NULL);
+#endif
 }
 #else
 static inline void register_cpufreq_log(void) {}
diff --git a/drivers/soc/qcom/msm_minidump.c b/drivers/soc/qcom/msm_minidump.c
index a8c4ecc..97d69da 100644
--- a/drivers/soc/qcom/msm_minidump.c
+++ b/drivers/soc/qcom/msm_minidump.c
@@ -312,6 +312,10 @@ static int msm_minidump_add_header(void)
 	char *banner, *linux_banner;
 
 	linux_banner = DEBUG_SYMBOL_LOOKUP(linux_banner);
+	if (!linux_banner) {
+		pr_warn("Minidump: linux_banner lookup failed, using fallback\n");
+		linux_banner = "Linux version unknown (debug_symbol not available)";
+	}
 	/* Header buffer contains:
 	 * elf header, MAX_NUM_ENTRIES+4 of section and program elf headers,
 	 * string table section and linux banner.
@@ -403,7 +407,7 @@ int msm_minidump_driver_probe(const struct md_init_data *data)
 	int ret = 0;
 
 	if (!debug_symbol_available())
-		return -EPROBE_DEFER;
+		pr_warn("Minidump: debug_symbol not available, symbol lookup will use kallsyms\n");
 
 	md_core.ops = data->ops;
 
