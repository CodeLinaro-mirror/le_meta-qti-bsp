From a5ad5bce21c9658a0da4a5a7c1c61b2db25ba501 Mon Sep 17 00:00:00 2001
From: Lakshay Dutta <ldutta@qti.qualcomm.com>
Date: Wed, 25 Jun 2025 10:54:30 +0530
Subject: [PATCH] meta-qti-bsp: Add Null check for fopen call

-Added Null check to prevent crashes if fopen fails

Change-Id:If9a56f6f29edf90be4d8d5f2686dc3e3c6cac8fa
Signed-off-by: Lakshay Dutta <ldutta@qti.qualcomm.com>
---
 .../0001-Add-Null-check-after-fopen.patch     | 29 +++++++++++++++++++
 .../tinyalsa-new/tinyalsa-new_git.bb          |  1 +
 2 files changed, 30 insertions(+)
 create mode 100644 meta-qti-base/recipes-audio/tinyalsa-new/files/0001-Add-Null-check-after-fopen.patch

diff --git a/meta-qti-base/recipes-audio/tinyalsa-new/files/0001-Add-Null-check-after-fopen.patch b/meta-qti-base/recipes-audio/tinyalsa-new/files/0001-Add-Null-check-after-fopen.patch
new file mode 100644
index 000000000..b57f1b59b
--- /dev/null
+++ b/meta-qti-base/recipes-audio/tinyalsa-new/files/0001-Add-Null-check-after-fopen.patch
@@ -0,0 +1,29 @@
+diff --git a/utils/tinyplay.c b/utils/tinyplay.c
+index d617074..541c574 100644
+--- a/utils/tinyplay.c
++++ b/utils/tinyplay.c
+@@ -26,6 +26,13 @@
+ ** DAMAGE.
+ */
+
++/*
++**Changes from Qualcomm Technologies, Inc. are provided under the following license:
++
++**Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
++**SPDX-License-Identifier: BSD-3-Clause-Clear
++ */
++
+ #include <tinyalsa/asoundlib.h>
+ #include <signal.h>
+ #include <stdbool.h>
+@@ -184,6 +191,10 @@ static int ctx_init(struct ctx* ctx, struct cmd *cmd)
+         ctx->file = stdin;
+     } else {
+         ctx->file = fopen(cmd->filename, "rb");
++        if (ctx->file == NULL) {
++            fprintf(stderr, "failed to open '%s'\n", cmd->filename);
++            return -1;
++        }
+         fseek(ctx->file, 0L, SEEK_END);
+         ctx->file_size = ftell(ctx->file);
+         fseek(ctx->file, 0L, SEEK_SET);

--
2.25.1

