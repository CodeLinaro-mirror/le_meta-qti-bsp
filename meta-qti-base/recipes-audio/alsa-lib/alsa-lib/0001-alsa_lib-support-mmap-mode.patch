From 316ec4a45f42ec97b1b41f271c95d311595f4dc3 Mon Sep 17 00:00:00 2001
From: Deru Wang <quic_deruwang@quicinc.com>
Date: Wed, 27 Dec 2023 20:27:14 +0800
Subject: [PATCH] alsa_lib: support mmap mode

Upstream-Status: Pending

Signed-off-by: Deru Wang <quic_deruwang@quicinc.com>
---
 include/pcm_ioplug.h |  3 +++
 src/pcm/pcm_ioplug.c | 64 +++++++++++++++++++++++++++++++++++++++++---
 2 files changed, 63 insertions(+), 4 deletions(-)

diff --git a/include/pcm_ioplug.h b/include/pcm_ioplug.h
index 81ac861..4ebb166 100644
--- a/include/pcm_ioplug.h
+++ b/include/pcm_ioplug.h
@@ -211,6 +211,9 @@ struct snd_pcm_ioplug_callback {
 	 * set the channel map; optional; since v1.0.2
 	 */
 	int (*set_chmap)(snd_pcm_ioplug_t *io, const snd_pcm_chmap_t *map);
+	void* (*mmap) (snd_pcm_ioplug_t *io);
+	int (*munmap) (snd_pcm_ioplug_t *io);
+	int (*channel_info) (snd_pcm_ioplug_t* io, int *fd);
 };
 
 
diff --git a/src/pcm/pcm_ioplug.c b/src/pcm/pcm_ioplug.c
index 9818439..a4aedab 100644
--- a/src/pcm/pcm_ioplug.c
+++ b/src/pcm/pcm_ioplug.c
@@ -104,6 +104,29 @@ static int snd_pcm_ioplug_info(snd_pcm_t *pcm, snd_pcm_info_t *info)
 
 static int snd_pcm_ioplug_channel_info(snd_pcm_t *pcm, snd_pcm_channel_info_t *info)
 {
+	ioplug_priv_t *io = pcm->private_data;
+
+	if (pcm->mmap_rw) {
+		switch (pcm->access) {
+		case SND_PCM_ACCESS_MMAP_INTERLEAVED:
+			info->first = info->channel * pcm->sample_bits;
+			info->step = pcm->frame_bits;
+			break;
+		case SND_PCM_ACCESS_MMAP_NONINTERLEAVED:
+			info->first = 0;
+			info->step = pcm->sample_bits;
+			break;
+		default:
+			SNDMSG("invalid access type %d", pcm->access);
+			return -EINVAL;
+		}
+		info->addr = 0;
+		info->type = SND_PCM_AREA_MMAP;
+		info->u.mmap.offset = 0;
+		if (!io->data->callback->channel_info)
+			return -ENOSYS;
+		return io->data->callback->channel_info(io->data, &info->u.mmap.fd);
+	}
 	return snd_pcm_channel_info_shm(pcm, info, -1);
 }
 
@@ -467,6 +490,21 @@ static int snd_pcm_ioplug_sw_params(snd_pcm_t *pcm, snd_pcm_sw_params_t *params)
 	ioplug_priv_t *io = pcm->private_data;
 	int err;
 
+#ifdef SUPPORT_MMAP
+	if (pcm->access == SND_PCM_ACCESS_MMAP_INTERLEAVED ||
+		pcm->access == SND_PCM_ACCESS_MMAP_NONINTERLEAVED ||
+		pcm->access == SND_PCM_ACCESS_MMAP_COMPLEX) {
+		pcm->mmap_rw = 1;
+		io->data->mmap_rw = 1;
+	} else {
+		pcm->mmap_rw = 0;
+		io->data->mmap_rw = 0;
+	}
+#else
+	pcm->mmap_rw = 0;
+	io->data->mmap_rw = 0;
+#endif
+
 	if (!io->data->callback->sw_params)
 		return 0;
 
@@ -823,9 +861,18 @@ static int snd_pcm_ioplug_poll_revents(snd_pcm_t *pcm, struct pollfd *pfds, unsi
 	return err;
 }
 
-static int snd_pcm_ioplug_mmap(snd_pcm_t *pcm ATTRIBUTE_UNUSED)
+static int snd_pcm_ioplug_mmap(snd_pcm_t *pcm)
 {
-	return 0;
+	ioplug_priv_t *io = pcm->private_data;
+	int err = 0;
+
+#ifdef SUPPORT_MMAP
+	if (io->data->callback->mmap) {
+		err = io->data->callback->mmap(io->data);
+	}
+#endif
+
+	return err;
 }
 
 static int snd_pcm_ioplug_async(snd_pcm_t *pcm ATTRIBUTE_UNUSED,
@@ -835,9 +882,18 @@ static int snd_pcm_ioplug_async(snd_pcm_t *pcm ATTRIBUTE_UNUSED,
 	return -ENOSYS;
 }
 
-static int snd_pcm_ioplug_munmap(snd_pcm_t *pcm ATTRIBUTE_UNUSED)
+static int snd_pcm_ioplug_munmap(snd_pcm_t *pcm)
 {
-	return 0;
+	ioplug_priv_t *io = pcm->private_data;
+	int err = 0;
+
+#ifdef SUPPORT_MMAP
+	if (io->data->callback->munmap) {
+		err = io->data->callback->munmap(io->data);
+	}
+#endif
+
+	return err;
 }
 
 static snd_pcm_chmap_query_t **snd_pcm_ioplug_query_chmaps(snd_pcm_t *pcm)
-- 
2.17.1

