[Unit]
Description=Service to start the Android GVM
Requires=vhost-user-disp.service vhost-user-gpu.service vhost-user-misc.service vhost-user-aud.service vhost-user-vid.service vhost-user-cam.service gsl_hab_server.service kgsl.service
After=multi-user.target vhost-user-disp.service vhost-user-gpu.service vhost-user-misc.service vhost-user-aud.service vhost-user-vid.service vhost-user-cam.service gsl_hab_server.service kgsl.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/qcrosvm.sh

[Install]
WantedBy = multi-user.target
