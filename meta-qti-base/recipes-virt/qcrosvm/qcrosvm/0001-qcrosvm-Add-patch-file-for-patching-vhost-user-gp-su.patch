From b66f2c152acc04101267e87681e8b0b765a5da60 Mon Sep 17 00:00:00 2001
From: xiaoye <quic_xiaoye@quicinc.com>
Date: Fri, 7 Jun 2024 11:50:14 +0800
Subject: [PATCH] qcrosvm: Add patch file for patching vhost-user-gp support in
 qcrosvm.service

Signed-off-by: xiaoye <quic_xiaoye@quicinc.com>
Change-Id: I4af32db019d8fece40f2359ad2c409ad85f2ed2d
---
 qcrosvm.service | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/qcrosvm.service b/qcrosvm.service
index d85c658..e021725 100644
--- a/qcrosvm.service
+++ b/qcrosvm.service
@@ -3,8 +3,8 @@
 [Unit]
 Description=Service to start the Android GVM
 # List of service unit dependencies
-Requires=display-be.service gsl_hab_server.service vhost-user-misc.service hyp-video-be.service qcx_be_server.service vmm-pwr-key.service
-After=display-be.service gsl_hab_server.service vhost-user-misc.service audio-umd.service awe-audio.service hyp-video-be.service qcx_be_server.service vmm-pwr-key.service
+Requires=display-be.service gsl_hab_server.service vhost-user-misc.service hyp-video-be.service qcx_be_server.service vmm-pwr-key.service vhost-user-glinkpassthrough.service vhost-user-frpc.service
+After=display-be.service gsl_hab_server.service vhost-user-misc.service audio-umd.service awe-audio.service hyp-video-be.service qcx_be_server.service vmm-pwr-key.service vhost-user-glinkpassthrough.service vhost-user-frpc.service
 # List of device unit dependencies
 Requires=dev-input-vmm\x2dpwr\x2dkey.device
 After=dev-input-vmm\x2dpwr\x2dkey.device
@@ -36,6 +36,8 @@ ExecStart=/usr/bin/qcrosvm \
 --vhost-user-hab "/tmp/linux-vm2-vid-skt",label=3D,device-id=95,queue-num=6 \
 --vhost-user-hab "/tmp/linux-vm2-cam-skt",label=3E,device-id=92,queue-num=4 \
 --vhost-user-scmi "/tmp/pt-dev-skt",label=42 \
+--vhost-user-gp /tmp/gp_hello,label=44 \
+--vhost-user-frpc "/tmp/sock_file_frpc",label=45 \
 --input=/dev/input/event1,label=3F \
 --input=/dev/input/vmm-pwr-key,label=40
 
-- 
2.17.1

