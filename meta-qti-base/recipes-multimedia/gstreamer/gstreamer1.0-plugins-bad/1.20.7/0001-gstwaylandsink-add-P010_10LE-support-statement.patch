From b0015137ab647c21e225323d19d538a6b19c304c Mon Sep 17 00:00:00 2001
From: Bo Fang <quic_bofang@quicinc.com>
Date: Wed, 17 Aug 2022 15:14:01 +0800
Subject: [PATCH 1/2] gstwaylandsink: add P010_10LE support statement

Whether really support P010_10LE is decided by whether wayland server reported
format list contain this format during runtime.

Upstream-Status: Pending

Change-Id: Ida4eaa3c959838a01a6846caef73b58859aa2d9f
Signed-off-by: Bo Fang <quic_bofang@quicinc.com>
---
 ext/wayland/gstwaylandsink.c | 2 +-
 ext/wayland/wlvideoformat.c  | 1 +
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/ext/wayland/gstwaylandsink.c b/ext/wayland/gstwaylandsink.c
index 0761304ce3..7a3c1f54b1 100644
--- a/ext/wayland/gstwaylandsink.c
+++ b/ext/wayland/gstwaylandsink.c
@@ -72,7 +72,7 @@ GST_DEBUG_CATEGORY (gstwayland_debug);
 #define WL_VIDEO_FORMATS \
     "{ BGRx, BGRA, RGBx, xBGR, xRGB, RGBA, ABGR, ARGB, RGB, BGR, " \
     "RGB16, BGR16, YUY2, YVYU, UYVY, AYUV, NV12, NV21, NV16, NV61, " \
-    "YUV9, YVU9, Y41B, I420, YV12, Y42B, v308 }"
+    "YUV9, YVU9, Y41B, I420, YV12, Y42B, v308, P010_10LE }"
 
 static GstStaticPadTemplate sink_template = GST_STATIC_PAD_TEMPLATE ("sink",
     GST_PAD_SINK,
diff --git a/ext/wayland/wlvideoformat.c b/ext/wayland/wlvideoformat.c
index 68cec50932..dd5d801d8f 100644
--- a/ext/wayland/wlvideoformat.c
+++ b/ext/wayland/wlvideoformat.c
@@ -66,6 +66,7 @@ static const wl_VideoFormat wl_formats[] = {
   {WL_SHM_FORMAT_YVU420, DRM_FORMAT_YVU420, GST_VIDEO_FORMAT_YV12},
   {WL_SHM_FORMAT_YUV422, DRM_FORMAT_YUV422, GST_VIDEO_FORMAT_Y42B},
   {WL_SHM_FORMAT_YUV444, DRM_FORMAT_YUV444, GST_VIDEO_FORMAT_v308},
+  {WL_SHM_FORMAT_P010, DRM_FORMAT_P010, GST_VIDEO_FORMAT_P010_10LE},
 };
 
 enum wl_shm_format
-- 
