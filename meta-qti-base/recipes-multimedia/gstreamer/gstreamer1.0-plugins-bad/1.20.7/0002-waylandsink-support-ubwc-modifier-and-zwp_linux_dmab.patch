 .../ext/wayland/gstwaylandsink.h              |  1 +
 .../gst-plugins-bad/ext/wayland/wldisplay.c   | 22 ++++++++++++-
 .../gst-plugins-bad/ext/wayland/wldisplay.h   |  1 +
 .../ext/wayland/wllinuxdmabuf.c               |  9 +++++-
