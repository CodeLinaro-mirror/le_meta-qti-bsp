From 188b55a9e0e19d29dd12b9fc0c60897fc947995d Mon Sep 17 00:00:00 2001
From: Yimin Peng <quic_yiminp@quicinc.com>
Date: Tue, 8 Aug 2023 13:36:35 +0800
Subject: [PATCH] safelinux-cfg-mdoules: fix build issue on msm-6.1

resovle API conflicts for msm-6.1 branch.

Change-Id: I3190c039e6eb10cea656c558d20063037893d94c
Signed-off-by: Yimin Peng <quic_yiminp@quicinc.com>
---
 safelinux-modules/drivers/iommu_iova_map.c       | 14 +++++++-------
 safelinux-modules/drivers/kiumd.c                |  3 +--
 safelinux-modules/drivers/vfio_iommu_qcom.c      |  1 -
 safelinux-modules/include/linux/iommu_iova_map.h |  2 +-
 4 files changed, 9 insertions(+), 11 deletions(-)

diff --git a/safelinux-modules/drivers/iommu_iova_map.c b/safelinux-modules/drivers/iommu_iova_map.c
index 0983532..e700f6d 100644
--- a/safelinux-modules/drivers/iommu_iova_map.c
+++ b/safelinux-modules/drivers/iommu_iova_map.c
@@ -97,7 +97,7 @@ static int insert_range(const __be32 *p, int naddr, int nsize, void *arg)
 	}
 
 	new = iommu_alloc_resv_region(start, end - start + 1,
-						0, IOMMU_RESV_RESERVED);
+						0, IOMMU_RESV_RESERVED, GFP_KERNEL);
 	if (!new)
 		return -ENOMEM;
 	list_add_tail(&new->list, &region->list);
@@ -153,7 +153,7 @@ static int invert_regions(struct list_head *head, struct list_head *inverted)
 			goto next;
 
 		new = iommu_alloc_resv_region(rsv_start, rsv_size,
-						0, IOMMU_RESV_RESERVED);
+						0, IOMMU_RESV_RESERVED, GFP_KERNEL);
 		if (!new) {
 			ret = -ENOMEM;
 			goto out_err;
@@ -169,7 +169,7 @@ next:
 	rsv_size = curr->start;
 	if (rsv_size) {
 		new = iommu_alloc_resv_region(rsv_start, rsv_size,
-						0, IOMMU_RESV_RESERVED);
+						0, IOMMU_RESV_RESERVED, GFP_KERNEL);
 		if (!new) {
 			ret = -ENOMEM;
 			goto out_err;
@@ -183,7 +183,7 @@ next:
 
 	if (rsv_size && (U64_MAX - prev->start > prev->length)) {
 		new = iommu_alloc_resv_region(rsv_start, rsv_size,
-						0, IOMMU_RESV_RESERVED);
+						0, IOMMU_RESV_RESERVED, GFP_KERNEL);
 		if (!new) {
 			ret = -ENOMEM;
 			goto out_err;
@@ -200,7 +200,7 @@ out_err:
 }
 
 /* Used by iommu drivers to generate reserved regions for qcom,iommu-dma-addr-pool property */
-void qcom_iommu_generate_resv_regions(struct device *dev,
+void qcom_iommu_generate_resv_regions_v1(struct device *dev,
 						      struct list_head *head)
 {
 	struct iommu_resv_region *region;
@@ -213,7 +213,7 @@ void qcom_iommu_generate_resv_regions(struct device *dev,
 		return;
 
 	ret = invert_regions(&dma_regions, &resv_regions);
-	generic_iommu_put_resv_regions(dev, &dma_regions);
+	iommu_put_resv_regions(dev, &dma_regions);
 	if (ret)
 		return;
 
@@ -225,7 +225,7 @@ void qcom_iommu_generate_resv_regions(struct device *dev,
 	list_splice(&resv_regions, head);
 }
 
-EXPORT_SYMBOL(qcom_iommu_generate_resv_regions);
+EXPORT_SYMBOL(qcom_iommu_generate_resv_regions_v1);
 
 static int iommu_iova_open(struct inode *inode, struct file *filp)
 {
diff --git a/safelinux-modules/drivers/kiumd.c b/safelinux-modules/drivers/kiumd.c
index e5aac55..e47c99e 100644
--- a/safelinux-modules/drivers/kiumd.c
+++ b/safelinux-modules/drivers/kiumd.c
@@ -20,7 +20,6 @@
 #include <uapi/misc/kiumd.h>
 #include <linux/iommu.h>
 #include <linux/types.h>
-#include <linux/dma-iommu.h>
 #include <linux/iova.h>
 #include <linux/adreno-smmu-priv.h>
 #include <linux/io-pgtable.h>
@@ -319,7 +318,7 @@ int kiumd_dmabuf_custom_iova_init(struct kiumd_dev *ki_dev, char __user *arg)
 	iovad = &cookie->iovad;
 
 	LIST_HEAD(resrvd);
-	qcom_iommu_generate_resv_regions(vfio_dev->dev, &resrvd);
+	qcom_iommu_generate_resv_regions_v1(vfio_dev->dev, &resrvd);
 	list_for_each_entry(region, &resrvd, list) {
 		lo = iova_pfn(iovad, region->start);
 		hi = iova_pfn(iovad, region->start + region->length - 1);
diff --git a/safelinux-modules/drivers/vfio_iommu_qcom.c b/safelinux-modules/drivers/vfio_iommu_qcom.c
index 4c9be6b..c30f4fa 100644
--- a/safelinux-modules/drivers/vfio_iommu_qcom.c
+++ b/safelinux-modules/drivers/vfio_iommu_qcom.c
@@ -17,7 +17,6 @@
 #include <linux/vfio.h>
 #include <linux/workqueue.h>
 #include <linux/notifier.h>
-#include <linux/dma-iommu.h>
 #include <linux/irqdomain.h>
 #include "vfio.h"
 #define DRIVER_VERSION  "0.1"
diff --git a/safelinux-modules/include/linux/iommu_iova_map.h b/safelinux-modules/include/linux/iommu_iova_map.h
index 6087c1f..7702c15 100644
--- a/safelinux-modules/include/linux/iommu_iova_map.h
+++ b/safelinux-modules/include/linux/iommu_iova_map.h
@@ -12,5 +12,5 @@ struct device_node *qcom_iommu_group_parse_phandle(struct device *dev);
 int qcom_iommu_generate_dma_regions(struct device *dev,
 			    struct list_head *head);
 
-void qcom_iommu_generate_resv_regions(struct device *dev,
+void qcom_iommu_generate_resv_regions_v1(struct device *dev,
 			struct list_head *list);
-- 
2.17.1

