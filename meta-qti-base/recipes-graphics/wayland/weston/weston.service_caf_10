[Unit]
Description=Weston reference Wayland compositor
Conflicts=getty@tty7.service
Requires=dev-dri-card0.device dev-dri-card1.device
After=dbus.service rc.pvr.service dev-dri-card0.device dev-dri-card1.device

[Service]
User=root
PAMName=weston-autologin
Environment="XDG_RUNTIME_DIR=/run/user/0"
ExecStart=weston --tty=2 --idle-time=0 --socket=wayland-0 --log=/tmp/weston.log
ExecStop=/usr/bin/killall -s KILL weston
Type=simple
PIDFile=/run/early/weston.pid
Restart=always

[Install]
WantedBy=multi-user.target
