From 621879401d12eb1592119bf058a877cf65acc6cf Mon Sep 17 00:00:00 2001
From: Bharathraj Nagaraju <snbraj@codeaurora.org>
Date: Tue, 16 May 2017 14:10:49 -0700
Subject: [PATCH] recovery: Add default update package path

Change-Id: Iefb3d0be8f82e7a3af8388aa4afc80d5c917e4d1
Signed-off-by: Bharathraj Nagaraju <snbraj@codeaurora.org>
---
 recovery.cpp | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/recovery.cpp b/recovery.cpp
index 08a5a2b..5b49ac2 100644
--- a/recovery.cpp
+++ b/recovery.cpp
@@ -1005,7 +1005,7 @@ main(int argc, char **argv) {
     get_args(&argc, &argv);
 
     const char *send_intent = NULL;
-    const char *update_package = NULL;
+    char *update_package = NULL;
     bool should_wipe_data = false;
     bool should_wipe_cache = false;
     bool show_text = false;
@@ -1014,6 +1014,9 @@ main(int argc, char **argv) {
     bool just_exit = false;
     bool shutdown_after = false;
 
+    update_package = (char*)malloc(strlen("/data/update.zip")+1);
+    sprintf(update_package, "%s", "/data/update.zip");
+
     int arg;
     while ((arg = getopt_long(argc, argv, "", OPTIONS, NULL)) != -1) {
         switch (arg) {
@@ -1178,6 +1181,8 @@ main(int argc, char **argv) {
 
     // Save logs and clean up before rebooting or shutting down.
     finish_recovery(send_intent);
+    free(update_package);
+
     bool reboot = false;
 
     switch (after) {
