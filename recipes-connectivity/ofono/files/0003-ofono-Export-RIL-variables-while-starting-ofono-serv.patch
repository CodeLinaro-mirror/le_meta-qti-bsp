From 3abbebee26ea90ee949db9adb7170fddea37a6a5 Mon Sep 17 00:00:00 2001
From: Bharathraj Nagaraju <snbraj@codeaurora.org>
Date: Mon, 17 Apr 2017 12:46:20 -0700
Subject: [PATCH 3/3] ofono: Export RIL variables while starting ofono service.

Signed-off-by: Bharathraj Nagaraju <snbraj@codeaurora.org>
---
 src/ofono.service.in | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/ofono.service.in b/src/ofono.service.in
index c24ac28..d9edb2c 100644
--- a/src/ofono.service.in
+++ b/src/ofono.service.in
@@ -5,6 +5,8 @@ After=syslog.target
 [Service]
 Type=dbus
 BusName=org.ofono
+Environment="OFONO_RIL_DEVICE=ril"
+Environment="OFONO_RIL_NUM_SIM_SLOTS=1"
 ExecStart=@prefix@/sbin/ofonod -n
 StandardError=null
 
