# Because mount /dev/pts as devpts filesystem
term_use_generic_ptys(dmesg_t)

# busybox uses sh wrappers instead of links, dmesg is bin_t
corecmd_mmap_bin_files(dmesg_t)

kernel_read_system_state(dmesg_t)
