## <summary>Policy for SELinux policy and userland applications.</summary>

#######################################
## <summary>
##	Execute setprop in the setprop domain.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed to transition.
##  </summary>
## </param>
#
interface(`leprop_typetrans_setprop',`
	gen_require(`
		type setprop_t, setprop_exec_t;
	')

	files_search_usr($1)
	type_transition $1 setprop_exec_t:process setprop_t;
')

#######################################
## <summary>
##	Execute setprop in the setprop domain.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed to transition.
##  </summary>
## </param>
#
interface(`setprop_domtrans',`
	gen_require(`
		type setprop_t, setprop_exec_t;
	')

	corecmd_search_bin($1)
	domtrans_pattern($1, setprop_exec_t, setprop_t)
')

########################################
## <summary>
##  Transition to setprop_t when NNP has been set
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed access.
##  </summary>
## </param>
#
interface(`setprop_nnp_domtrans',`
    gen_require(`
        type setprop_t;
    ')

    setprop_domtrans($1)
    allow $1 setprop_t:process2 nnp_transition;
')

#######################################
## <summary>
##	Automatic domain transition to setprop domain.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed to transition.
##  </summary>
## </param>
#
interface(`leprop_domtrans_setprop',`
	gen_require(`
		type setprop_t, setprop_exec_t;
		role system_r;
	')

	files_search_usr($1)

	domain_type(setprop_t)
	domain_entry_file(setprop_t, setprop_exec_t)

	role system_r types setprop_t;

	domtrans_pattern($1, setprop_exec_t, setprop_t)
')

#######################################
## <summary>
##	Read and write leprop-service socket .
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed to read and write leprop-service socket.
##  </summary>
## </param>
#
interface(`files_rw_leprop_sockets',`
	gen_require(`
		type leprop_socket_t, device_t;
	')

    # /dev/socket directory
    allow $1 device_t:dir rw_dir_perms;
	allow $1 device_t:sock_file manage_sock_file_perms;

	allow $1 leprop_socket_t:sock_file rw_sock_file_perms;
')

#######################################
## <summary>
##	Connect to leprop socket .
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed to connect to leprop socket.
##  </summary>
## </param>
#
interface(`connect_to_leprop_sockets',`
	gen_require(`
		type leprop_t;
	')

	allow $1 leprop_t:unix_stream_socket connectto;
')

#######################################
## <summary>
##	leprop-service search journal runtime directory .
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`leprop_search_journal_dir',`
	gen_require(`
		type syslogd_runtime_t;
	')

	allow $1 syslogd_runtime_t:dir search_dir_perms;
')

#######################################
## <summary>
##	manage leprop etc file .
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`manage_leprop_etc_file',`
	gen_require(`
		type mount_t;
	')
	manage_files_pattern($1, $2, $2)
	allow mount_t $2:file { setattr write link };
')

#######################################
## <summary>
##	Allow initrc_t and adbd_t to read, write leprop socket file.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`rw_leprop_socket',`
	gen_require(`
		type initrc_t, init_t, adbd_t;
	')

	allow initrc_t $1:sock_file rw_sock_file_perms;
	allow adbd_t $1:sock_file rw_sock_file_perms;
	allow init_t $1:sock_file rw_sock_file_perms;
')
