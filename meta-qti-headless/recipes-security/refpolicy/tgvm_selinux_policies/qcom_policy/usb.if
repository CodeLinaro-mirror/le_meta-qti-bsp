## <summary>Policy for SELinux policy and userland applications.</summary>

#######################################
## <summary>
##	Read sysfs state information.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed to transition.
##  </summary>
## </param>
#
interface(`usb_read_sysfs',`
	gen_require(`
		type sysfs_t;
	')

	read_files_pattern($1, sysfs_t, sysfs_t)
	read_lnk_files_pattern($1, sysfs_t, sysfs_t)

	list_dirs_pattern($1, sysfs_t, sysfs_t)
')

#######################################
## <summary>
##	Because of volatile-bind, some var and files run under incorrect contexts.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed to transition.
##  </summary>
## </param>
#
interface(`usb_config_filetrans',`
	gen_require(`
		type var_t, mount_t, configfs_t;
	')
	filetrans_pattern(mount_t, var_t, $1, file, "boot_hsusb_comp")
	allow mount_t $1:file manage_file_perms;
	#todo
	allow mount_t var_t:file manage_file_perms;
	allow mount_t self:capability { dac_read_search };

	# mount process read /var/run, /var/run is symbolic link to /run
	allow mount_t var_t:lnk_file { read };

	# mount process create /var/.usb-work/work directory
	allow mount_t var_t:dir { create };
	allow mount_t var_t:chr_file { unlink };

	# mount /sys/kernel/config
	allow mount_t configfs_t:dir mounton;
')