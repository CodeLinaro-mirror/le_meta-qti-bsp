## <summary>Policy for SELinux policy and userland applications.</summary>

#######################################
## <summary>
##	Execute adbd without domain transition.
##  Need big efforts if domain transition, only could
##  put next phase to develop for too tight timeline.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`init_can_exec_adbd',`
	gen_require(`
		type init_t;
	')

	can_exec(init_t, $1)
')

#######################################
## <summary>
##	Access machine-id.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`access_machine_id',`
	gen_require(`
		type systemd_logind_t, syslogd_t, init_runtime_t, init_t, udev_t;
	')

	# Todo, the filetrans rules seems not appear to have take effect.
	init_runtime_filetrans(syslogd_t, $1, file, "machine-id")
	init_runtime_filetrans(systemd_logind_t, $1, file, "machine-id")
	allow systemd_logind_t init_runtime_t:file rw_file_perms;
	allow syslogd_t init_runtime_t:file rw_file_perms;
	allow udev_t init_runtime_t:file rw_file_perms;
	systemd_read_logind_state($1)

	# before anditd set up
	allow init_t $1:file { mounton rw_file_perms };
')
