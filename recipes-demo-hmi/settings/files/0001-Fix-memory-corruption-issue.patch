diff --git a/binding-wifi/wifi-api.c b/binding-wifi/wifi-api.c
index f6d6d52..3e0c8db 100644
--- a/binding-wifi/wifi-api.c
+++ b/binding-wifi/wifi-api.c
@@ -46,6 +46,23 @@ callback ptr_my_callback;
 GSList *wifi_list = NULL;
 
 /**
+ * \brief Clean wifi_list to avoid memory leak
+ *
+ * */
+void clean_wifi_list() {
+	
+	GSList *list = NULL;
+	
+	for (list = wifi_list; list; list = list->next)
+		g_free(list->data);
+
+	g_slist_free(wifi_list);
+
+	wifi_list = NULL;
+}
+
+
+/**
  * \brief Read out the passkey from the use and pass it to Agent
  *
