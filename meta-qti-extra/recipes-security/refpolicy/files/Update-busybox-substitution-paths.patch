From 3f46c866c49ef663f6fe1c42fded2bafb80f7a07 Mon Sep 17 00:00:00 2001
From: Dennis Cagle <dcagle@codeaurora.org>
Date: Fri, 4 Sep 2020 16:19:22 -0700
Subject: [PATCH] Update busybox substitution paths

Update busybox paths to match with other aliases

Upstream-Status: Pending

Signed-off-by: Dennis Cagle <dcagle@codeaurora.org>
---
 config/file_contexts.subs_dist | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/config/file_contexts.subs_dist b/config/file_contexts.subs_dist
index 04fca3c..c720871 100644
--- a/config/file_contexts.subs_dist
+++ b/config/file_contexts.subs_dist
@@ -44,7 +44,7 @@
 
 # busybox aliases
 # quickly match up the busybox built-in tree to the base filesystem tree
-/usr/lib/busybox/bin /bin
-/usr/lib/busybox/sbin /sbin
+/usr/lib/busybox/bin /usr/bin
+/usr/lib/busybox/sbin /usr/sbin
 /usr/lib/busybox/usr /usr
 
