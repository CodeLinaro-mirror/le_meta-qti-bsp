    type proc_tty_drivers;
    type proc_uptime;
    type pstorefs;
    type radio_data_file;
    type ringtone_file;
    type rollback_data_file;
    type rootfs;
    type su;
    type securityfs;
    type selinuxfs;
    type shell_data_file;
    type shared_relro;
