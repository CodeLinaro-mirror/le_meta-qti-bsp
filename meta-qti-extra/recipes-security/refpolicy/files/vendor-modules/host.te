    type device;
    type securityfs;
    type apexd;
    type vendor_audiod;
    type vendor_hal_ais_qti;
    type hal_graphics_allocator_default;
    class service { status start stop reload enable disable };
    class dbus { acquire_svc send_msg };
    class passwd { passwd chfn chsh rootok crontab };
};

