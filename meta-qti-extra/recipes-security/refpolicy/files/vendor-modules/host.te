policy_module(host,1.0.0)

########################################
#
# Declarations
#

attribute system_file_type;
attribute domain;
attribute file_type;
attribute exec_type;
attribute entry_type;
attribute non_security_file_type;
attribute non_auth_file_type;
attribute initrc_transition_domain;
attribute filesystem_type;

type kernel;
type nsfs_t, filesystem_type;
type device, filesystem_type;

# let kernel domain trans to host_exec_t domain
type host_sbin_t;
type host_bin_t;
type host_file_t, file_type;
type host_exec_t;
domain_type(host_exec_t)
domain_entry_file(host_exec_t, host_sbin_t)
domain_entry_file(host_exec_t, host_bin_t)
domtrans_pattern(kernel,host_sbin_t,host_exec_t)
domtrans_pattern(kernel,host_bin_t,host_exec_t)

type host_device_t, file_type;

require {
    type adsprpcd_file;
    type ais_v4l2_proxy;
    type apex_module_data_file;
    type apex_permission_data_file;
    type apex_rollback_data_file;
