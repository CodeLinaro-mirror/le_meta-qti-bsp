allow host_exec_t host_sbin_t:service { status start stop reload enable disable };
allow host_exec_t hal_graphics_allocator_default:fd use;
allow host_exec_t self:sem { associate create read write destroy unix_read unix_write };
allowxperm host_exec_t self:file ioctl { 0x5401 };
allowxperm host_exec_t self:fifo_file ioctl { 0x5413 };
allowxperm host_exec_t self:unix_stream_socket ioctl { 0x89a0 0x89a2 0x540f };
allowxperm host_exec_t self:unix_dgram_socket ioctl { 0x8933 0x8910};
allowxperm host_exec_t self:udp_socket ioctl { 0x8946 0x8916 0x8914 0x8927 0x8970 0x891d 0x8924 };
allowxperm host_exec_t self:tcp_socket ioctl { 0x89a2 };
allowxperm host_exec_t self:blk_file ioctl { 0x1272 0x1260 0x204 };
allowxperm host_exec_t kernel:file ioctl { 0x5401 };
allowxperm host_exec_t host_device_t:blk_file ioctl { 0x2285 0x1272 0x1260 0x204 0x5331 0x1268 0x125e 0x125f 0x127c };
allowxperm host_exec_t functionfs:file ioctl { 0x6782 };
allowxperm host_exec_t devpts:chr_file ioctl { 0x5404 0x540d 0x4b45 0x5437 0x4b3a 0x5429 0x4b44 0x5456 0x5457 0x5430 0x5431 };
allowxperm host_exec_t rootfs:blk_file ioctl { 0x1272 0x1268 };
allowxperm host_exec_t vendor_file:blk_file ioctl { 0x1272 0x1268 };
allowxperm host_exec_t unlabeled:file ioctl { 0x9409 };


