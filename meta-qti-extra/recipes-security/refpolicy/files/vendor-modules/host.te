    type proc;
    type proc_asound;
    type proc_cmdline;
    type proc_cpuinfo;
    type proc_diskstats;
    type proc_cpuinfo;
    type proc_filesystems;
    type proc_hostname;
    type proc_kmsg;
    type proc_meminfo;
