    type init_tmpfs;
    type kernel;
    type kmsg_debug_device;
    type labeledfs;
    type linkerconfig_file;
    type mqueue;
    type mediacodec;
    type mirror_data_file;
    type mnt_media_rw_file;
    type mnt_user_file;
    type mnt_pass_through_file;
    type nfc_data_file;
