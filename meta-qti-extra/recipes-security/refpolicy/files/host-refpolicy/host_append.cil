(type nsfs_t)
(roletype object_r nsfs_t)
(typeattribute filesystem_type)
(typeattributeset filesystem_type nsfs_t)
(genfscon nsfs / (u object_r nsfs_t ((s0) (s0))))
(class service (start stop status reload enable disable))
(class dbus (acquire_svc send_msg))
