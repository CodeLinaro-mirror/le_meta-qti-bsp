---
 include/wrapper/genhd.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/include/wrapper/genhd.h b/include/wrapper/genhd.h
index 2992cb43..e32c7b68 100644
--- a/include/wrapper/genhd.h
+++ b/include/wrapper/genhd.h
@@ -52,7 +52,7 @@ struct class *wrapper_get_block_class(void)
  *   extern struct class block_class;
  */
 static inline
-struct class *__canary__get_block_class(void)
+const struct class *__canary__get_block_class(void)
 {
 	return &block_class;
 }
