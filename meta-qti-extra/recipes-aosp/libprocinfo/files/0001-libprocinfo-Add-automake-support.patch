From 6d2279e8348557ad626a9d7a7ac77a4e91d2d52b Mon Sep 17 00:00:00 2001
From: Lei wang <quic_leiwan@quicinc.com>
Date: Thu, 8 Aug 2024 08:54:41 +0800
Subject: [PATCH] libprocinfo: Add automake support

Add automake support

Upstream-Status: Inappropriate

Signed-off-by: Lei wang <quic_leiwan@quicinc.com>
---
 Makefile.am  | 39 +++++++++++++++++++++++++++++++++++++++
 configure.ac | 18 ++++++++++++++++++
 2 files changed, 57 insertions(+)
 create mode 100644 Makefile.am
 create mode 100644 configure.ac

diff --git a/Makefile.am b/Makefile.am
new file mode 100644
index 0000000..5cd6714
--- /dev/null
+++ b/Makefile.am
@@ -0,0 +1,39 @@
+AM_CFLAGS = -std=c++17 \
+	    -Wno-error=pointer-to-int-cast \
+	    -I${top_srcdir}/include
+
+AM_CPPFLAGS = $(AM_CFLAGS)
+
+AM_LDFLAGS = -lpthread \
+	     -lbase \
+	     -llog \
+	     -lutils \
+	     -lcutils
+
+ACLOCAL_AMFLAGS = -I m4
+
+libprocinfo_cpp_sources := process.cpp
+libprocinfo_h_sources := include/procinfo/process.h \
+			 include/procinfo/process_map.h
+
+libprocinfo_la_SOURCES = $(libprocinfo_cpp_sources)
+libprocinfo_la_LDFLAGS = $(AM_LDFLAGS)
+libprocinfo_la_CPPFCLAGS = $(AM_CPPFLAGS)
+
+library_includedir = $(includedir)/procinfo
+library_include_HEADERS = $(libprocinfo_h_sources)
+
+lib_LTLIBRARIES = libprocinfo.la
+
+bin_PROGRAMS := libprocinfo_test
+
+libprocinfo_test_cpp_sources := process_test.cpp \
+			       process_map_test.cpp
+
+libprocinfo_test_SOURCES :=$(libprocinfo_test_cpp_sources)
+
+libprocinfo_test_LDADD := libprocinfo.la
+libprocinfo_test_CPPFLAGS := $(AM_CPPFLAGS)
+libprocinfo_test_LDFLAGS = $(AM_LDFLAGS) \
+			   -lgtest_main \
+			   -lgtest
diff --git a/configure.ac b/configure.ac
new file mode 100644
index 0000000..d9f9ebf
--- /dev/null
+++ b/configure.ac
@@ -0,0 +1,18 @@
+AC_PREREQ([2.61])
+
+AC_INIT([libprocinfo],[1.0.0])
+
+AM_INIT_AUTOMAKE([foreign])
+
+AM_MAINTAINER_MODE
+
+AC_CONFIG_HEADERS([config.h])
+AC_CONFIG_MACRO_DIR([m4])
+
+AM_PROG_AS
+AC_PROG_CC
+AC_PROG_CXX
+AC_PROG_INSTALL
+LT_INIT
+
+AC_OUTPUT(Makefile)
-- 
2.25.1

