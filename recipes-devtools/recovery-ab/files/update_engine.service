[Unit]
Description= Update_Engine Service
After=adbd.service data.mount cache.mount
Requires=adbd.service

[Service]
User=root
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/update_engine

[Install]
WantedBy=multi-user.target
