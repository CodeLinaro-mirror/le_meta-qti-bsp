From 0823e49d5826b92741501ab5bb6b6eebb99dd21e Mon Sep 17 00:00:00 2001
From: Raghuvar S <quic_raghuvar@quicinc.com>
Date: Mon, 17 Oct 2022 09:17:38 +0530
Subject: [PATCH] Report taskhash mismatch errors as warnings instead of errors

Change-Id: I67832edd5d651833603ccb3a2010bdaf9ffedf8b
---
 bitbake/lib/bb/siggen.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/bitbake/lib/bb/siggen.py b/bitbake/lib/bb/siggen.py
index 26fa7f05ce..862f730268 100644
--- a/bitbake/lib/bb/siggen.py
+++ b/bitbake/lib/bb/siggen.py
@@ -358,7 +358,7 @@ class SignatureGeneratorBasic(SignatureGenerator):
         if runtime and tid in self.taskhash:
             computed_taskhash = calc_taskhash(data)
             if computed_taskhash != self.taskhash[tid]:
-                bb.error("Taskhash mismatch %s versus %s for %s" % (computed_taskhash, self.taskhash[tid], tid))
+                bb.warn("Taskhash mismatch %s versus %s for %s" % (computed_taskhash, self.taskhash[tid], tid))
                 sigfile = sigfile.replace(self.taskhash[tid], computed_taskhash)
 
         fd, tmpfile = tempfile.mkstemp(dir=os.path.dirname(sigfile), prefix="sigtask.")
-- 
