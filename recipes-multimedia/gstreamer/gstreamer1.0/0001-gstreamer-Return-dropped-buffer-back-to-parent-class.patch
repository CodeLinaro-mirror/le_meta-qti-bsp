From 36addb0a8581573d9b01fe79fa60b2f8dbbdef08 Mon Sep 17 00:00:00 2001
From: Shiju Mathew <shijum@codeaurora.org>
Date: Thu, 27 Oct 2016 19:55:52 -0400
Subject: [PATCH 1/1] gstreamer: Return dropped buffer back to parent class

Change-Id: I006a18c7ed0a64a0c9a77aa2c1e57c6a36bb4560
---
 libs/gst/base/gstbasesink.c | 6 ++++++
 libs/gst/base/gstbasesink.h | 3 +++
 2 files changed, 9 insertions(+)

diff --git a/libs/gst/base/gstbasesink.c b/libs/gst/base/gstbasesink.c
index de295a5..a4e3c00 100644
--- a/libs/gst/base/gstbasesink.c
+++ b/libs/gst/base/gstbasesink.c
@@ -549,6 +549,7 @@ gst_base_sink_class_init (GstBaseSinkClass * klass)
   klass->query = GST_DEBUG_FUNCPTR (gst_base_sink_default_query);
   klass->event = GST_DEBUG_FUNCPTR (gst_base_sink_default_event);
   klass->wait_event = GST_DEBUG_FUNCPTR (gst_base_sink_default_wait_event);
+  klass->return_dropped = NULL;
 
   /* Registering debug symbols for function pointers */
   GST_DEBUG_REGISTER_FUNCPTR (gst_base_sink_fixate);
@@ -3519,6 +3520,11 @@ dropped:
           priv->dropped);
       gst_element_post_message (GST_ELEMENT_CAST (basesink), qos_msg);
     }
+
+    // return dropped buffer back to parent class
+    if (bclass->return_dropped) {
+        bclass->return_dropped(basesink, GST_BUFFER_CAST (sync_buf) );
+    }
     goto done;
   }
 }
diff --git a/libs/gst/base/gstbasesink.h b/libs/gst/base/gstbasesink.h
index d09b7e8..ad4dcdb 100644
--- a/libs/gst/base/gstbasesink.h
+++ b/libs/gst/base/gstbasesink.h
@@ -194,6 +194,9 @@ struct _GstBaseSinkClass {
   /* Render a BufferList */
   GstFlowReturn (*render_list)  (GstBaseSink *sink, GstBufferList *buffer_list);
 
+  /* Return dropped buffer */
+  GstFlowReturn (*return_dropped)(GstBaseSink *sink, GstBuffer *buffer);
+
   /*< private >*/
   gpointer       _gst_reserved[GST_PADDING_LARGE];
 };
-- 
1.9.1

