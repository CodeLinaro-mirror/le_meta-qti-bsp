 static void
+gst_omx_h263_enc_set_property (GObject * object, guint prop_id,
+    const GValue * value, GParamSpec * pspec)
+{
+  GstOMXH263Enc *self = GST_OMX_H263_ENC (object);
+  switch (prop_id) {
+    case PROP_PROFILE:
+      self->profile = g_value_get_uint (value);
+      break;
+    case PROP_LEVEL:
+      self->level = g_value_get_uint (value);
+      break;
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
+      break;
+  }
+}
+static void
+gst_omx_h263_enc_get_property (GObject * object, guint prop_id, GValue * value,
+    GParamSpec * pspec)
+{
+  GstOMXH263Enc *self = GST_OMX_H263_ENC (object);
+  switch (prop_id) {
+    case PROP_PROFILE:
+      g_value_set_uint (value, self->profile);
+      break;
+    case PROP_LEVEL:
+      g_value_set_uint (value, self->level);
+      break;
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
+      break;
+  }
+}
+static void
 gst_omx_h263_enc_init (GstOMXH263Enc * self)
 {
+  self->profile =
+      GST_OMX_H263_ENC_PROFILE_DEFAULT;
+   self->level =
+      GST_OMX_H263_ENC_LEVEL_DEFAULT;
 }
 
