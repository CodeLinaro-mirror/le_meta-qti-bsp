From ceb21334522efcdc1d9333f0cd14d60755964b50 Mon Sep 17 00:00:00 2001
From: Alison Chaiken <alison_chaiken@mentor.com>
Date: Fri, 31 Jul 2015 16:55:00 -0700
Subject: [PATCH 10/23] gstomx: create src pad event handler for buffer release

---
 omx/gstomx.c         | 45 ++++++++++++++++++++++++++++++++++++++++++++-
 omx/gstomx_meta.h    |  4 ++++
 omx/gstomxvideodec.c | 48 +++++++++++++++++++++++++++++++++++++-----------
 omx/gstomxvideodec.h |  5 +++++
 4 files changed, 90 insertions(+), 12 deletions(-)

diff --git a/omx/gstomx.c b/omx/gstomx.c
index ea8a781..a5c5acb 100644
--- a/omx/gstomx.c
+++ b/omx/gstomx.c
@@ -49,6 +49,7 @@
 
 #if defined (USE_OMX_TARGET_VENUS)
 #include "gstomx_meta.h"
+#include <gst/gstevent.h>
 #include <gst/ionbuf/gstionbuf_meta.h>
 #endif
 
@@ -221,7 +222,7 @@ gst_omx_component_flush_messages (GstOMXComponent * comp)
 }
 
 /* NOTE: Call with comp->lock, comp->messages_lock will be used */
-static void
+void
 gst_omx_component_handle_messages (GstOMXComponent * comp)
 {
   GstOMXMessage *msg;
@@ -587,6 +588,47 @@ EventHandler (OMX_HANDLETYPE hComponent, OMX_PTR pAppData, OMX_EVENTTYPE eEvent,
   return OMX_ErrorNone;
 }
 
+#if defined (USE_OMX_TARGET_VENUS)
+gboolean omx_port_out_buf_release_event(GstPad * pad,  GstObject * self, GstEvent * event) {
+  GstOMXBuffer * ionbufp = NULL;
+   GstOMXPort * outport = NULL;
+   const GstStructure * s;
+   gboolean ret = FALSE;
+
+   switch (GST_EVENT_TYPE (event)) {
+   case GST_EVENT_CUSTOM_UPSTREAM:
+     s = gst_event_get_structure (event);
+     if (!GST_IS_STRUCTURE(s)) {
+       GST_ERROR_OBJECT(self, "Event has no associated metadata.");
+       break;
+     }
+     if (gst_structure_has_name((GstStructure *) s, "IonBufRelease")) {
+       ionbufp = (GstOMXBuffer *) ((const GstIonBufFdMeta * ) s)->ionbufp;
+       outport = ((GstOMXVideoDec *) self)->dec_out_port;
+       if (!ionbufp) {
+	 GST_ERROR_OBJECT(self, "No readable GstIonBufMeta data.");
+	 break;
+       }
+       if (!outport)  {
+	 GST_ERROR_OBJECT(self, "Unable to look up decoder port.");
+	 break;
+       }
+       ret = gst_omx_port_release_buffer(outport, ionbufp);
+       if (ret) {
+	 GST_ERROR_OBJECT(self, "Unable to release OMX buffer.");
+	 break;
+       }
+     }
+     GST_DEBUG_OBJECT(self, "CUSTOM_UPSTREAM event has name %s.", gst_structure_get_name((GstStructure *) s));
+     gst_event_unref(event);
+     break;
+   default:
+     ret = gst_pad_event_default (pad,  self, event);
+     break;
+   }
+   return ret;
+ }
+
 static void findMeta (OMX_BUFFERHEADERTYPE *bufhead) {
 
   GstOmxPlatformPrivateInfo *ionBufInfo;
@@ -600,6 +642,7 @@ static void findMeta (OMX_BUFFERHEADERTYPE *bufhead) {
   g_print("buffer at %p has AllocLen %u, FilledLen %u, fd %u, offset %u  and ion_size %u\n", bufhead->pBuffer, (unsigned int) bufhead->nAllocLen, (unsigned int) bufhead->nFilledLen, ionBufInfo->ion_buf_fd, ionBufInfo->ion_buf_offset, (unsigned int) ionBufInfo->ion_buf_size);
   return;
 }
+#endif
 
 static OMX_ERRORTYPE
 EmptyBufferDone (OMX_HANDLETYPE hComponent, OMX_PTR pAppData,
diff --git a/omx/gstomx_meta.h b/omx/gstomx_meta.h
index 89e3ddc..bfbaba6 100644
--- a/omx/gstomx_meta.h
+++ b/omx/gstomx_meta.h
@@ -37,6 +37,10 @@ typedef struct GstOmxPlatformPrivateList {
   GstOmxPlatformPrivateEntry *entryList;
 } GstOmxPlatformPrivateList;
 
+gboolean omx_port_out_buf_release_event(GstPad * pad,  GstObject * self, GstEvent * event);
+
+void gst_omx_component_handle_messages (GstOMXComponent * comp);
+
 G_END_DECLS
 
 #endif /* __GST_OMX_META_H__ */
diff --git a/omx/gstomxvideodec.c b/omx/gstomxvideodec.c
index c1b9b87..b7d75d7 100644
--- a/omx/gstomxvideodec.c
+++ b/omx/gstomxvideodec.c
@@ -1414,6 +1414,9 @@ gst_omx_video_dec_loop (GstOMXVideoDec * self)
   frame = gst_omx_video_find_nearest_frame (buf,
       gst_video_decoder_get_frames (GST_VIDEO_DECODER (self)));
 
+  if (frame)
+    GST_DEBUG_OBJECT (self, "Handling frame timestamp %lu,  duration %lu", (long unsigned) frame->dts, (long unsigned) frame->duration);
+
   /* So we have a timestamped OMX buffer and get, or not, corresponding frame.
    * Assuming decoder output frames in display order, frames preceding this
    * frame could be discarded as they seems useless due to e.g interlaced
@@ -1548,15 +1551,22 @@ gst_omx_video_dec_loop (GstOMXVideoDec * self)
 
   GST_DEBUG_OBJECT (self, "Finished frame: %s", gst_flow_get_name (flow_ret));
 
-#if ((port->port_def.eDir == OMX_DirInput) ||  (!defined (USE_OMX_TARGET_VENUS)))
-    /* wait for gstwaylandsink pad event */
+  g_assert (port->port_def.eDir == OMX_DirOutput);
+
+  /* for Venus output buffer, wait for gstwaylandsink pad event */
+#if (!defined (USE_OMX_TARGET_VENUS))
   if (buf) {
     err = gst_omx_port_release_buffer (port, buf);
     if (err != OMX_ErrorNone)
       goto release_error;
   }
 #else
-  GST_DEBUG_OBJECT(self, "Not releasing output buffer in gst_omx_video_dec_loop");
+  g_mutex_lock (&(port->comp->lock));
+  gst_omx_component_handle_messages (port->comp);
+  buf->used = TRUE;
+  g_mutex_unlock (&(port->comp->lock));
+  GST_DEBUG_OBJECT(self, "Not releasing output buffer %p, nAllocLen %u, nFilledLen %u, nOffset %u",
+		   buf->omx_buf, buf->omx_buf->nAllocLen, buf->omx_buf->nFilledLen, buf->omx_buf->nOffset);
 #endif
 
   self->downstream_flow_ret = flow_ret;
@@ -1924,10 +1934,15 @@ gst_omx_video_dec_set_format (GstVideoDecoder * decoder,
   gboolean is_format_change = FALSE;
   gboolean needs_disable = FALSE;
   OMX_PARAM_PORTDEFINITIONTYPE port_def;
+#if defined(USE_OMX_TARGET_VENUS)
+  GstPad *srcpad;
+#endif
 
   self = GST_OMX_VIDEO_DEC (decoder);
   klass = GST_OMX_VIDEO_DEC_GET_CLASS (decoder);
 
+  srcpad = GST_VIDEO_DECODER_SRC_PAD (self);
+
   GST_DEBUG_OBJECT (self, "Setting new caps %" GST_PTR_FORMAT, state->caps);
 
   gst_omx_port_get_port_definition (self->dec_in_port, &port_def);
@@ -2110,9 +2125,11 @@ gst_omx_video_dec_set_format (GstVideoDecoder * decoder,
 #if defined(USE_OMX_TARGET_VENUS)
     /*
       Decoder will render into dmabufs and does not require output buffer
-      allocation.  Decoder format negotiation is not needed in the case of
-      Venus format.
+      allocation.  Format negotiation is not needed in the case of
+      Venus.  Instead, set new SRC pad event function for the purpose of
+      Wayland buffer-release synchronization.
     */
+  gst_pad_set_event_function (srcpad,  (GstPadEventFunction) GST_DEBUG_FUNCPTR (omx_port_out_buf_release_event));
 #else
     if (!gst_omx_video_dec_negotiate (self))
       GST_LOG_OBJECT (self, "Negotiation failed, will get output format later");
@@ -2422,22 +2439,31 @@ gst_omx_video_dec_handle_frame (GstVideoDecoder * decoder,
       if (GST_CLOCK_TIME_IS_VALID (timestamp))
         buf->omx_buf->nTimeStamp =
             gst_util_uint64_scale (timestamp, OMX_TICKS_PER_SECOND, GST_SECOND);
-      else
+      else {
+	GST_DEBUG_OBJECT(self, "Invalid timestamp  0x%08x\n", (int) buf->omx_buf->nTimeStamp);
         buf->omx_buf->nTimeStamp = 0;
+      }
       buf->omx_buf->nTickCount = 0;
 
       self->started = TRUE;
-#if ((port->port_def.eDir == OMX_DirInput) ||  (!defined (USE_OMX_TARGET_VENUS)))
-    /* wait for gstwaylandsink pad event */
+
+      g_assert (port->port_def.eDir == OMX_DirOutput);
+
+      /* for Venus outbuf wait for gstwaylandsink pad event */
+#if (!defined (USE_OMX_TARGET_VENUS))
       err = gst_omx_port_release_buffer (port, buf);
       gst_buffer_replace (&self->codec_data, NULL);
       if (err != OMX_ErrorNone)
         goto release_error;
 #else
-      GST_DEBUG_OBJECT(self, "Not releasing output buffer in gst_omx_video_dec_loop");
-+#endif
-
+      g_mutex_lock (&(port->comp->lock));
+      gst_omx_component_handle_messages (port->comp);
+      buf->used = TRUE;
+      g_mutex_unlock (&(port->comp->lock));
+      GST_DEBUG_OBJECT(self, "Not releasing output buffer %p, nAllocLen %u, nFilledLen %u, nOffset %u",
+		   buf->omx_buf, buf->omx_buf->nAllocLen, buf->omx_buf->nFilledLen, buf->omx_buf->nOffset);
 #endif
+
       /* Acquire new buffer for the actual frame */
       continue;
     }
diff --git a/omx/gstomxvideodec.h b/omx/gstomxvideodec.h
index 3978865..b77f38b 100644
--- a/omx/gstomxvideodec.h
+++ b/omx/gstomxvideodec.h
@@ -33,6 +33,8 @@
 
 G_BEGIN_DECLS
 
+#define USE_OMX_TARGET_VENUS
+
 #define GST_TYPE_OMX_VIDEO_DEC \
   (gst_omx_video_dec_get_type())
 #define GST_OMX_VIDEO_DEC(obj) \
@@ -83,6 +85,9 @@ struct _GstOMXVideoDec
   GstOMXPort *egl_in_port, *egl_out_port;
   gboolean eglimage;
 #endif
+#ifdef USE_OMX_TARGET_VENUS
+  GstPadEventFunction srcpad_event_func;
+#endif
 };
 
 struct _GstOMXVideoDecClass
