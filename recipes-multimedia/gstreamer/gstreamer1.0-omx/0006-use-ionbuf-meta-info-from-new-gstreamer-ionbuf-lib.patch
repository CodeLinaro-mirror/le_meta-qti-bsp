From d4e9d593ed2596522576ccb72bd4ca4cc6fec40d Mon Sep 17 00:00:00 2001
From: Mathias Fiedler <mathias_fiedler@mentor.com>
Date: Fri, 24 Jul 2015 16:06:55 +0200
Subject: [PATCH 06/23] use ionbuf meta info from new gstreamer-ionbuf lib

---
 configure.ac         |  2 ++
 omx/Makefile.am      |  2 ++
 omx/gstomx.c         |  1 +
 omx/gstomx_meta.h    | 25 -------------------
 omx/gstomxvideodec.c | 68 +++-------------------------------------------------
 5 files changed, 8 insertions(+), 90 deletions(-)

diff --git a/configure.ac b/configure.ac
index e87d240..4606d36 100644
--- a/configure.ac
+++ b/configure.ac
@@ -156,6 +156,8 @@ PKG_CHECK_MODULES([GST_GL], [gstreamer-gl-1.0 >= 1.4.0], [
 ], [GST_GL=no])
 AM_CONDITIONAL(HAVE_GST_GL, test "x$GST_GL" = "xyes")
 
+PKG_CHECK_MODULES(GST_IONBUF, gstreamer-ionbuf-1.0)
+
 dnl Check for documentation xrefs
 GLIB_PREFIX="`$PKG_CONFIG --variable=prefix glib-2.0`"
 GST_PREFIX="`$PKG_CONFIG --variable=prefix gstreamer-$GST_API_VERSION`"
diff --git a/omx/Makefile.am b/omx/Makefile.am
index ad95334..fa48c22 100644
--- a/omx/Makefile.am
+++ b/omx/Makefile.am
@@ -71,6 +71,7 @@ libgstomx_la_CFLAGS = \
 	$(OMX_INCLUDEPATH) \
 	$(GST_GL_CFLAGS) \
 	$(GST_PLUGINS_BASE_CFLAGS) \
+	$(GST_IONBUF_CFLAGS) \
 	$(GST_BASE_CFLAGS) \
 	$(GST_CFLAGS) \
 	$(GMODULE_NO_EXPORT_CFLAGS)
@@ -80,6 +81,7 @@ libgstomx_la_LIBADD = \
 	-lgstaudio-@GST_API_VERSION@ \
 	-lgstpbutils-@GST_API_VERSION@ \
 	-lgstvideo-@GST_API_VERSION@ \
+	$(GST_IONBUF_LIBS) \
 	$(GST_BASE_LIBS) \
 	$(GST_LIBS) \
 	$(GMODULE_NO_EXPORT_LIBS)
diff --git a/omx/gstomx.c b/omx/gstomx.c
index d1b83fe..ea8a781 100644
--- a/omx/gstomx.c
+++ b/omx/gstomx.c
@@ -49,6 +49,7 @@
 
 #if defined (USE_OMX_TARGET_VENUS)
 #include "gstomx_meta.h"
+#include <gst/ionbuf/gstionbuf_meta.h>
 #endif
 
 GST_DEBUG_CATEGORY (gstomx_debug);
diff --git a/omx/gstomx_meta.h b/omx/gstomx_meta.h
index cfcdc7e..89e3ddc 100644
--- a/omx/gstomx_meta.h
+++ b/omx/gstomx_meta.h
@@ -37,31 +37,6 @@ typedef struct GstOmxPlatformPrivateList {
   GstOmxPlatformPrivateEntry *entryList;
 } GstOmxPlatformPrivateList;
 
-struct _GstIonBufFdMeta {
-  GstMeta meta;
-
-  /** ion buffer file descriptor */
-  unsigned int fd;
-  /** Offset from ion buffer base address */
-  unsigned int offset;
-  /** Size of ion buffer */
-  unsigned int size;
-};
-
-typedef struct _GstIonBufFdMeta GstIonBufFdMeta;
-
-GType ionBufFd_meta_api_get_type (void);
-const GstMetaInfo * ionBufFd_meta_get_info (void);
-GstIonBufFdMeta * gst_buffer_add_ionBufFd_meta (GstBuffer *buffer, unsigned int fd, unsigned int offset, unsigned int size);
-
-#define ION_BUF_FD_META_API_TYPE (ionBufFd_meta_api_get_type())
-#define gst_buffer_get_ionfd_meta(b)		\
-  ((GstIonBufFdMeta*)gst_buffer_get_meta((b),ION_BUF_FD_META_API_TYPE))
-#define ION_BUF_FD_META_INFO (ionBufFd_meta_get_info ())
-
-GstIonBufFdMeta * gst_buffer_add_ionBufFd_meta (GstBuffer * buffer,
-					     unsigned int fd, unsigned int offset, unsigned int size);
-
 G_END_DECLS
 
 #endif /* __GST_OMX_META_H__ */
diff --git a/omx/gstomxvideodec.c b/omx/gstomxvideodec.c
index 71f8941..5788228 100644
--- a/omx/gstomxvideodec.c
+++ b/omx/gstomxvideodec.c
@@ -55,6 +55,7 @@
 #include "gstomxvideodec.h"
 #if defined (USE_OMX_TARGET_VENUS)
 #include "gstomx_meta.h"
+#include <gst/ionbuf/gstionbuf_meta.h>
 #endif
 
 GST_DEBUG_CATEGORY_STATIC (gst_omx_video_dec_debug_category);
@@ -88,12 +89,12 @@ static OMX_ERRORTYPE gst_omx_video_dec_allocate_output_buffers (GstOMXVideoDec *
 static OMX_ERRORTYPE gst_omx_video_dec_deallocate_output_buffers (GstOMXVideoDec
     * self);
 
-#if defined (USE_OMX_TARGET_VENUS)
+/*#if defined (USE_OMX_TARGET_VENUS)
 static gboolean ionBufFd_meta_init (GstMeta * meta, gpointer params, GstBuffer * buffer);
 static gboolean ionBufFd_meta_transform (GstBuffer * transbuf, GstMeta * meta,
 			      GstBuffer * buffer, GQuark type, gpointer data);
 static void ionBufFd_meta_free (GstMeta * meta, GstBuffer * buffer);
-#endif
+#endif*/
 
 enum
 {
@@ -424,69 +425,6 @@ gst_omx_video_dec_change_state (GstElement * element, GstStateChange transition)
   return ret;
 }
 
-#if (defined (USE_OMX_TARGET_VENUS))
-GType ionBufFd_meta_api_get_type (void)
-{
-  static volatile GType type;
-  static const gchar *tags[] = { NULL };
-  if (g_once_init_enter (&type)) {
-    GType _type = gst_meta_api_type_register ("ION_BUF_FD_META_API", tags);
-    g_once_init_leave (&type, _type);
-  }
-  return type;
-}
-
-/* initialize HEAD of list of GstMeta items */
-static gboolean ionBufFd_meta_init (GstMeta * meta, gpointer params, GstBuffer * buffer)
-{
-  GstIonBufFdMeta *newmeta = (GstIonBufFdMeta *) meta;
-  newmeta->fd = 0;  /* dangerous: stdin */
-  newmeta->offset = 0;
-  newmeta->size = 0;
-
-  return TRUE;
-}
-
-static void ionBufFd_meta_free (GstMeta * meta, GstBuffer * buffer)
-{
-  return;
-}
-
-static gboolean ionBufFd_meta_transform (GstBuffer * transbuf, GstMeta * meta,
-GstBuffer * buffer, GQuark type, gpointer data)
-{
-  GstIonBufFdMeta * newmeta = (GstIonBufFdMeta *) meta;
-  gst_buffer_add_ionBufFd_meta (transbuf, newmeta->fd, newmeta->offset, newmeta->size);
-  return TRUE;
-}
-
-const GstMetaInfo * ionBufFd_meta_get_info (void)
-{
-  static const GstMetaInfo *meta_info = NULL;
-
-  if (g_once_init_enter (&meta_info)) {
-    const GstMetaInfo *mi = gst_meta_register (ION_BUF_FD_META_API_TYPE,  "ionBufFdMeta", sizeof (GstIonBufFdMeta), ionBufFd_meta_init, ionBufFd_meta_free, ionBufFd_meta_transform);
-      g_once_init_leave (&meta_info, mi);
-  }
-  return meta_info;
-}
-
-GstIonBufFdMeta * gst_buffer_add_ionBufFd_meta (GstBuffer *buffer, unsigned int fd, unsigned int offset, unsigned int size)
-{
-  GstIonBufFdMeta *meta;
-  g_return_val_if_fail (GST_IS_BUFFER (buffer), NULL);
-
-  meta = (GstIonBufFdMeta *) gst_buffer_add_meta (buffer,  ION_BUF_FD_META_INFO, NULL);
-  meta->fd = fd;
-  meta->offset = offset;
-  meta->size = size;
-
-  g_print ("Adding ionBufFd metadata fd %u, offset %u, size %u\n", fd, offset, size);
-
-  return meta;
-}
-#endif
-
 static gboolean
 gst_omx_video_dec_fill_buffer (GstOMXVideoDec * self,
     GstOMXBuffer * inbuf, GstBuffer * outbuf)
-- 
1.9.1

