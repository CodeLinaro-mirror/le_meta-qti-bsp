diff --git a/omx/gstomx.c b/omx/gstomx.c
index 8e70d67..d7b63b8 100644
--- a/omx/gstomx.c
+++ b/omx/gstomx.c
@@ -565,8 +565,14 @@ EventHandler (OMX_HANDLETYPE hComponent, OMX_PTR pAppData, OMX_EVENTTYPE eEvent,
     }
     case OMX_EventPortSettingsChanged:
     {
-      GstOMXMessage *msg = g_slice_new (GstOMXMessage);
-      OMX_U32 index;
+      /* MSM8996: When receiving the OMX port setting change event with index
+       * "OMX_IndexConfigCommonOutputCrop" lets not invoke the omx port
+       * reconfiguration as port disable is not required for msm omx.
+       * FIXME: Update the renderer configuration. */
+      if (nData2 != OMX_IndexConfigCommonOutputCrop)
+      {
+        GstOMXMessage *msg = g_slice_new (GstOMXMessage);
+        OMX_U32 index;
 
       if (!(comp->hacks &
               GST_OMX_HACK_EVENT_PORT_SETTINGS_CHANGED_NDATA_PARAMETER_SWAP)) {
@@ -587,7 +593,8 @@ EventHandler (OMX_HANDLETYPE hComponent, OMX_PTR pAppData, OMX_EVENTTYPE eEvent,
       GST_DEBUG_OBJECT (comp->parent, "%s settings changed (port index: %u)",
           comp->name, (guint) msg->content.port_settings_changed.port);
 
-      gst_omx_component_send_message (comp, msg);
+          gst_omx_component_send_message (comp, msg);
+	  }
       break;
     }
     case OMX_EventBufferFlag:{
@@ -716,6 +723,9 @@ gboolean omx_port_out_buf_release_event(GstPad * pad,  GstObject * self, GstEven
       goto done;
     }
   default:
+    /* MSM_8996: Eliminate the crash by creating structure "s" */
+    s = gst_event_get_structure (event);
+
     /* fall through to default case for non-buffer-release custom upstream event */
     GST_DEBUG_OBJECT(self, "Handling CUSTOM_UPSTREAM event with name %s.", gst_structure_get_name((GstStructure *) s));
     ret = gst_pad_event_default (pad,  self, event);
@@ -739,7 +749,7 @@ static void findMeta (OMX_BUFFERHEADERTYPE *bufhead) {
     return;
   }
 
-  g_print("buffer at %p has AllocLen %u, FilledLen %u, fd %u, offset %u  and ion_size %u\n", bufhead->pBuffer, (unsigned int) bufhead->nAllocLen, (unsigned int) bufhead->nFilledLen, ionBufInfo->ion_buf_fd, ionBufInfo->ion_buf_offset, (unsigned int) ionBufInfo->ion_buf_size);
+  g_print("buffer at %p has AllocLen %u, FilledLen %u, fd %d, offset %u  and ion_size %u\n", bufhead->pBuffer, (unsigned int) bufhead->nAllocLen, (unsigned int) bufhead->nFilledLen, ionBufInfo->ion_buf_fd, ionBufInfo->ion_buf_offset, (unsigned int) ionBufInfo->ion_buf_size);
   return;
 }
 #endif
diff --git a/omx/gstomx.h b/omx/gstomx.h
index 525aff0..fe80065 100644
--- a/omx/gstomx.h
+++ b/omx/gstomx.h
@@ -62,6 +62,7 @@
 
 G_BEGIN_DECLS
 
+#if 0 /* Original Code is commented */
 #define GST_OMX_INIT_STRUCT(st) G_STMT_START { \
   memset ((st), 0, sizeof (*(st))); \
   (st)->nSize = sizeof (*(st)); \
@@ -70,6 +71,18 @@ G_BEGIN_DECLS
   (st)->nVersion.s.nRevision = OMX_VERSION_REVISION; \
   (st)->nVersion.s.nStep = OMX_VERSION_STEP; \
 } G_STMT_END
+#else
+/* Support for MSM 8996:
+ * Version updated to 0x00000101 as required by MSM-OMX;
+ * OMX_Types.h is updated in MSM-OMX: does not contain required Version details
+ * Updated OMX_Types.h doesn't contain version macros like"OMX_VERSION_MAJOR".
+ */
+#define GST_OMX_INIT_STRUCT(st) G_STMT_START { \
+  memset ((st), 0, sizeof (*(st))); \
+  (st)->nSize = sizeof (*(st)); \
+  (st)->nVersion.nVersion = ((OMX_U32)0x00000101);\
+} G_STMT_END
+#endif
 
