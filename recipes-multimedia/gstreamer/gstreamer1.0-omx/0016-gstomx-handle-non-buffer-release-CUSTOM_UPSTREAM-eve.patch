From 6562331059dbfa7eefcdf2a819e90b6cb294ce4d Mon Sep 17 00:00:00 2001
From: Alison Chaiken <alison_chaiken@mentor.com>
Date: Thu, 6 Aug 2015 16:08:57 -0700
Subject: [PATCH 16/23] gstomx: handle non-buffer-release CUSTOM_UPSTREAM
 events

---
 omx/gstomx.c | 37 ++++++++++++++++++++++++++++---------
 1 file changed, 28 insertions(+), 9 deletions(-)

diff --git a/omx/gstomx.c b/omx/gstomx.c
index b048de4..f022e73 100644
--- a/omx/gstomx.c
+++ b/omx/gstomx.c
@@ -590,6 +590,7 @@ EventHandler (OMX_HANDLETYPE hComponent, OMX_PTR pAppData, OMX_EVENTTYPE eEvent,
 }
 
 #if defined (USE_OMX_TARGET_VENUS)
+/* NOTE: Uses comp->lock and comp->messages_lock */
 gboolean omx_port_out_buf_release_event(GstPad * pad,  GstObject * self, GstEvent * event) {
   GstOMXBuffer * ionbufp = g_malloc(sizeof *ionbufp);
   GstOMXPort * outport = g_malloc(sizeof *outport);
@@ -636,8 +637,30 @@ gboolean omx_port_out_buf_release_event(GstPad * pad,  GstObject * self, GstEven
 	break;
       }
 
+      /* NOTE: Uses comp->lock and comp->messages_lock in imitation of gst_omx_port_release_buffer */
+      g_mutex_lock (&comp->lock);
+
+      if ((err = comp->last_error) != OMX_ErrorNone) {
+	GST_ERROR_OBJECT (comp->parent, "Component %s is in error state: %s "
+			  "(0x%08x)", comp->name, gst_omx_error_to_string (err), err);
+	g_queue_push_tail (&outport->pending_buffers, ionbufp);
+	gst_omx_component_send_message (comp, NULL);
+	break;
+      }
+
+      if (outport->flushing || outport->disabled_pending || !outport->port_def.bEnabled) {
+	GST_DEBUG_OBJECT (comp->parent,
+			  "%s port %u is flushing or disabled, not releasing " "buffer",
+			  comp->name, outport->index);
+	g_queue_push_tail (&outport->pending_buffers, ionbufp);
+	gst_omx_component_send_message (comp, NULL);
+	break;
+      }
+
       /* FIXME: What if the settings cookies don't match? */
-      g_assert (buf == buf->omx_buf->pAppPrivate);
+      g_assert (ionbufp == ionbufpbuf->omx_buf->pAppPrivate);
+
+      ionbufp->used = TRUE;
 
       /* Reset all flags, some implementations don't
        * reset them themselves and the flags are not
@@ -649,24 +672,20 @@ gboolean omx_port_out_buf_release_event(GstPad * pad,  GstObject * self, GstEven
       ionbufp->omx_buf->nOffset = 0;
       ionbufp->omx_buf->nFilledLen = 0;
 
-      ionbufp->used = TRUE;
       g_print("omx_port_out_buf_release_event: calling OMX_FillThisBuffer with GstOMXBuffer * %p and OMX_BUFFERHEADERTYPE %p\n", ionbufp, ionbufp->omx_buf);
 
-      /* NOTE: Uses comp->lock and comp->messages_lock in imitation of gst_omx_port_release_buffer */
-      g_mutex_lock (&comp->lock);
+
       err = OMX_FillThisBuffer (comp->handle, ionbufp->omx_buf);
       gst_omx_component_handle_messages (comp);
       g_mutex_unlock (&comp->lock);
 
-      g_print("Recycled output buffer %p to %s port %u: %s \n", ionbufp->omx_buf,  comp->name, outport->index, gst_omx_error_to_string (err));
+      g_print("Recycled output buffer %p to %s port %u: error %s \n", ionbufp->omx_buf,  comp->name, outport->index, gst_omx_error_to_string (err));
       ret = (err == OMX_ErrorNone);
       break;
     }
-    GST_DEBUG_OBJECT(self, "CUSTOM_UPSTREAM event has name %s.", gst_structure_get_name((GstStructure *) s));
-    gst_event_unref(event);
-    break;
+    /* fall through to default case for non-buffer-release custom upstream event */
+    GST_DEBUG_OBJECT(self, "Handling CUSTOM_UPSTREAM event with name %s.", gst_structure_get_name((GstStructure *) s));
   default:
-    /* is putting this inside comp->lock dangerous? */
     ret = gst_pad_event_default (pad,  self, event);
     break;
   }
-- 
1.9.1

