From 7c65b4ab5fe9fb47631093f808c4b64042f10c4e Mon Sep 17 00:00:00 2001
From: Alison Chaiken <alison_chaiken@mentor.com>
Date: Fri, 24 Jul 2015 15:33:36 -0700
Subject: [PATCH 07/23] gstomxvideodec: skip format negotiation and buffer
 allocation

(cherry picked from commit ece37ba49528407338827504c4f2fb383d0d8ed2)
---
 omx/gstomxvideodec.c | 23 ++++++++++++++++++++---
 1 file changed, 20 insertions(+), 3 deletions(-)

diff --git a/omx/gstomxvideodec.c b/omx/gstomxvideodec.c
index 5788228..755fbaf 100644
--- a/omx/gstomxvideodec.c
+++ b/omx/gstomxvideodec.c
@@ -143,12 +143,14 @@ gst_omx_video_dec_class_init (GstOMXVideoDecClass * klass)
       "RGBA") "; "
 #endif
 #if defined (USE_OMX_TARGET_VENUS) && defined (HAVE_GST_GL)
-       GST_VIDEO_CAPS_MAKE_WITH_FEATURES (GST_CAPS_FEATURE_MEMORY_VENUS_IMAGE,
-       "NV12") "; "
-#endif
+      "video/x-raw, format = NV12,"
+      "width = 1920, "
+      "height = 1080, framerate = 25/1";
+#else
       "video/x-raw, "
       "width = " GST_VIDEO_SIZE_RANGE ", "
       "height = " GST_VIDEO_SIZE_RANGE ", " "framerate = " GST_VIDEO_FPS_RANGE;
+#endif
 }
 
 static void
@@ -1820,6 +1822,11 @@ gst_omx_video_dec_negotiate (GstOMXVideoDec * self)
   const gchar *format_str;
 
   templ_caps = gst_pad_get_pad_template_caps (GST_VIDEO_DECODER_SRC_PAD (self));
+#if defined (USE_OMX_TARGET_VENUS)
+  GST_OMX_INIT_STRUCT (&param);
+  param.eColorFormat = OMX_COLOR_FormatYUV420SemiPlanar;
+  param.nPortIndex = self->dec_out_port->index;
+#else
   intersection =
       gst_pad_peer_query_caps (GST_VIDEO_DECODER_SRC_PAD (self), templ_caps);
   gst_caps_unref (templ_caps);
@@ -1884,6 +1891,7 @@ gst_omx_video_dec_negotiate (GstOMXVideoDec * self)
   g_assert (l != NULL);
   g_list_free_full (negotiation_map,
       (GDestroyNotify) gst_omx_video_negotiation_map_free);
+#endif
 
   err =
       gst_omx_component_set_parameter (self->dec,
@@ -2094,8 +2102,16 @@ gst_omx_video_dec_set_format (GstVideoDecoder * decoder,
     if (gst_omx_port_mark_reconfigured (self->dec_in_port) != OMX_ErrorNone)
       return FALSE;
   } else {
+#if defined(USE_OMX_TARGET_VENUS)
+    /*
+      Decoder will render into dmabufs and does not require output buffer
+      allocation.  Decoder format negotiation is not needed in the case of
+      Venus format.
+    */
+#else
     if (!gst_omx_video_dec_negotiate (self))
       GST_LOG_OBJECT (self, "Negotiation failed, will get output format later");
+#endif
 
     if (!(klass->cdata.hacks & GST_OMX_HACK_NO_DISABLE_OUTPORT)) {
       /* Disable output port */
@@ -2125,6 +2141,7 @@ gst_omx_video_dec_set_format (GstVideoDecoder * decoder,
         return FALSE;
     }
 
+
     if (gst_omx_component_get_state (self->dec,
             GST_CLOCK_TIME_NONE) != OMX_StateIdle)
       return FALSE;
-- 
1.9.1

