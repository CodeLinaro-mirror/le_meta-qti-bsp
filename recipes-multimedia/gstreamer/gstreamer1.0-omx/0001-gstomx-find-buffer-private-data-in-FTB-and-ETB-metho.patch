+#ifndef __GST_OMX_META_H__
+#define __GST_OMX_META_H__
+
+G_BEGIN_DECLS
+
+const char *decode_color(OMX_COLOR_FORMATTYPE colorcode);
+
+typedef struct GstOmxPlatformPrivateInfo {
+  /** ion buffer file descriptor */
+  unsigned int ion_buf_fd;
+  /** Offset from ion buffer base address */
+  unsigned int ion_buf_offset;
+  /** Size of ion buffer */
+  unsigned int ion_buf_size;
+} GstOmxPlatformPrivateInfo;
+
+typedef struct GstOmxPlatformPrivateEntry {
+  /** Entry type */
+  int type;
+
+  /** Pointer to platform specific entry */
+  void *entry;
+} GstOmxPlatformPrivateEntry;
+
+typedef struct GstOmxPlatformPrivateList {
+  /** Number of entries */
+  unsigned int nEntries;
+
+  /** Pointer to array of platform specific entries *
+   * Contiguous block of GstOmxPlatformPrivateEntry element
+  */
+  GstOmxPlatformPrivateEntry *entryList;
+} GstOmxPlatformPrivateList;
+
+G_END_DECLS
+
+#endif /* __GST_OMX_META_H__ */
