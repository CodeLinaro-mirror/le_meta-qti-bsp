From 78199aa0bc91962fdadb55f3c5a5224f08606be4 Mon Sep 17 00:00:00 2001
From: Alison Chaiken <alison_chaiken@mentor.com>
Date: Wed, 8 Jul 2015 16:46:47 +0200
Subject: [PATCH] gstomx: find buffer private data in FTB and ETB methods

Add  definitions of struct GstOmxPlatformPrivateInfo member values
and print them for debugging.

Change-Id: Idf7eec60250b7e219cc81875b2c3fe3ed95d1417
Signed-off-by: Bharathraj Nagaraju <snbraj@codeaurora.org>
---
 omx/gstomx.c         | 30 +++++++++++++++++++++++
 omx/gstomx_meta.h    | 67 ++++++++++++++++++++++++++++++++++++++++++++++++++++
 omx/gstomxvideodec.c | 65 ++++++++++++++++++++++++++++++++++++++++++++++----
 3 files changed, 158 insertions(+), 4 deletions(-)
 create mode 100644 omx/gstomx_meta.h

diff --git a/omx/gstomx.c b/omx/gstomx.c
index 9a77e5b..d1b83fe 100644
--- a/omx/gstomx.c
+++ b/omx/gstomx.c
@@ -45,6 +45,12 @@
 #include "gstomxanalogaudiosink.h"
 #include "gstomxhdmiaudiosink.h"
 
+#define USE_OMX_TARGET_VENUS
+
+#if defined (USE_OMX_TARGET_VENUS)
+#include "gstomx_meta.h"
+#endif
+
 GST_DEBUG_CATEGORY (gstomx_debug);
 #define GST_CAT_DEFAULT gstomx_debug
 
@@ -580,6 +586,20 @@ EventHandler (OMX_HANDLETYPE hComponent, OMX_PTR pAppData, OMX_EVENTTYPE eEvent,
   return OMX_ErrorNone;
 }
 
+static void findMeta (OMX_BUFFERHEADERTYPE *bufhead) {
+
+  GstOmxPlatformPrivateInfo *ionBufInfo;
+  if ((GstOmxPlatformPrivateInfo *)((GstOmxPlatformPrivateList *)bufhead->pPlatformPrivate))
+    ionBufInfo = (GstOmxPlatformPrivateInfo *)((GstOmxPlatformPrivateList *)bufhead->pPlatformPrivate)->entryList->entry;
+  else {
+    g_print("buffer at %p has AllocLen %u and FilledLen %u\n", bufhead->pBuffer,(unsigned int) bufhead->nAllocLen, (unsigned int) bufhead->nFilledLen);
+    return;
+  }
+
+  g_print("buffer at %p has AllocLen %u, FilledLen %u, fd %u, offset %u  and ion_size %u\n", bufhead->pBuffer, (unsigned int) bufhead->nAllocLen, (unsigned int) bufhead->nFilledLen, ionBufInfo->ion_buf_fd, ionBufInfo->ion_buf_offset, (unsigned int) ionBufInfo->ion_buf_size);
+  return;
+}
+
 static OMX_ERRORTYPE
 EmptyBufferDone (OMX_HANDLETYPE hComponent, OMX_PTR pAppData,
     OMX_BUFFERHEADERTYPE * pBuffer)
@@ -588,6 +608,11 @@ EmptyBufferDone (OMX_HANDLETYPE hComponent, OMX_PTR pAppData,
   GstOMXComponent *comp;
   GstOMXMessage *msg;
 
+  /* debug dmabuf = ionBuf
+    g_print("In EmptyBufferDone ");
+    findMeta(pBuffer);
+  */
+
   buf = pBuffer->pAppPrivate;
   if (!buf) {
     GST_ERROR ("Have unknown or deallocated buffer %p", pBuffer);
@@ -626,6 +651,11 @@ FillBufferDone (OMX_HANDLETYPE hComponent, OMX_PTR pAppData,
   GstOMXComponent *comp;
   GstOMXMessage *msg;
 
+  /* debug dmabuf = ionBuf
+     g_print("In FillBufferDone ");
+     findMeta(pBuffer);
+  */
+
   buf = pBuffer->pAppPrivate;
   if (!buf) {
     GST_ERROR ("Have unknown or deallocated buffer %p", pBuffer);
