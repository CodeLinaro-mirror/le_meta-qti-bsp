From 2d34dcd02b8a1cc7523f5a470cdff134657dc173 Mon Sep 17 00:00:00 2001
From: Alison Chaiken <alison_chaiken@mentor.com>
Date: Sun, 9 Aug 2015 14:02:09 -0700
Subject: [PATCH 23/26] waylandsink: improve buffer status messages

---
 ext/wayland/gstwaylandsink.c         | 17 +++++++----------
 gst-libs/gst/ionbuf/gstionbuf_meta.c |  2 +-
 gst-libs/gst/ionbuf/gstionbuf_meta.h |  2 --
 3 files changed, 8 insertions(+), 13 deletions(-)

diff --git a/ext/wayland/gstwaylandsink.c b/ext/wayland/gstwaylandsink.c
index 6174ade..bb45c2a 100644
--- a/ext/wayland/gstwaylandsink.c
+++ b/ext/wayland/gstwaylandsink.c
@@ -85,7 +85,7 @@ static GstIonBufFdMeta  *gst_wayland_sink_read_ionBufFd (GstWaylandSink *sink, G
     return NULL;
   }
 
-  g_print ("Read ionBufFd metadata fd %u, offset %u, size %u, (GstOMXBuffer *) %p\n", meta->fd, meta->offset, meta->size, meta->ionbufp);
+  GST_DEBUG_OBJECT(sink, "Read ionBufFd metadata fd %u, offset %u, size %u, (GstOMXBuffer *) %p", meta->fd, meta->offset, meta->size, meta->ionbufp);
 
   return meta;
 }
@@ -787,6 +787,7 @@ struct wlbuffer_info
 {
   GstWaylandSink *sink;
   gpointer *msg_data;
+  unsigned offset;
 };
 
 gboolean check_event_struct (const GstStructure *s, GstIonBufFdMeta * bufinfo)
@@ -796,7 +797,6 @@ gboolean check_event_struct (const GstStructure *s, GstIonBufFdMeta * bufinfo)
   unsigned size, fd, offset;
   const GValue *ionbufval;
 
-  g_print("check_event_struct: read back gst_structure:\n");
   ionbufval = gst_structure_get_value(s, "ion_buf_pointer");
   if (!(G_IS_VALUE (ionbufval)))
     {
@@ -817,7 +817,7 @@ gboolean check_event_struct (const GstStructure *s, GstIonBufFdMeta * bufinfo)
   g_assert(fd == bufinfo->fd);
   g_assert(bufoffset == bufinfo->offset); */
 
-  g_print("\tGstOMXBuffer * ionbufp %p.\n", ionbufp);
+  GST_DEBUG("\tGstOMXBuffer * ionbufp %p.", ionbufp);
 
   return TRUE;
 }
@@ -835,14 +835,10 @@ wl_omx_buffer_release (void *data, struct wl_buffer *wlbuf)
   g_value_init(&bufval, G_TYPE_POINTER);
   g_value_set_pointer(&bufval, bufinfo->msg_data);
 
-  g_print("waylandsink: releasing GstOMXBuffer * %p, wlbuf %u.\n", (gpointer) g_value_get_pointer(&bufval), wl_proxy_get_id((struct wl_proxy *)wlbuf));
+  GST_DEBUG_OBJECT(bufinfo->sink, "waylandsink: releasing buffer at offset %u, wlbuf %u.\n", bufinfo->offset, wl_proxy_get_id((struct wl_proxy *)wlbuf));
 
   gst_structure_set_value(event_struct, "ion_buf_pointer", (const GValue *) &bufval);
-  /*  gst_structure_set (event_struct,
-		     "ion_buf_size", G_TYPE_UINT, bufsize,
-		     "ion_buf_fd",  G_TYPE_UINT, buffd,
-		     "ion_buf_offset", G_TYPE_UINT, bufoffset,  NULL);
-  */
+
   if (!GST_IS_PAD(sinkpad)) {
       GST_ERROR_OBJECT(bufinfo->sink, "No sink pad.");
       return;
@@ -903,8 +899,9 @@ gst_wayland_sink_create_wl_buffer(GstWaylandSink *sink, GstIonBufFdMeta *ionBufF
     struct wlbuffer_info *bufinfo = g_malloc(sizeof *bufinfo);
 
     bufinfo->sink = sink;
-    g_print("waylandsink: storing msg_data for releasing wayland buffer %p that holds GstOMXBuf %p\n", wlbuf, ionBufFdMeta->ionbufp);
+    GST_DEBUG_OBJECT(sink, "waylandsink: storing msg_data for releasing wayland buffer %p with offset %u", wlbuf, ionBufFdMeta->offset);
     bufinfo->msg_data = (gpointer)ionBufFdMeta->ionbufp;
+    bufinfo->offset = ionBufFdMeta->offset;
 
     /* use default queue for this wl_buffer */
     wl_proxy_set_queue((struct wl_proxy*)wlbuf, sink->display->queue);
diff --git a/gst-libs/gst/ionbuf/gstionbuf_meta.c b/gst-libs/gst/ionbuf/gstionbuf_meta.c
index ddd6f93..e4c2a0e 100644
--- a/gst-libs/gst/ionbuf/gstionbuf_meta.c
+++ b/gst-libs/gst/ionbuf/gstionbuf_meta.c
@@ -76,7 +76,7 @@ gst_buffer_add_ionBufFd_meta (GstBuffer * buffer, unsigned int fd,
      decoder's port object. */
   meta->ionbufp = ionbufp;
 
-  g_print ("Adding ionBufFd metadata fd %u, offset %u, size %u, ionbufp %p\n", fd, offset,
+  GST_DEBUG("Adding ionBufFd metadata fd %u, offset %u, size %u, ionbufp %p", fd, offset,
 	   size, ionbufp);
 
   return meta;
diff --git a/gst-libs/gst/ionbuf/gstionbuf_meta.h b/gst-libs/gst/ionbuf/gstionbuf_meta.h
index 07bfb25..b6b8e42 100644
--- a/gst-libs/gst/ionbuf/gstionbuf_meta.h
+++ b/gst-libs/gst/ionbuf/gstionbuf_meta.h
@@ -6,8 +6,6 @@
 
 G_BEGIN_DECLS
 
-#define GST_CAPS_FEATURE_MEMORY_VENUS_IMAGE "memory:Venus"
-
 struct _GstIonBufFdMeta {
   GstMeta meta;
 
-- 
1.9.1

