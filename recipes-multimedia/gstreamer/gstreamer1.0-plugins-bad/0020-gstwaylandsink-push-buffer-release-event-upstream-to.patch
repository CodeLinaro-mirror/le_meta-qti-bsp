From 18da21d97f517bf0bf140ba4c0e7197a8b0778b9 Mon Sep 17 00:00:00 2001
From: Alison Chaiken <alison_chaiken@mentor.com>
Date: Thu, 30 Jul 2015 15:57:42 -0700
Subject: [PATCH 20/26] gstwaylandsink: push buffer release event upstream to
 OMX

---
 ext/wayland/gstwaylandsink.c         | 83 +++++++++++++++++++++++++++++++++---
 gst-libs/gst/ionbuf/gstionbuf_meta.c |  5 +++
 2 files changed, 81 insertions(+), 7 deletions(-)

diff --git a/ext/wayland/gstwaylandsink.c b/ext/wayland/gstwaylandsink.c
index b015361..3b94502 100644
--- a/ext/wayland/gstwaylandsink.c
+++ b/ext/wayland/gstwaylandsink.c
@@ -74,6 +74,8 @@ GST_DEBUG_CATEGORY (gstwayland_debug);
 #include <EGL/eglext.h>
 #include <drm/drm_fourcc.h>
 
+gboolean check_event_struct (const GstStructure *s, GstIonBufFdMeta *buf);
+void wl_omx_buffer_release (void *data, struct wl_buffer *wlbuf);
 
 static GstIonBufFdMeta  *gst_wayland_sink_read_ionBufFd (GstWaylandSink *sink, GstBuffer * buf) {
 
@@ -83,7 +85,7 @@ static GstIonBufFdMeta  *gst_wayland_sink_read_ionBufFd (GstWaylandSink *sink, G
     return NULL;
   }
 
-  GST_DEBUG_OBJECT (sink, "Read ionBufFd metadata fd %u, offset %u, size %u, GstOMXBuffer %p\n", meta->fd, meta->offset, meta->size, meta->ionbufp);
+  g_print ("Read ionBufFd metadata fd %u, offset %u, size %u, (GstOMXBuffer *) %p\n", meta->fd, meta->offset, meta->size, meta->ionbufp);
 
   return meta;
 }
@@ -787,15 +789,81 @@ struct wlbuffer_info
   gpointer *msg_data;
 };
 
-static void
-buffer_release (void *data, struct wl_buffer *wlbuf)
+gboolean check_event_struct (const GstStructure *s, GstIonBufFdMeta * bufinfo)
+{
+  /* gpointer * ionbufp = g_malloc(sizeof *ionbufp); */
+  GstIonBufFdMeta * ionbufp = g_malloc(sizeof * ionbufp);
+  unsigned size, fd, offset;
+  const GValue *ionbufval;
+
+  g_print("check_event_struct: read back gst_structure:\n");
+  ionbufval = gst_structure_get_value(s, "ion_buf_pointer");
+  if (!(G_IS_VALUE (ionbufval)))
+    {
+      GST_ERROR("check_event_struct: No GValue in wayland's event structure.");
+      return FALSE;
+    }
+  ionbufp = (GstIonBufFdMeta *) g_value_get_pointer(ionbufval);
+  if (!ionbufp)  {
+    GST_ERROR("No readable GstIonBufMeta data.");
+    return FALSE;
+  }
+  /*  gst_structure_get_uint(s, "ion_buf_size", &size);
+  gst_structure_get_uint(s, "ion_buf_fd", &fd);
+  gst_structure_get_uint(s, "ion_buf_offset", &offset);
+  g_print("\tGstOMXBuffer * ionbufp %p, ion_buf_size %u, ion_buf_fd %u, ion_buf_offset %u\n.", ionbufp, size, fd, offset);
+  g_assert(ionbufp == bufinfo->ionbufp);
+  g_assert(size == bufinfo->size);
+  g_assert(fd == bufinfo->fd);
+  g_assert(bufoffset == bufinfo->offset); */
+
+  g_print("\tGstOMXBuffer * ionbufp %p.\n", ionbufp);
+
+  return TRUE;
+}
+
+void
+wl_omx_buffer_release (void *data, struct wl_buffer *wlbuf)
 {
-  // struct wlbuffer_info *bufinfo = data;
-  g_print("TODO: release buffer %p\n", wlbuf);
+  struct wlbuffer_info *bufinfo = (struct wlbuffer_info *) data;
+  GstEvent * upstream_release = g_malloc(sizeof *upstream_release);
+  GstPad *sinkpad = GST_BASE_SINK_PAD(bufinfo->sink);
+  GstStructure * event_struct = gst_structure_new_empty("IonBufRelease");
+  gboolean pushed;
+  unsigned bufsize = (unsigned) ((GstIonBufFdMeta  *) (bufinfo->msg_data))->size;
+  unsigned buffd = (unsigned) ((GstIonBufFdMeta  *) (bufinfo->msg_data))->fd;
+  unsigned bufoffset = (unsigned) ((GstIonBufFdMeta  *) (bufinfo->msg_data))->offset;
+
+  GValue bufval = { 0, };
+  g_value_init(&bufval, G_TYPE_POINTER);
+  g_value_set_pointer(&bufval, (gpointer) ((GstIonBufFdMeta *)bufinfo->msg_data)->ionbufp);
+
+  g_print("waylandsink: releasing GstOMXBuffer * %p, msg_data size %u, fd %u, offset %u.\n", (gpointer) g_value_get_pointer(&bufval),  bufsize, buffd, bufoffset);
+
+  gst_structure_set_value(event_struct, "ion_buf_pointer", (const GValue *) &bufval);
+  /*  gst_structure_set (event_struct,
+		     "ion_buf_size", G_TYPE_UINT, bufsize,
+		     "ion_buf_fd",  G_TYPE_UINT, buffd,
+		     "ion_buf_offset", G_TYPE_UINT, bufoffset,  NULL);
+  */
+  if (!GST_IS_PAD(sinkpad)) {
+      GST_ERROR_OBJECT(bufinfo->sink, "No sink pad.");
+      return;
+  }
+
+  check_event_struct((const GstStructure *) event_struct, (GstIonBufFdMeta *) bufinfo->msg_data);
+
+  upstream_release = gst_event_new_custom (GST_EVENT_CUSTOM_UPSTREAM, event_struct);
+  pushed = gst_pad_push_event (sinkpad, upstream_release);
+  g_assert (pushed != FALSE);
+
+  g_value_unset(&bufval);
+
+  return;
 }
 
 static const struct wl_buffer_listener buffer_listener = {
-  buffer_release
+  wl_omx_buffer_release
 };
 
 static struct wl_buffer*
@@ -834,10 +902,11 @@ gst_wayland_sink_create_wl_buffer(GstWaylandSink *sink, GstIonBufFdMeta *ionBufF
   if (! wlbuf) {
     GST_WARNING_OBJECT(sink, "failed to create a wl_buffer from EGLImage %p", eglimg);
   } else {
+    /* where to free this ? */
     struct wlbuffer_info *bufinfo = g_malloc(sizeof *bufinfo);
 
     bufinfo->sink = sink;
-    g_print("TODO: store msg_data for releasing %p\n", wlbuf);
+    g_print("waylandsink: storing msg_data for releasing wayland buffer %p that holds GstOMXBuf %p\n", wlbuf, ionBufFdMeta->ionbufp);
     bufinfo->msg_data = (gpointer)ionBufFdMeta;
 
     /* use default queue for this wl_buffer */
diff --git a/gst-libs/gst/ionbuf/gstionbuf_meta.c b/gst-libs/gst/ionbuf/gstionbuf_meta.c
index 030cdac..ddd6f93 100644
--- a/gst-libs/gst/ionbuf/gstionbuf_meta.c
+++ b/gst-libs/gst/ionbuf/gstionbuf_meta.c
@@ -69,6 +69,11 @@ gst_buffer_add_ionBufFd_meta (GstBuffer * buffer, unsigned int fd,
   meta->fd = fd;
   meta->offset = offset;
   meta->size = size;
+
+  /* ionbufp is a (GstOMXBuffer *) that contains the omx_buf pointer to
+     OMX_BUFFERHEADERTYPE that OMX_FillThisBuffer needs.  ionbufp
+     belongs to gst-omx, while ionbufp->omx_buf belongs to the
+     decoder's port object. */
   meta->ionbufp = ionbufp;
 
   g_print ("Adding ionBufFd metadata fd %u, offset %u, size %u, ionbufp %p\n", fd, offset,
-- 
1.9.1

