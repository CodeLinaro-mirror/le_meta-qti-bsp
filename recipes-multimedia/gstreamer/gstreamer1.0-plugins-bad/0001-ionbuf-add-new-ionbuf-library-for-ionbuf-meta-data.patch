+#ifndef __GSTIONBUF_META_H__
+#define __GSTIONBUF_META_H__
+
+#include <gst/gst.h>
+#include <gst/video/gstvideometa.h>
+
+G_BEGIN_DECLS
+
+#define GST_CAPS_FEATURE_MEMORY_VENUS_IMAGE "memory:Venus"
+
+struct _GstIonBufFdMeta {
+  GstMeta meta;
+
+  /** ion buffer file descriptor */
+  unsigned int fd;
+  /** Offset from ion buffer base address */
+  unsigned int offset;
+  /** Size of ion buffer */
+  unsigned int size;
+};
+
+typedef struct _GstIonBufFdMeta GstIonBufFdMeta;
+
+GType ionBufFd_meta_api_get_type (void);
+const GstMetaInfo * ionBufFd_meta_get_info (void);
+
+#define ION_BUF_FD_META_API_TYPE (ionBufFd_meta_api_get_type())
+#define gst_buffer_get_ionfd_meta(b)		\
+  ((GstIonBufFdMeta*)gst_buffer_get_meta((b),ION_BUF_FD_META_API_TYPE))
+#define ION_BUF_FD_META_INFO (ionBufFd_meta_get_info ())
+
+GstIonBufFdMeta * gst_buffer_add_ionBufFd_meta (GstBuffer * buffer,
+					     unsigned int fd, unsigned int offset, unsigned int size);
+
+G_END_DECLS
+
+#endif /* __GSTIONBUF_META_H__ */
