From 0c3fc41218b999a173ee27fca71038e3cd92727f Mon Sep 17 00:00:00 2001
From: Shiju Mathew <shijum@codeaurora.org>
Date: Mon, 17 Oct 2016 15:24:45 -0400
Subject: [PATCH 1/1] gstreamer-plugins-bad: Fix video playback issue due to
 buffer drop

Change-Id: Iad2e6df794f8f559c025e288f57c899daa0c4cf3
---
 ext/wayland/gstwaylandsink.c | 59 ++++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 57 insertions(+), 2 deletions(-)

diff --git a/ext/wayland/gstwaylandsink.c b/ext/wayland/gstwaylandsink.c
index d029d83..4de78fd 100644
--- a/ext/wayland/gstwaylandsink.c
+++ b/ext/wayland/gstwaylandsink.c
@@ -94,7 +94,10 @@ static gboolean
 gst_wayland_sink_propose_allocation (GstBaseSink * bsink, GstQuery * query);
 static gboolean gst_wayland_sink_render (GstBaseSink * bsink,
     GstBuffer * buffer);
-
+#if defined(USE_OMX_TARGET_VENUS)
+static gboolean
+gst_wayland_sink_return_dropped(GstBaseSink *bsink, GstBuffer *buffer);
+#endif
 /* VideoOverlay interface */
 static void gst_wayland_sink_videooverlay_init (GstVideoOverlayInterface *
     iface);
@@ -152,7 +155,9 @@ gst_wayland_sink_class_init (GstWaylandSinkClass * klass)
   gstbasesink_class->propose_allocation =
       GST_DEBUG_FUNCPTR (gst_wayland_sink_propose_allocation);
   gstbasesink_class->render = GST_DEBUG_FUNCPTR (gst_wayland_sink_render);
-
+#if defined(USE_OMX_TARGET_VENUS)
+  gstbasesink_class->return_dropped = GST_DEBUG_FUNCPTR (gst_wayland_sink_return_dropped);
+#endif
   g_object_class_install_property (gobject_class, PROP_DISPLAY,
       g_param_spec_string ("display", "Wayland Display name", "Wayland "
           "display name to connect to, if not supplied via the GstContext",
@@ -662,6 +667,56 @@ render_last_buffer (GstWaylandSink * sink)
   wl_display_flush (sink->display->display);
 }
 
+#if defined(USE_OMX_TARGET_VENUS)
+static GstFlowReturn
+gst_wayland_sink_return_dropped(GstBaseSink *bsink, GstBuffer *buffer)
+{
+  GstWaylandSink *sink = GST_WAYLAND_SINK (bsink);
+  GstFlowReturn ret = GST_FLOW_OK;
+  GstPad *sinkpad = GST_BASE_SINK_PAD(sink);
+  GstEvent * upstream_release = g_malloc(sizeof *upstream_release);
+  GstStructure * event_struct = gst_structure_new_empty("IonBufRelease");
+  GValue bufval = { 0, };
+  GstIonBufFdMeta *ionBufFdMeta;
+
+  ionBufFdMeta = gst_wayland_sink_read_ionBufFd(sink, buffer);
+
+  if (!ionBufFdMeta) {
+        GST_ERROR_OBJECT(sink, "Unable to read ionBufFd from buffer %p.", buffer);
+        ret = GST_FLOW_ERROR;
+        goto done;
+  }
+
+  g_value_init(&bufval, G_TYPE_POINTER);
+  g_value_set_pointer(&bufval, ionBufFdMeta->ionbufp);
+
+  GST_DEBUG_OBJECT(sink, "waylandsink: releasing buffer at offset %u, size = %u, fd = %d\n", ionBufFdMeta->offset, ionBufFdMeta->size, ionBufFdMeta->fd);
+
+  gst_structure_set_value(event_struct, "ion_buf_pointer", (const GValue *) &bufval);
+
+  if (!GST_IS_PAD(sinkpad)) {
+      GST_ERROR_OBJECT(sink, "No sink pad.");
+      return;
+  }
+
+  ret = check_event_struct((const GstStructure *) event_struct, ionBufFdMeta->ionbufp);
+
+  if (ret) {
+    GST_DEBUG_OBJECT(sink,"%s:%s:%d push GST_EVENT_CUSTOM_UPSTREAM\n",__FILE__,__func__,__LINE__);
+    upstream_release = gst_event_new_custom (GST_EVENT_CUSTOM_UPSTREAM, event_struct);
+    ret = gst_pad_push_event (sinkpad, upstream_release);
+  } else {
+    GST_ERROR("Failed to push wl_omx_buffer_release() event for dropped buffer" );
+    gst_event_unref(upstream_release);
+    gst_structure_free(event_struct);
+    g_value_unset(&bufval);
+  }
+
+done:
+   return ret;
+}
+#endif
+
 static GstFlowReturn
 gst_wayland_sink_render (GstBaseSink * bsink, GstBuffer * buffer)
 {
-- 
