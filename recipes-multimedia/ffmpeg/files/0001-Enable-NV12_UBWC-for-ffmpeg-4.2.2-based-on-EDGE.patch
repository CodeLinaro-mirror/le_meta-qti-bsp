From 3f0471d7dc75b887929616c97a0e43be8a96efba Mon Sep 17 00:00:00 2001
From: Zhenlin Lian <lianzhenlin@codeaurora.org>
Date: Fri, 3 Apr 2020 14:34:01 +0800
Subject: [PATCH] Enable NV12_UBWC for ffmpeg 4.2.2 based on EDGE

---
 fftools/ffmpeg.c          |  3 +++
 libavcodec/raw.c          |  1 +
 libavcodec/rawenc.c       | 11 ++++++++++-
 libavcodec/v4l2_buffers.c |  4 ++++
 libavcodec/v4l2_context.c |  7 +++++++
 libavcodec/v4l2_fmt.c     |  3 +++
 libavformat/riff.c        |  1 +
 libavutil/pixdesc.c       | 12 ++++++++++++
 libavutil/pixfmt.h        |  3 ++-
 9 files changed, 43 insertions(+), 2 deletions(-)

diff --git a/fftools/ffmpeg.c b/fftools/ffmpeg.c
index 01f0410..9d4e877 100644
--- a/fftools/ffmpeg.c
+++ b/fftools/ffmpeg.c
@@ -2894,6 +2894,7 @@ static int init_input_stream(int ist_index, char *error, int error_len)
 {
     int ret;
     InputStream *ist = input_streams[ist_index];
+    OutputStream *ost = output_streams[ist_index];
 
     if (ist->decoding_needed) {
         AVCodec *codec = ist->dec;
@@ -2907,6 +2908,8 @@ static int init_input_stream(int ist_index, char *error, int error_len)
         ist->dec_ctx->get_format            = get_format;
         ist->dec_ctx->get_buffer2           = get_buffer;
         ist->dec_ctx->thread_safe_callbacks = 1;
+        if (ost->enc->id == AV_CODEC_ID_RAWVIDEO)
+            ist->dec_ctx->pix_fmt           = ost->enc_ctx->pix_fmt;
 
         av_opt_set_int(ist->dec_ctx, "refcounted_frames", 1, 0);
         if (ist->dec_ctx->codec_id == AV_CODEC_ID_DVB_SUBTITLE &&
diff --git a/libavcodec/raw.c b/libavcodec/raw.c
index b6fb91c..7e5494d 100644
--- a/libavcodec/raw.c
+++ b/libavcodec/raw.c
@@ -71,6 +71,7 @@ const PixelFormatTag ff_raw_pix_fmt_tags[] = {
     { AV_PIX_FMT_UYYVYY411, MKTAG('Y', '4', '1', '1') },
     { AV_PIX_FMT_GRAY8,   MKTAG('G', 'R', 'E', 'Y') },
     { AV_PIX_FMT_NV12,    MKTAG('N', 'V', '1', '2') },
+    { AV_PIX_FMT_NV12_UBWC, MKTAG('Q', '1', '2', '8') },
     { AV_PIX_FMT_NV21,    MKTAG('N', 'V', '2', '1') },
 
     /* nut */
diff --git a/libavcodec/rawenc.c b/libavcodec/rawenc.c
index d181b74..b15fffa 100644
--- a/libavcodec/rawenc.c
+++ b/libavcodec/rawenc.c
@@ -58,13 +58,22 @@ static int raw_encode(AVCodecContext *avctx, AVPacket *pkt,
     if (ret < 0)
         return ret;
 
+    if (frame->format == AV_PIX_FMT_NV12_UBWC)
+        ret = frame->linesize[1];
+
     if ((ret = ff_alloc_packet2(avctx, pkt, ret, ret)) < 0)
         return ret;
-    if ((ret = av_image_copy_to_buffer(pkt->data, pkt->size,
+
+    if (frame->format == AV_PIX_FMT_NV12_UBWC) {
+        memcpy(pkt->data, frame->data[0], frame->linesize[1]);
+        pkt->size = frame->linesize[1];
+    } else {
+        if ((ret = av_image_copy_to_buffer(pkt->data, pkt->size,
                                        (const uint8_t **)frame->data, frame->linesize,
                                        frame->format,
                                        frame->width, frame->height, 1)) < 0)
         return ret;
+    }
 
     if(avctx->codec_tag == AV_RL32("yuv2") && ret > 0 &&
        frame->format   == AV_PIX_FMT_YUYV422) {
diff --git a/libavcodec/v4l2_buffers.c b/libavcodec/v4l2_buffers.c
index 504ff80..bfc665f 100644
--- a/libavcodec/v4l2_buffers.c
+++ b/libavcodec/v4l2_buffers.c
@@ -381,6 +381,10 @@ int ff_v4l2_buffer_buf_to_avframe(AVFrame *frame, V4L2Buffer *avbuf)
             VENUS_Y_SCANLINES(MapColorFormat(avbuf->context->format.fmt.pix_mp.pixelformat),
             avbuf->context->format.fmt.pix_mp.height);
         break;
+    case AV_PIX_FMT_NV12_UBWC:
+        frame->linesize[1] = avbuf->buf.m.planes[0].bytesused;
+        frame->data[1] = (uint8_t*)avbuf->ion.mapfd;
+        break;
     default:
         break;
     }
diff --git a/libavcodec/v4l2_context.c b/libavcodec/v4l2_context.c
index 20f7e93..b7b86c3 100644
--- a/libavcodec/v4l2_context.c
+++ b/libavcodec/v4l2_context.c
@@ -469,6 +469,8 @@ static int v4l2_get_raw_format(V4L2Context* ctx, enum AVPixelFormat *p)
         ret = v4l2_try_raw_format(ctx, pixfmt);
         //if (!ret)
         //    return 0; delete by xukui
+    } else {
+          ctx->av_pix_fmt = AV_PIX_FMT_NV12;
     }
 
     for (;;) {
@@ -483,6 +485,11 @@ static int v4l2_get_raw_format(V4L2Context* ctx, enum AVPixelFormat *p)
             continue;
         }
 
+        if (pixfmt != ctx->av_pix_fmt) {
+            fdesc.index++;
+            continue;
+        }
+
         *p = pixfmt;
 
         return 0;
diff --git a/libavcodec/v4l2_fmt.c b/libavcodec/v4l2_fmt.c
index 6df47e3..7f4bb95 100644
--- a/libavcodec/v4l2_fmt.c
+++ b/libavcodec/v4l2_fmt.c
@@ -107,6 +107,9 @@ static const struct fmt_conversion {
 #ifdef V4L2_PIX_FMT_VC1_ANNEX_G
     { AV_FMT(NONE),        AV_CODEC(VC1),         V4L2_FMT(VC1_ANNEX_G) },
 #endif
+#ifdef V4L2_PIX_FMT_NV12_UBWC
+    { AV_FMT(NV12_UBWC), AV_CODEC(RAWVIDEO), V4L2_FMT(NV12_UBWC) },
+#endif
 };
 
 uint32_t ff_v4l2_format_avcodec_to_v4l2(enum AVCodecID avcodec)
diff --git a/libavformat/riff.c b/libavformat/riff.c
index 52b0bf8..9331c52 100644
--- a/libavformat/riff.c
+++ b/libavformat/riff.c
@@ -241,6 +241,7 @@ const AVCodecTag ff_codec_bmp_tags[] = {
     { AV_CODEC_ID_RAWVIDEO,     MKTAG('V', 'D', 'T', 'Z') },
     { AV_CODEC_ID_RAWVIDEO,     MKTAG('Y', '4', '1', '1') },
     { AV_CODEC_ID_RAWVIDEO,     MKTAG('N', 'V', '1', '2') },
+    { AV_CODEC_ID_RAWVIDEO,     MKTAG('Q', '1', '2', '8') },
     { AV_CODEC_ID_RAWVIDEO,     MKTAG('N', 'V', '2', '1') },
     { AV_CODEC_ID_RAWVIDEO,     MKTAG('Y', '4', '1', 'B') },
     { AV_CODEC_ID_RAWVIDEO,     MKTAG('Y', '4', '2', 'B') },
diff --git a/libavutil/pixdesc.c b/libavutil/pixdesc.c
index b97b066..7bae560 100644
--- a/libavutil/pixdesc.c
+++ b/libavutil/pixdesc.c
@@ -2344,6 +2344,18 @@ static const AVPixFmtDescriptor av_pix_fmt_descriptors[AV_PIX_FMT_NB] = {
         },
         .flags = AV_PIX_FMT_FLAG_PLANAR,
     },
+    [AV_PIX_FMT_NV12_UBWC] = {
+        .name = "nv12_ubwc",
+        .nb_components = 3,
+        .log2_chroma_w = 1,
+        .log2_chroma_h = 1,
+        .comp = {
+            { 0, 1, 0, 0, 8, 0, 7, 1 },        /* Y */
+            { 1, 2, 0, 0, 8, 1, 7, 1 },        /* U */
+            { 1, 2, 1, 0, 8, 1, 7, 2 },        /* V */
+        },
+        .flags = AV_PIX_FMT_FLAG_PLANAR,
+    },
 };
 #if FF_API_PLUS1_MINUS1
 FF_ENABLE_DEPRECATION_WARNINGS
diff --git a/libavutil/pixfmt.h b/libavutil/pixfmt.h
index 8b54c94..b7d6cfb 100644
--- a/libavutil/pixfmt.h
+++ b/libavutil/pixfmt.h
@@ -348,7 +348,8 @@ enum AVPixelFormat {
     AV_PIX_FMT_NV24,      ///< planar YUV 4:4:4, 24bpp, 1 plane for Y and 1 plane for the UV components, which are interleaved (first byte U and the following byte V)
     AV_PIX_FMT_NV42,      ///< as above, but U and V bytes are swapped
 
-    AV_PIX_FMT_NB         ///< number of pixel formats, DO NOT USE THIS if you want to link with shared libav* because the number of formats might differ between versions
+    AV_PIX_FMT_NV12_UBWC,  ///< planar UBWC YUV
+    AV_PIX_FMT_NB        ///< number of pixel formats, DO NOT USE THIS if you want to link with shared libav* because the number of formats might differ between versions
 };
 
 #if AV_HAVE_BIGENDIAN
-- 
2.7.4

