From f8e551fffdb72e656c964a6f3862c5d3e2008902 Mon Sep 17 00:00:00 2001
From: Laisheng Hu <laisheng@codeaurora.org>
Date: Wed, 13 Dec 2017 14:06:58 +0800
Subject: [PATCH] vidc: avoid portsettingchange forearly ethcam

Change-Id: I321006e9374b738dca5c5408fe13963dce4d6553
Signed-off-by: Laisheng Hu <laisheng@codeaurora.org>
---
 mm-video-v4l2/vidc/vdec/src/omx_vdec_v4l2.cpp | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/mm-video-v4l2/vidc/vdec/src/omx_vdec_v4l2.cpp b/mm-video-v4l2/vidc/vdec/src/omx_vdec_v4l2.cpp
index 223f0f8..04781bc 100644
--- a/mm-video-v4l2/vidc/vdec/src/omx_vdec_v4l2.cpp
+++ b/mm-video-v4l2/vidc/vdec/src/omx_vdec_v4l2.cpp
@@ -9476,8 +9476,7 @@ int omx_vdec::async_message_process (void *context, void* message)
                    /* filled length will be changed if resolution changed */
                    /* Crop parameters can be changed even without resolution change */
                    if (omxhdr->nFilledLen
-                       && ((omx->prev_n_filled_len != omxhdr->nFilledLen)
-                       || (omx->drv_ctx.frame_size.left != vdec_msg->msgdata.output_frame.framesize.left)
+                       && (((omx->prev_n_filled_len != omxhdr->nFilledLen) && (omx->prev_n_filled_len  > 0)) || (omx->drv_ctx.frame_size.left != vdec_msg->msgdata.output_frame.framesize.left)
                        || (omx->drv_ctx.frame_size.top != vdec_msg->msgdata.output_frame.framesize.top)
                        || (omx->drv_ctx.frame_size.right != vdec_msg->msgdata.output_frame.framesize.right)
                        || (omx->drv_ctx.frame_size.bottom != vdec_msg->msgdata.output_frame.framesize.bottom)
@@ -13108,12 +13107,13 @@ OMX_ERRORTYPE omx_vdec::allocate_color_convert_buf::set_buffer_req(
                 buffer_size, expectedSize);
         return OMX_ErrorBadParameter;
     }
+#if 0
     if (actual_count < omx->drv_ctx.op_buf.actualcount) {
         DEBUG_PRINT_ERROR("OP Requirements: Client count(%u) insufficient v/s requested(%u)",
                 actual_count, omx->drv_ctx.op_buf.actualcount);
         return OMX_ErrorBadParameter;
     }
-
+#endif
     bool reqs_updated = false;
     if (enabled) {
         // disallow changing buffer size/count while we have active allocated buffers
@@ -13131,8 +13131,8 @@ OMX_ERRORTYPE omx_vdec::allocate_color_convert_buf::set_buffer_req(
         }
     }
 
-    if (actual_count > omx->drv_ctx.op_buf.actualcount) {
-        omx->drv_ctx.op_buf.actualcount = actual_count;
+    if (actual_count != omx->drv_ctx.op_buf.actualcount) {
+        omx->drv_ctx.op_buf.mincount = omx->drv_ctx.op_buf.actualcount = actual_count;
         reqs_updated = true;
     }
 
-- 
2.9.2.windows.1

