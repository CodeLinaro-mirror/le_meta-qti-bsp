+/*************************************************************************/
+/*                  STATIC STRUCTURE DECLARATIONS                        */
+/*************************************************************************/
+static agl_audio_sink_prop_node *sink_prop_list_head = NULL;
+static agl_audio_source_prop_node *source_prop_list_head = NULL;
+static agl_snd_card_utils_hooks pa_hooks;
