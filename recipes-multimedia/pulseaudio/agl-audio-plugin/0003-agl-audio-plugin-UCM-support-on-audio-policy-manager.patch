+static int agl_snd_utils_find_node_type (struct userdata *u, pa_proplist *pl, agl_node_type *ret_node_type)
+{
+	const char *role;
+	int err = 0;
+
+	pa_assert (u);
+	pa_assert (pl);
+	pa_assert (ret_node_type);
+
+	role = pa_proplist_gets (pl, PA_PROP_MEDIA_ROLE);
+
+	pa_log_info("Media Role from property is %s", role);
+
+	if (!role)
+		*ret_node_type = agl_node_type_unknown;
+	else if (!strncmp (role, "abstract", strlen("abstract")))
+		err = -PA_ERR_INVALID;
+	else if (!strncmp (role, "radio", strlen("radio")))
+		*ret_node_type = agl_radio;
+	else if (!strncmp (role, "music", strlen("music")))
+		*ret_node_type = agl_player;
+	else if (!strncmp (role, "navi", strlen("navi")))
+		*ret_node_type = agl_navigator;
+	else if (!strncmp (role, "game", strlen("game")))
+		*ret_node_type = agl_game;
+	else if (!strncmp (role, "browser", strlen("browser")))
+		*ret_node_type = agl_browser;
+	else if (!strncmp (role, "camera", strlen("camera")))
+		*ret_node_type = agl_camera;
+	else if (!strncmp (role, "phone", strlen("phone")))
+		*ret_node_type = agl_phone;
+	else if (!strncmp (role, "alert", strlen("alert")))
+		*ret_node_type = agl_alert;
+	else if (!strncmp (role, "event", strlen("event")))
+		*ret_node_type = agl_event;
+	else if (!strncmp (role, "system", strlen("system")))
+		*ret_node_type = agl_system;
+	else
+		*ret_node_type = agl_player;
+
+	return err;
+}
+
+static pa_hook_result_t agl_snd_card_utils_sink_input_put_cb (void *hook_data,
+                                  void *call_data,
+                                  void *slot_data)
+{
+	const char *ucm_verb;
+	agl_node_type node_type;
+	agl_router *router;
+	agl_rtgroup *rtg;
+	int err = 0;
+
+	pa_log_info("Callback received for sink_input_put");
+	pa_sink_input *data = (pa_sink_input *)call_data;
+	struct userdata *u = (struct userdata *)slot_data;
+	pa_assert_se (router = u->router);
+
+	/* Using media role property to find node type to find sink name */
+	err = agl_snd_utils_find_node_type(u, data->proplist, &node_type);
+	if (err < 0)
+	{
+		pa_log_info("Invalid node type.");
+		goto sink_input_put_end;
+	}
+
+	pa_log_info("Node type is %s", agl_node_type_str(node_type));
+
+	if (node_type == agl_node_type_unknown){
+		ucm_verb = DEFAULT_SINK_USECASE;
+	}
+	else{
+		/* Find sink name using routing group name */
+		rtg = pa_hashmap_get (router->rtgroups.input, agl_node_type_str(node_type));
+		if (!rtg){
+			pa_log_info("Unable to find routing group from media role");
+			goto sink_input_put_end;
+		}
+
+		ucm_verb = agl_snd_card_utils_get_ucm_verb_from_sink_name(rtg->node->paname);
+
+		if (!ucm_verb){
+			pa_log_info("Unable to find UCM verb with sink name %s", rtg->node->paname);
+			goto sink_input_put_end;
+		}
+	}
+
+	/* If the current use-case verb is used but not active, the routing path should already */
+	/* be active. The active boolean is used to help deinitialize routing when use-cases are */
+	/* running concurrently. */
+	if (!current_use_case_verb_active && (!strncmp(current_use_case_verb, ucm_verb, strlen(ucm_verb)))){
+		current_use_case_verb_active = true;
+	}
+	else{
+		/* If there are no use-cases running, simply enable a verb */
+		if (!strncmp(current_use_case_verb, SND_USE_CASE_VERB_INACTIVE, strlen(SND_USE_CASE_VERB_INACTIVE))){
+			err = snd_use_case_set(u->ucm_mgr, "_verb", ucm_verb);
+			if (err < 0){
+				pa_log_info("UCM Verb %s failed to set and returned err=%d",
+					ucm_verb, err);
+				goto sink_input_put_end;
+			}
+			strncpy(current_use_case_verb, ucm_verb, strlen(ucm_verb));
+			current_use_case_verb_active = true;
+			pa_log_info("UCM Verb %s set", ucm_verb);
+		}
+
+		/* If the verb is already being used */
+		else if (!strncmp(current_use_case_verb, ucm_verb, strlen(ucm_verb))){
+			pa_log_info("Current verb %s already active", ucm_verb);
+		}
+
+		/* If there is already a verb active and another use-case needs mixer controls */
+		else{
+			err = snd_use_case_set(u->ucm_mgr, "_enamod", ucm_verb);
+			if (err < 0){
+				pa_log_info("UCM Modifier %s failed to set and returned err=%d",
+					ucm_verb, err);
+				goto sink_input_put_end;
+			}
+			pa_log_info("UCM Modifier %s set", ucm_verb);
+		}
+	}
+
+sink_input_put_end:
+	return PA_HOOK_OK;
+}
+
+static pa_hook_result_t agl_snd_card_utils_sink_input_unlink_cb (void *hook_data,
+                                  void *call_data,
+                                  void *slot_data)
+{
+	const char *ucm_verb;
+	const char **ucm_mod_list;
+	agl_node_type node_type;
+	agl_router *router;
+	agl_rtgroup *rtg;
+	int ucm_mod_list_size, err = 0;
+
+	pa_log_info("Callback received for sink_input_unlink");
+	pa_sink_input *data = (pa_sink_input *)call_data;
+	struct userdata *u = (struct userdata *)slot_data;
+	pa_assert_se (router = u->router);
+
+	if (!strncmp(current_use_case_verb,
+		SND_USE_CASE_VERB_INACTIVE, strlen(SND_USE_CASE_VERB_INACTIVE))){
+		pa_log_info("Use Case verb already Inactive");
+		goto sink_input_unlink_end;
+	}
+
+	/* Using media role property to find node type to find sink name */
+	err = agl_snd_utils_find_node_type(u, data->proplist, &node_type);
+	if (err < 0)
+	{
+		pa_log_info("Invalid node type.");
+		goto sink_input_unlink_end;
+	}
+
+	pa_log_info("Node type is %s", agl_node_type_str(node_type));
+
+	if (node_type == agl_node_type_unknown){
+		ucm_verb = DEFAULT_SINK_USECASE;
+	}
+	else{
+		/* Find sink name using routing group name */
+		rtg = pa_hashmap_get (router->rtgroups.input, agl_node_type_str(node_type));
+		if (!rtg){
+			pa_log_info("Unable to find routing group from media role");
+			goto sink_input_unlink_end;
+		}
+
+		ucm_verb = agl_snd_card_utils_get_ucm_verb_from_sink_name(rtg->node->paname);
+
+		if (!ucm_verb){
+			pa_log_info("Unable to find UCM verb with sink name %s", rtg->node->paname);
+			goto sink_input_unlink_end;
+		}
+	}
+
+	ucm_mod_list_size = snd_use_case_get_list(u->ucm_mgr,
+		"_enamods", &ucm_mod_list);
+	pa_log_info("UCM Modifier List size is %d", ucm_mod_list_size);
+
+	err = snd_use_case_free_list(ucm_mod_list, ucm_mod_list_size);
+	if (err < 0){
+		pa_log_info("Failed to free UCM Modifer list");
+	}
+
+	/* If the current use-case verb is being disabled but a modifier is still running, */
+	/* queue the verb disable on the next unlink callback */
+	if ((ucm_mod_list_size > 0) &&
+		!strncmp(current_use_case_verb, ucm_verb, strlen(ucm_verb))){
+		current_use_case_verb_active = false;
+	}
+
+	/* If there are modifiers running and the current use-case is not being disabled, */
+	/* try and disable the modifier. */
+	else if (ucm_mod_list_size > 0){
+		err = snd_use_case_set(u->ucm_mgr, "_dismod", ucm_verb);
+		if (err < 0){
+			pa_log_info("UCM Modifier %s failed to set and returned err=%d",
+				ucm_verb, err);
+			goto sink_input_unlink_end;
+		}
+
+		/* If this is the last modifier and current verb is not active, make current verb inactive */
+		if ((ucm_mod_list_size == 1) && !current_use_case_verb_active){
+			err = snd_use_case_set(u->ucm_mgr, "_verb", SND_USE_CASE_VERB_INACTIVE);
+			if (err < 0){
+				pa_log_info("UCM Verb %s failed to set and returned err=%d",
+					SND_USE_CASE_VERB_INACTIVE, err);
+				goto sink_input_unlink_end;
+			}
+
+			strncpy(current_use_case_verb, SND_USE_CASE_VERB_INACTIVE, strlen(SND_USE_CASE_VERB_INACTIVE));
+			pa_log_info("UCM Verb %s set to Inactive", ucm_verb);
+
+		}
+	}
+
+	/* If there are no concurrent use-cases running */
+	else{
+		if (!strncmp(current_use_case_verb, ucm_verb, strlen(ucm_verb))){
+			err = snd_use_case_set(u->ucm_mgr, "_verb", SND_USE_CASE_VERB_INACTIVE);
+			if (err < 0){
+				pa_log_info("UCM Verb %s failed to set and returned err=%d",
+					SND_USE_CASE_VERB_INACTIVE, err);
+				goto sink_input_unlink_end;
+			}
+			strncpy(current_use_case_verb, SND_USE_CASE_VERB_INACTIVE, strlen(SND_USE_CASE_VERB_INACTIVE));
+			current_use_case_verb_active = false;
+			pa_log_info("UCM Verb %s set to Inactive",
+				ucm_verb);
+		}
+		else{
+			pa_log_info("UCM Verb %s is not current active use-case %s", ucm_verb, current_use_case_verb);
+			goto sink_input_unlink_end;
+		}
+	}
+
+sink_input_unlink_end:
+	return PA_HOOK_OK;
+}
+
+static pa_hook_result_t agl_snd_card_utils_source_output_put_cb (void *hook_data,
+                                  void *call_data,
+                                  void *slot_data)
+{
+	const char *ucm_verb;
