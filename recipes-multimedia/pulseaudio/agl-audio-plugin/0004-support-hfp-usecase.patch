 		node->direction = agl_input;
@@ -607,8 +607,6 @@ bool agl_discover_preroute_sink_input(struct userdata *u, pa_sink_input_new_data
 		 /* add to global nodeset */
 		pa_idxset_put (nodeset->nodes, node, &node->index);
 	}
-
-	 /* create NULL sink */
 	if (!node->nullsink)
 		node->nullsink = agl_utils_create_null_sink (u, u->nsnam);
 	if (!node->nullsink)
@@ -616,7 +614,7 @@ bool agl_discover_preroute_sink_input(struct userdata *u, pa_sink_input_new_data
 
 	 /* redirect sink input to NULL sink */
 	sink = agl_utils_get_null_sink (u, node->nullsink);
-
+//sink_input pointer to null sink
 	if (pa_sink_input_new_data_set_sink (data, sink, false))
 		pa_log_debug ("set sink %u for new sink-input", sink->index);
 	else
@@ -790,3 +788,93 @@ void agl_discover_remove_sink_input (struct userdata *u, pa_sink_input *sinp)
 	 /* remove node */
 	agl_node_destroy (u, node);
 }
+
+bool agl_discover_preroute_source_output(struct userdata *u, pa_source_output_new_data *data)
+{
+	pa_core *core;
+	pa_source *source;
+	agl_discover *discover;
+	agl_nodeset *nodeset;
+	pa_proplist *pl;
+	agl_node *node;
+
+	pa_assert (u);
+	pa_assert (data);
+	pa_assert_se (core = u->core);
+	pa_assert_se (discover = u->discover);
+	pa_assert_se (nodeset = u->nodeset);
+	pa_assert_se (pl = data->proplist);
+
+	 /* is this a valid sink input ? */
+	if (!data->client)
+        return true;
+	 /* is there an existing matching node ? */
+	node = agl_node_get_from_data (u, agl_output, data);
+
+	if (!node) {
+		 /* create node */
+		node = agl_node_create (u, NULL);
+		node->direction = agl_output;
+		node->implement = agl_stream;
+		node->type = agl_classify_guess_stream_node_type (u, pl);
+		node->visible = true;
+		node->available = true;
+		node->ignore = true; /* gets ignored initially */
+		node->paname = pa_proplist_gets (pl, PA_PROP_APPLICATION_NAME);
+		node->client = data->client;
+		 /* add to global nodeset */
+		pa_idxset_put (nodeset->nodes, node, &node->index);
+	}
+	return true;
+}
+
+
+
+void agl_discover_add_source_output (struct userdata *u, pa_source_output *soup)
+{
+	agl_node *node;
+
+	pa_assert (u);
+	pa_assert (soup);
+
+	if (!soup->client)
+        return;
+
+	 /* is there an existing matching node ? */
+	node = agl_node_get_from_client (u, soup->client);
+	if (!node) return;
+
+	node->paidx   = soup->index;
+	 /* start routing */
+	agl_router_register_node (u, node);
+	 /* apply priority effects */
+	agl_router_apply_node_priority_effect (u, node, true);
+}
+
+void agl_discover_remove_source_output (struct userdata *u, pa_source_output *soup)
+{
+	agl_nodeset *nodeset;
+	agl_node *node, *n;
+	int priority;
+	uint32_t index;
+
+	pa_assert (u);
+	pa_assert (soup);
+	pa_assert_se (nodeset = u->nodeset);
+
+	if (!soup->client)
+		return;
+
+	 /* is there an existing matching node ? */
+	node = agl_node_get_from_client (u, soup->client);
+	if (!node) return;
+
+	 /* stop routing */
+	agl_router_unregister_node (u, node);
+
+	 /* un-apply priority effects */
+	agl_router_apply_node_priority_effect (u, node, false);
+
+	 /* remove node */
+	agl_node_destroy (u, node);
+}
