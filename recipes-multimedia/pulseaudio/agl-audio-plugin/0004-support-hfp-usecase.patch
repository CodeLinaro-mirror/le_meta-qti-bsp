+struct agl_null_source {
+	char      *name;
+	uint32_t   module_index;
+	uint32_t   source_index;
+};
+
+agl_null_source *agl_utils_create_null_source (struct userdata *u, const char *name)
+{
+	pa_core      *core;
+	pa_module    *module;
+	pa_source      *s, *source;
+	agl_null_source *ns;
+	uint32_t      idx;
+	char          args[256];
+
+	pa_assert (u);
+	pa_assert_se (core = u->core);
+
+	if (!name)
+		name = DEFAULT_NULL_SOURCE_NAME;	/* default is "null.agl" */
+
+	snprintf (args, sizeof(args), "source_name=\"%s.%d\" channels=2", name, agl_utils_new_stamp ());
+	module = pa_module_load (core, "module-null-source", args);
+	source = NULL;
+
+	if (!module) {
+		pa_log ("failed to load null source '%s'", name);
+		return NULL;
+	} else {
+		PA_IDXSET_FOREACH(s, core->sources, idx) {
+			if (s->module && s->module == module) {
+				source = s;
+				pa_log_info("created agl null source named '%s'", name);
+				break;
+			}
+		}
+	}
+
+	ns = pa_xnew0 (agl_null_source, 1);
+	ns->name = pa_xstrdup (name);
+	ns->module_index = module ? module->index : PA_IDXSET_INVALID;
+	ns->source_index = source ? source->index : PA_IDXSET_INVALID;
+
+	return ns;
+}
+
+pa_source *agl_utils_get_source (struct userdata *u, struct agl_null_source *ns)
+{
+	pa_core *core;
+	pa_source *source;
+
+	pa_assert (u);
+	pa_assert_se ((core = u->core));
+
+	return pa_idxset_get_by_index (core->sources, ns->source_index);
+}
+
+
 agl_null_sink *agl_utils_create_null_sink (struct userdata *u, const char *name)
 {
 	pa_core      *core;
