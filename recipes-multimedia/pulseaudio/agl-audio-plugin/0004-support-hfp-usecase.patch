 	return NULL;
 }
 
+pa_source *agl_utils_get_alsa_source (struct userdata *u, const char *name)
+{
+	pa_core *core;
+	pa_source *source;
+	int idx;
+
+	pa_assert (u);
+	pa_assert_se ((core = u->core));
+
+        PA_IDXSET_FOREACH(source, core->sources, idx) {
+		if (source->name && strstr (source->name, "alsa_input")
+		               && strstr (source->name, name))
+				return source;
+        }
+
+	return NULL;
+}
