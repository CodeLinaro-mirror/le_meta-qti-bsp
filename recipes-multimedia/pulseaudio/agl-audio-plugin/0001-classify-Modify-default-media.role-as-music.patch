Subject: [PATCH 1/3] classify: Modify default media.role as music

Signed-off-by: Hugh Guan <hhguan@codeaurora.org>
---
 classify.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/classify.c b/classify.c
index 4d10ce0..d752639 100644
--- a/classify.c
+++ b/classify.c
@@ -39,7 +39,7 @@ agl_node_type agl_classify_guess_stream_node_type (struct userdata *u,  pa_propl
 	role = pa_proplist_gets (pl, PA_PROP_MEDIA_ROLE);
 
 	if (!role)
-		type = agl_node_type_unknown;
+		type = agl_player;
 
 	 /* ask the configuration, see defaults in "config.c" */
 	else if (map = pa_hashmap_get (ns->roles, role))
