From e30453c29bd6ec0605f9a37dd78935ed2d86628b Mon Sep 17 00:00:00 2001
From: Cong Tang <congt@codeaurora.org>
Date: Mon, 14 Nov 2016 14:49:55 +0800
Subject: [PATCH] enable nullsource for capture

---
 discover.c       | 22 +++++++++++++++++-----
 node.c           | 37 +++++++++++++++++++++++++++----------
 node.h           |  2 +-
 snd_card_utils.c | 22 ++++++++++++----------
 snd_card_utils.h |  4 ++--
 switch.c         |  3 ++-
 tracker.c        |  6 ++++++
 utils.c          | 15 +++++++++++++++
 utils.h          |  1 +
 9 files changed, 83 insertions(+), 29 deletions(-)

diff --git a/discover.c b/discover.c
index 55bac3a..283fa44 100644
--- a/discover.c
+++ b/discover.c
@@ -593,7 +593,6 @@ bool agl_discover_preroute_sink_input(struct userdata *u, pa_sink_input_new_data
 	node = agl_node_get_from_data (u, agl_input, data);
 
 	if (!node) {
-		pa_log_debug ("congt create new node");
 		 /* create node */
 		node = agl_node_create (u, NULL);
 		node->direction = agl_input;
@@ -750,7 +749,7 @@ void agl_discover_add_sink_input (struct userdata *u, pa_sink_input *sinp)
 		return;
 
 	 /* is there an existing matching node ? */
-	node = agl_node_get_from_client (u, sinp->client);
+	node = agl_node_get_from_client (u, sinp->client,sinp, agl_input);
 	if (!node) return;
 
 	 /* start routing */
@@ -776,7 +775,7 @@ void agl_discover_remove_sink_input (struct userdata *u, pa_sink_input *sinp)
 		return;
 
 	 /* is there an existing matching node ? */
-	node = agl_node_get_from_client (u, sinp->client);
+	node = agl_node_get_from_client (u, sinp->client, sinp, agl_input);
 	if (!node) return;
 
 	 /* stop routing */
@@ -825,6 +824,19 @@ bool agl_discover_preroute_source_output(struct userdata *u, pa_source_output_ne
 		 /* add to global nodeset */
 		pa_idxset_put (nodeset->nodes, node, &node->index);
 	}
+	if (!node->nullsource)
+		node->nullsource = agl_utils_create_null_source (u, u->nsnam);
+	if (!node->nullsource)
+		return false;
+
+	 /* redirect source output to NULL source */
+	source = agl_utils_get_source (u, node->nullsource);
+	//sink_input pointer to null sink
+	if (pa_source_output_new_data_set_source (data, source, false))
+		pa_log_debug ("set source %u for new source-output", source->index);
+	else
+		pa_log ("can't set source %u for new source-output", source->index);
+
 	return true;
 }
 
@@ -841,7 +853,7 @@ void agl_discover_add_source_output (struct userdata *u, pa_source_output *soup)
         return;
 
 	 /* is there an existing matching node ? */
-	node = agl_node_get_from_client (u, soup->client);
+	node = agl_node_get_from_client (u, soup->client, soup,agl_output);
 	if (!node) return;
 
 	node->paidx   = soup->index;
@@ -866,7 +878,7 @@ void agl_discover_remove_source_output (struct userdata *u, pa_source_output *so
 		return;
 
 	 /* is there an existing matching node ? */
-	node = agl_node_get_from_client (u, soup->client);
+	node = agl_node_get_from_client (u, soup->client,soup, agl_output);
 	if (!node) return;
 
 	 /* stop routing */
diff --git a/node.c b/node.c
index 32e5309..6908660 100644
--- a/node.c
+++ b/node.c
@@ -21,6 +21,7 @@
  */
 #include "node.h"
 #include "router.h"
+#include "classify.h"
 
 #include <pulsecore/idxset.h>
 #include <pulsecore/core-util.h>
@@ -203,10 +204,10 @@ const char *agl_node_type_str (agl_node_type type)
 		case agl_alert:             return "Alert";
 		case agl_event:             return "Event";
 		case agl_system:            return "System";
-		case agl_hfp_wb_downlink:		return "Hfp_wb_downlink";
-		case agl_hfp_wb_uplink:		return "Hfp_wb_uplink";
-		case agl_hfp_downlink:		return "Hfp_downlink";
-		case agl_hfp_uplink:		return "Hfp_uplink";
+		case agl_hfp_wb_downlink:		return "HfpDownlink";
+		case agl_hfp_wb_uplink:		return "HfpUplink";
+		case agl_hfp_downlink:		return "HfpDownlink";
+		case agl_hfp_uplink:		return "HfpUplink";
 		default:                    return "default";
 	}
 }
@@ -239,7 +240,9 @@ agl_node *agl_node_get_from_data (struct userdata *u, agl_direction type, void *
 	if (type == agl_input) {
 		sinp_data = (pa_sink_input_new_data *) data;
 		PA_IDXSET_FOREACH(node, nodeset->nodes, index) {
-			if (node->client == sinp_data->client)
+			if ((node->client == sinp_data->client)
+				&&((node->type) ==  agl_classify_guess_stream_node_type (u, sinp_data->proplist))
+				&& (node->direction == type))
 				return node;
 		}
 	/* output (= source_output) TODO */
@@ -249,21 +252,35 @@ agl_node *agl_node_get_from_data (struct userdata *u, agl_direction type, void *
 	return NULL;
 }
 
-agl_node *agl_node_get_from_client (struct userdata *u, pa_client *client)
+agl_node *agl_node_get_from_client (struct userdata *u, pa_client *client, void *data,agl_direction type)
 {
 	agl_nodeset *nodeset;
 	agl_node *node;
 	uint32_t index;
+	pa_sink_input *sinp_data;
+	pa_source_output *sout_data;
 
 	pa_assert (u);
 	pa_assert (client);
 	pa_assert (nodeset = u->nodeset);
 
-	PA_IDXSET_FOREACH(node, nodeset->nodes, index) {
-		if (node->client == client)
-			return node;
+	if (type == agl_input) {
+		sinp_data = (pa_sink_input *) data;
+		PA_IDXSET_FOREACH(node, nodeset->nodes, index) {
+			if ((node->client == client)
+				&& ((node->type) == agl_classify_guess_stream_node_type (u, sinp_data->proplist))
+				&& (node->direction == type))
+				return node;
+		}
+	} else {
+		sout_data = (pa_source_output *) data;
+		PA_IDXSET_FOREACH(node, nodeset->nodes, index) {
+			if ((node->client == client)
+				&& ((node->type) == agl_classify_guess_stream_node_type (u, sout_data->proplist))
+				&& (node->direction == type))
+				return node;
+		}
 	}
-
 	return NULL;
 }
 
diff --git a/node.h b/node.h
