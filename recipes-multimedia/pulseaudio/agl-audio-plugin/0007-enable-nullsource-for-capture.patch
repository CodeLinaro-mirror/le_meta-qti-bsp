 pa_sink *agl_utils_get_null_sink (struct userdata *, struct agl_null_sink *);
 
 struct agl_null_source *agl_utils_create_null_source (struct userdata *, const char *);
+void agl_utils_destroy_null_source (struct userdata *u, agl_null_source*ns);
 pa_source *agl_utils_get_source (struct userdata *u, struct agl_null_source *ns);
 
 pa_source *agl_utils_get_null_source (struct userdata *u, struct agl_null_sink *ns);
