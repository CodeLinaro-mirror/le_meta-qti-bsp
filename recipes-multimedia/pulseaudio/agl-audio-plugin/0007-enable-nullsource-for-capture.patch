 {
@@ -123,8 +123,8 @@ static pa_hook_result_t agl_snd_card_utils_sink_input_fixate_cb (void *hook_data
 	const char *role;
 	int err = 0;
 
-	pa_log_info("Callback received for sink_input_fixate");
-	pa_sink_input_new_data *data = (pa_sink_input_new_data *)call_data;
+	pa_log_info("Callback received for sink_input_put");
