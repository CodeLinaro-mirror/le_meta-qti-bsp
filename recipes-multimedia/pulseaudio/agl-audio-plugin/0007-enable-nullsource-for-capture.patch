+		                             (PA_HOOK_EARLY + 1), agl_snd_card_utils_sink_input_put_cb, u);
 	pa_hooks.sink_input_unlink = pa_hook_connect (hooks + PA_CORE_HOOK_SINK_INPUT_UNLINK,
 		                             (PA_HOOK_LATE + 1), agl_snd_card_utils_sink_input_unlink_cb, u);
-	pa_hooks.source_output_fixate = pa_hook_connect (hooks + PA_CORE_HOOK_SOURCE_OUTPUT_FIXATE,
-		                                PA_HOOK_EARLY, agl_snd_card_utils_source_output_fixate_cb, u);
+	pa_hooks.source_output_put = pa_hook_connect (hooks + PA_CORE_HOOK_SOURCE_OUTPUT_PUT,
+		                               ( PA_HOOK_EARLY + 1), agl_snd_card_utils_source_output_put_cb, u);
 	pa_hooks.source_output_unlink = pa_hook_connect (hooks + PA_CORE_HOOK_SOURCE_OUTPUT_UNLINK,
 		                                (PA_HOOK_LATE + 1), agl_snd_card_utils_source_output_unlink_cb, u);
 	pa_hooks.sink_input_volume_changed = pa_hook_connect (hooks + PA_CORE_HOOK_SINK_INPUT_VOLUME_CHANGED,
