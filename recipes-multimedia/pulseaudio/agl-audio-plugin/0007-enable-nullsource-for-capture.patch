diff --git a/tracker.c b/tracker.c
index 4614d85..d01bebc 100644
--- a/tracker.c
+++ b/tracker.c
@@ -387,5 +387,11 @@ static pa_hook_result_t source_output_unlink (void *hook_data,
                                               void *call_data,
                                               void *slot_data)
 {
+	/* called by each client when stopping sound */
+	pa_source_output *soup = (pa_source_output *)call_data;
+	struct userdata *u = (struct userdata *)slot_data;
+
+	agl_discover_remove_source_output (u, soup);
+
 	return PA_HOOK_OK;
 }
diff --git a/utils.c b/utils.c
index 63ab521..76f3066 100644
--- a/utils.c
+++ b/utils.c
@@ -103,6 +103,21 @@ pa_source *agl_utils_get_source (struct userdata *u, struct agl_null_source *ns)
 	return pa_idxset_get_by_index (core->sources, ns->source_index);
 }
 
+void agl_utils_destroy_null_source (struct userdata *u, agl_null_source*ns)
+{
+	pa_core      *core;
+	pa_module    *module;
+
+	if (u && (core = u->core)) {
+		if ((module = pa_idxset_get_by_index (core->modules, ns->module_index))){
+			pa_log_info ("unloading null source '%s'", ns->name);
+			pa_module_unload (core, module, false);
+		}
+
+		pa_xfree (ns->name);
+		pa_xfree (ns);
+	}
+}
 
 agl_null_sink *agl_utils_create_null_sink (struct userdata *u, const char *name)
 {
diff --git a/utils.h b/utils.h
index a2f44ee..18e5e8e 100644
