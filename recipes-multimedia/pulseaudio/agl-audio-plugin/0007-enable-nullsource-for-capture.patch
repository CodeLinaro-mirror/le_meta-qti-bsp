 	struct userdata *u = (struct userdata *)slot_data;
 
 	/* Using media role property to find UCM verb in usecasemap list */
@@ -286,7 +286,7 @@ sink_input_unlink_end:
 	return PA_HOOK_OK;
 }
 
-static pa_hook_result_t agl_snd_card_utils_source_output_fixate_cb (void *hook_data,
+static pa_hook_result_t agl_snd_card_utils_source_output_put_cb (void *hook_data,
                                   void *call_data,
                                   void *slot_data)
 {
@@ -294,8 +294,8 @@ static pa_hook_result_t agl_snd_card_utils_source_output_fixate_cb (void *hook_d
 	const char *role;
 	int err = 0;
 
-	pa_log_info("Callback received for source_output_fixate");
-	pa_source_output_new_data *data = (pa_source_output_new_data *)call_data;
+	pa_log_info("Callback received for source_output_put");
+	pa_source_output *data = (pa_source_output *)call_data;
 	struct userdata *u = (struct userdata *)slot_data;
 
 	/* Using media role property to find UCM verb in usecasemap list */
@@ -576,12 +576,14 @@ int agl_snd_card_utils_init (struct userdata *u)
 	pa_assert (u);
 	pa_assert_se (hooks = u->core->hooks);
 
-	pa_hooks.sink_input_fixate = pa_hook_connect (hooks + PA_CORE_HOOK_SINK_INPUT_FIXATE,
-		                             PA_HOOK_EARLY, agl_snd_card_utils_sink_input_fixate_cb, u);
+	/*sink_input_put priority = PA_HOOK_EARLY + 1, later than module-acdb PA_HOOK_EARLY
+	to ensure acdb paramter effective*/
