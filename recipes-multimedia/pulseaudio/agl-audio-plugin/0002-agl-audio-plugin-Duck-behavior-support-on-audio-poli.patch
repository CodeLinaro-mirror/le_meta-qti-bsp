From 476b9a2aadf1540cd71801c08b85d85b63e9c1a2 Mon Sep 17 00:00:00 2001
From: Hugh Guan <hhguan@codeaurora.org>
Date: Tue, 25 Oct 2016 19:04:35 +0800
Subject: [PATCH 2/3] agl-audio-plugin: Duck behavior support on audio policy
 manager

Added duck behavior support in agl-audio-plugin.

Signed-off-by: Hugh Guan <hhguan@codeaurora.org>
---
 config.c |  2 +-
 router.c | 46 ++++++++++++++++++++++++++++++++++++++++++++++
 router.h |  3 +++
 utils.c  | 19 +++++++++++++++++++
 utils.h  |  2 ++
 5 files changed, 71 insertions(+), 1 deletion(-)

diff --git a/config.c b/config.c
index c317e6f..c790835 100644
--- a/config.c
+++ b/config.c
@@ -122,7 +122,7 @@ bool agl_config_dofile (struct userdata *u, const char *path)
 		agl_router_create_rtgroup (u, pa_streq(type, "OUTPUT") ? agl_output : agl_input,
 					      name, card,
 					      pa_streq(name, "phone") ? agl_router_phone_accept : NULL,
-					      pa_streq(name, "phone") ? agl_router_phone_effect : NULL);
+					      agl_router_get_effect_fct (effect_fct));
 	}
 
 	 /* [classmap] section */
diff --git a/router.c b/router.c
index 4ef0180..31f90d5 100644
--- a/router.c
+++ b/router.c
@@ -19,6 +19,8 @@
  * MA 02110-1301 USA.
  *
  */
+#include <pulsecore/pulsecore-config.h> /* required for headers below */
+#include <pulsecore/core-util.h>        /* required for "pa_streq" */
 #include "router.h"
 #include "switch.h"
 #include "zone.h"
@@ -116,6 +118,50 @@ int agl_router_phone_effect (struct userdata *u, agl_rtgroup *rtg, agl_node *nod
 	return 1;
 }
 
+int agl_router_duck_effect (struct userdata *u, agl_rtgroup *rtg, agl_node *node, bool new)
+{
+	pa_assert (u);
+	pa_assert (node);
+
+	if (new)
+		agl_utils_volume_duck (u, node->nullsink, true);
+	else
+		agl_utils_volume_duck (u, node->nullsink, false);
+
+	return 1;
+}
+
+int agl_router_mute_effect (struct userdata *u, agl_rtgroup *rtg, agl_node *node, bool new)
+{
+	pa_assert (u);
+	pa_assert (node);
+
+	if (new)
+		agl_utils_volume_mute(u, node->nullsink, true);
+	else
+		agl_utils_volume_mute(u, node->nullsink, false);
+
+	return 1;
+}
+
+
+agl_rtgroup_effect_t agl_router_get_effect_fct (const char * effect)
+{
+	agl_rtgroup_effect_t effect_fct;
+	if (!effect)
+		effect_fct = agl_router_default_effect;
+	else if (pa_streq (effect, "phone"))
+		effect_fct = agl_router_phone_effect;
+	else if (pa_streq (effect, "duck"))
+		effect_fct = agl_router_duck_effect;
+	else if (pa_streq (effect, "mute"))
+		effect_fct = agl_router_mute_effect;
+	else
+		effect_fct = agl_router_default_effect;
+
+	return effect_fct;
+}
+
 agl_rtgroup *agl_router_create_rtgroup (struct userdata *u, agl_direction type, const char *name, const char *node_desc, agl_rtgroup_accept_t accept, agl_rtgroup_effect_t effect)
 {
 	agl_router *router;
diff --git a/router.h b/router.h
index cc7bf95..999dd8b 100644
--- a/router.h
+++ b/router.h
@@ -75,6 +75,9 @@ bool agl_router_default_accept (struct userdata *, agl_rtgroup *, agl_node *);
 bool agl_router_phone_accept (struct userdata *, agl_rtgroup *, agl_node *);
 int agl_router_default_effect (struct userdata *, agl_rtgroup *, agl_node *, bool);
 int agl_router_phone_effect (struct userdata *, agl_rtgroup *, agl_node *, bool);
+int agl_router_duck_effect (struct userdata *, agl_rtgroup *, agl_node *, bool);
+int agl_router_mute_effect (struct userdata *, agl_rtgroup *, agl_node *, bool);
+agl_rtgroup_effect_t agl_router_get_effect_fct (const char *);
 
 agl_rtgroup *agl_router_create_rtgroup (struct userdata *, agl_direction, const char *, const char *, agl_rtgroup_accept_t, agl_rtgroup_effect_t);
 void agl_router_destroy_rtgroup (struct userdata *, agl_direction, const char *);
diff --git a/utils.c b/utils.c
index a841e2c..0ae2667 100644
--- a/utils.c
+++ b/utils.c
@@ -154,6 +154,25 @@ void agl_utils_volume_ramp (struct userdata *u, struct agl_null_sink *ns, bool u
 	pa_sink_input_set_volume_ramp (sinp, &rampvol, true, false);
 }
 
+void agl_utils_volume_duck (struct userdata *u, struct agl_null_sink *ns, bool up)
+{
+	pa_sink *sink;
+	sink = agl_utils_get_null_sink (u, ns);
+	pa_cvolume cv = *pa_sink_get_volume (sink, false);
+	if (up)
+		pa_cvolume_dec (&cv, PA_VOLUME_NORM/2);
+	else
+		pa_cvolume_inc (&cv, PA_VOLUME_NORM/2);
+	pa_sink_set_volume (sink, &cv, true, false);
+}
+
+void agl_utils_volume_mute (struct userdata *u, struct agl_null_sink *ns, bool up)
+{
+	pa_sink *sink;
+	sink = agl_utils_get_null_sink (u, ns);
+	pa_sink_set_mute(sink, up, false);
+}
+
 const char *agl_utils_get_card_name (pa_card *card)
 {
 	return (card && card->name) ? card->name : "<unknown>";
diff --git a/utils.h b/utils.h
index abe8bef..f18d6af 100644
--- a/utils.h
+++ b/utils.h
@@ -33,6 +33,8 @@ void agl_utils_destroy_null_sink (struct userdata *, struct agl_null_sink *);
 pa_sink *agl_utils_get_null_sink (struct userdata *, struct agl_null_sink *);
 pa_source *agl_utils_get_null_source (struct userdata *, struct agl_null_sink *);
 void agl_utils_volume_ramp (struct userdata *, struct agl_null_sink *, bool);
+void agl_utils_volume_duck (struct userdata *, struct agl_null_sink *, bool);
+void agl_utils_volume_mute (struct userdata *, struct agl_null_sink *, bool);
 
  /* general helper functions */ 
 const char *agl_utils_get_card_name (pa_card *);
-- 
