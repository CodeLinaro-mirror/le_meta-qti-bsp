# /etc/logrotate.d/rsyslog - Ported from Debian

/var/volatile/log/auth.log.*
/var/volatile/log/syslog.*
/var/volatile/log/cron.log.*
/var/volatile/log/daemon.log.*
/var/volatile/log/kern.log.*
/var/volatile/log/lpr.log.*
/var/volatile/log/mail.log.*
/var/volatile/log/user.log.*
/var/volatile/log/mail.info.*
/var/volatile/log/mail.warn.*
/var/volatile/log/mail.err.*
/var/volatile/log/news.crit.*
/var/volatile/log/news.err.*
/var/volatile/log/news.notice.*
/var/volatile/log/debug.*
/var/volatile/log/messages.*
/var/volatile/log/boot.log.*
{
        su root root
        dateext
        dateformat -%Y%m%d_%H:%M:%S
        rotate 10
        missingok
        notifempty
        compress
        nocreate
        createolddir 644 root root
        olddir /data/syslog
}
