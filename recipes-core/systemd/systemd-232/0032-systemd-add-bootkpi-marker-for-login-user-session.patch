From 38b1f9ba5874777ba710315be683c6889949b813 Mon Sep 17 00:00:00 2001
From: Lei wang <leiwan@codeaurora.org>
Date: Mon, 7 May 2018 20:06:06 +0800
Subject: [PATCH] systemd: add bootkpi marker for user session

Change-Id: I67a26acf7e0014ed0f8d19813ed0bba988b18dc6
Signed-off-by: Lei wang <leiwan@codeaurora.org>
---
 src/core/job.c | 41 +++++++++++++++++++++++++++++++++++++++++
 1 file changed, 41 insertions(+)

diff --git a/src/core/job.c b/src/core/job.c
index ac6910a..dc519ee 100644
--- a/src/core/job.c
+++ b/src/core/job.c
@@ -41,6 +41,31 @@
 #include "unit.h"
 #include "virt.h"
 
+#define KPI_VALUE_PATH "/sys/kernel/debug/bootkpi/kpi_values"
+
+#define ARRAY_SIZE(x) (sizeof(x) / sizeof((x)[0][0]))
+
+static const char* bootkpi_unit_list[][3]= {
+        {"systemd-logind.service", "M - agl system session complete", "M - agl first user logined in"},
+        {"user@",                  "M - agl user session start",      "M - agl user session started"},
+        {"ofono.service",          "M - ofono service start",         "M - ofono service complete"}
+};
+
+static inline void write_marker(const char* label)
+{
+        int fd = -1;
+
+        fd = open(KPI_VALUE_PATH, O_WRONLY);
+        if (fd > 0) {
+                write(fd, label, strlen(label));
+                close(fd);
+        } else {
+                log_error("open bootkpi_values failed");
+        }
+
+        return;
+}
+
 Job* job_new_raw(Unit *unit) {
         Job *j;
 
@@ -546,6 +571,14 @@ static int job_perform_on_unit(Job **j) {
                         assert_not_reached("Invalid job type");
         }
 
+        if (t == JOB_START && u->type == UNIT_SERVICE) {
+                for (int i = 0; i < (ARRAY_SIZE(bootkpi_unit_list) / 3); i++) {
+                        if (strneq(u->id, bootkpi_unit_list[i][0], strlen(bootkpi_unit_list[i][0]))) {
+                                write_marker(bootkpi_unit_list[i][1]);
+                        }
+                }
+        }
+
         /* Log if the job still exists and the start/stop/reload function
          * actually did something. */
         *j = manager_get_job(m, id);
@@ -810,6 +843,14 @@ static void job_emit_status_message(Unit *u, JobType t, JobResult result) {
         if (t == JOB_START && result == JOB_DONE && !u->condition_result)
                 return;
 
+        if (t == JOB_DONE && u->type == UNIT_SERVICE) {
+                for (int i = 0; i < (ARRAY_SIZE(bootkpi_unit_list) / 3); i++) {
+                        if (strneq(u->id, bootkpi_unit_list[i][0], strlen(bootkpi_unit_list[i][0]))) {
+                                write_marker(bootkpi_unit_list[i][2]);
+                        }
+                }
+        }
+
         job_log_status_message(u, t, result);
         job_print_status_message(u, t, result);
 }
-- 
1.9.1

