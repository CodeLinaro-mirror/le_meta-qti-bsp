 .../systemd/1_232-r0/external/systemd/rules/99-systemd.rules.in          | 1 +
 1 file changed, 1 insertion(+)

diff --git a/rules/99-systemd.rules.in b/rules/99-systemd.rules.in
index 88780d1..ea273df 100644
--- a/rules/99-systemd.rules.in
+++ b/rules/99-systemd.rules.in
@@ -64,5 +64,6 @@ SUBSYSTEM=="module", KERNEL=="fuse", TAG+="systemd", ENV{SYSTEMD_WANTS}+="sys-fs
 SUBSYSTEM=="module", KERNEL=="configfs", TAG+="systemd", ENV{SYSTEMD_WANTS}+="sys-kernel-config.mount"
 
 SUBSYSTEM=="diag", KERNEL=="diag", TAG+="systemd"
