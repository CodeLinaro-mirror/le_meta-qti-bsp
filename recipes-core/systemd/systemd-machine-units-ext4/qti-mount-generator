set -e

mkdir -p "/run/systemd/system/"

export LIB_MODULES_MOUNT_SERVICE="/run/systemd/system/lib-modules-mount.service"
if grep -q "verity=enabled" /proc/cmdline ; then
    export ENABLE_VERITY="true"
else
    export ENABLE_VERITY="flase"
fi

export VDLKMDEVICE="dev-disk-by\\x2dpartlabel-vendor_dlkm${SLOT_SUFFIX}.device"

touch $LIB_MODULES_MOUNT_SERVICE

echo "# This service is generated by lib/systemd/system-generators/generate-lib-modules-mount" >> $LIB_MODULES_MOUNT_SERVICE
echo "" >> $LIB_MODULES_MOUNT_SERVICE
echo "[Unit]" >> $LIB_MODULES_MOUNT_SERVICE
echo "Description=Mount vendor_dlkm partition to /lib/modules mount point" >> $LIB_MODULES_MOUNT_SERVICE
echo "ConditionDirectoryNotEmpty=!/lib/modules " >> $LIB_MODULES_MOUNT_SERVICE
if [[ "$ENABLE_VERITY" == "true" ]] ; then
    echo "ConditionPathExists=/dev/mapper/vdlkm" >> $LIB_MODULES_MOUNT_SERVICE
fi
echo "" >> $LIB_MODULES_MOUNT_SERVICE
echo "BindsTo=$VDLKMDEVICE" >> $LIB_MODULES_MOUNT_SERVICE
echo "After=$VDLKMDEVICE" >> $LIB_MODULES_MOUNT_SERVICE
echo "Before=local-fs.target systemd-modules-load.service" >> $LIB_MODULES_MOUNT_SERVICE
echo "DefaultDependencies=no" >> $LIB_MODULES_MOUNT_SERVICE
echo "" >> $LIB_MODULES_MOUNT_SERVICE
echo "IgnoreOnIsolate=true" >> $LIB_MODULES_MOUNT_SERVICE
echo "" >> $LIB_MODULES_MOUNT_SERVICE
echo "[Service]" >> $LIB_MODULES_MOUNT_SERVICE
echo "Type=oneshot" >> $LIB_MODULES_MOUNT_SERVICE
echo "RemainAfterExit=yes" >> $LIB_MODULES_MOUNT_SERVICE
echo 'PassEnvironment="SLOT_SUFFIX"' >> $LIB_MODULES_MOUNT_SERVICE
if [[ "$ENABLE_VERITY" == "true" ]] ; then
     echo "ExecStart=/bin/mount -o noexec,nodev,ro,context=system_u:object_r:lib_t:s0 -t ext4 /dev/mapper/vdlkm /lib/modules" >> $LIB_MODULES_MOUNT_SERVICE
else
     echo "ExecStart=/bin/mount -o noexec,nodev,ro,context=system_u:object_r:lib_t:s0 -t ext4 /dev/disk/by-partlabel/vendor_dlkm\${SLOT_SUFFIX} /lib/modules" >> $LIB_MODULES_MOUNT_SERVICE
fi
echo "ExecStartPost=/bin/ln -sf /lib/modules/modules-load.d /run/modules-load.d" >> $LIB_MODULES_MOUNT_SERVICE
echo "" >> $LIB_MODULES_MOUNT_SERVICE
echo "[Install]" >> $LIB_MODULES_MOUNT_SERVICE
echo "WantedBy=local-fs.target systemd-modules-load.service" >> $LIB_MODULES_MOUNT_SERVICE

mkdir -p /run/systemd/system/local-fs.target.requires/
ln -sf ${LIB_MODULES_MOUNT_SERVICE} /run/systemd/system/local-fs.target.requires/lib-modules-mount.service
