/dev/root            /                    auto       defaults              1  1
proc                 /proc                proc       defaults              0  0
devpts               /dev/pts             devpts     mode=0620,gid=5       0  0
tmpfs                /run                 tmpfs      mode=0755,nodev,nosuid,strictatime 0  0
tmpfs                /var/volatile        tmpfs      defaults              0  0

/dev/vdd             /firmware            auto       defaults,nofail,x-systemd.device-timeout=0       0  2
/dev/vdc             /persist             auto       defaults,auto       0  2
/dev/vdb             /data                auto       defaults,auto       0  2
/dev/vde             /dsp                 auto       defaults,nofail,x-systemd.device-timeout=0       0  2

/data                /home                auto       defaults,bind         0  0
# uncomment this if your device has a SD/MMC/Transflash slot
