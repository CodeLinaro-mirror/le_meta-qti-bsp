+/* socketcan definition */
+int sockcan_fd = 0;
+sockaddr_can g_addr;
+
+/* helper functions*/
+void printFrameData(can_ts_rw_property& f)
+{
+        switch (f.val_type) {
+                case 0x100:
+                        printf("%x", f.bval); break;
+                case 0x200:
+                        printf("%x", f.val); break;
+                case 0x400:
+                        printf("%f", f.f_value); break;
+                case 0x203:
+                        printf("%x %x %x %x", f.val_arr[0], f.val_arr[1], f.val_arr[2],
+                                        f.val_arr[3]); break;
+                case 0x403:
+                        printf("%f %f %f %f", f.float_arr[0], f.float_arr[1], f.float_arr[2],
+                                        f.float_arr[3]); break;
+                default:
+                        printf("not recongized!"); break;
+        }
+
+        printf("\n");
+        return;
+}
+
+int findInterface(char * pname, int sock)
+{
+        struct ifreq ifr;
+        ifr.ifr_ifindex = 0;
+        strncpy(ifr.ifr_name, pname, sizeof(ifr.ifr_name));
+        ioctl(sock, SIOCGIFINDEX, &ifr);
+        return ifr.ifr_ifindex;
+}
+
+int canframe_init(int mode)
+{
+        //use can0 as interface in this test
+        sockcan_fd = socket(PF_CAN, SOCK_RAW, CAN_RAW);
+        int sysifNo = findInterface("can0", sockcan_fd);
+        if (sysifNo < 0) {
+            DebugOut(DebugOut::Warning)<<"sysifNo is "<<sysifNo<<endl;
+            return -1;
+        }
+        DebugOut(DebugOut::Warning)<<"sysifNo is "<<sysifNo<<endl;
+        g_addr.can_family = AF_CAN;
+        g_addr.can_ifindex = sysifNo;
+
+        bind(sockcan_fd, (struct sockaddr *)&g_addr, sizeof(g_addr));
+
+        const int timestampOn = 1;
+        int rc = setsockopt(sockcan_fd, SOL_SOCKET, SO_TIMESTAMP, &timestampOn, sizeof(timestampOn));
+        if (rc != 0) {
+	    DebugOut(DebugOut::Warning)<<"createRaw setsockopt returned "<<rc<<" "<<strerror(errno)<<endl;
+            return -1;
+        }
+        // tell the RAW layer to alloc can fd
+        const int canfd = 1;
+        rc = setsockopt(sockcan_fd, SOL_CAN_RAW, CAN_RAW_FD_FRAMES, &canfd, sizeof(canfd));
+        if (rc != 0) {
+	    DebugOut(DebugOut::Warning)<<"createRaw setsockopt returned "<<rc<<" "<<strerror(errno)<<endl;
+            return -1;
+        }
+
+        struct ifreq ifr;
+        strcpy(ifr.ifr_name, "can0");
+        ifr.ifr_data = (char*)&mode; //mode = DRIVER_MODE_AMB
+        rc = ioctl(sockcan_fd, SIOCDEVPRIVATE + 0/*=IOCTL_RELEASE_CAN_BUFFER*/, &ifr);
+        if (rc != 0) {
+	    DebugOut(DebugOut::Warning)<<"releaseCanBuffer ioctl returned "<<rc<<" "<<strerror(errno)<<endl;
+            return -1;
+        }
+
+        return 0;
+}
+
+int canframe_send(can_ts_rw_property* f)
+{
+        int len = sendto(sockcan_fd, f, sizeof(can_ts_rw_property),
+                        0, (struct sockaddr*)&g_addr, sizeof(g_addr));
+        if (len < 0) {
+	    DebugOut(DebugOut::Warning)<<"transmit frame: "<<len<<strerror(errno)<<endl;
+        }
+
+        return len;
+}
+
+int canframe_recv(can_ts_rw_property* f)
+{
+        struct sockaddr_can addr;
+        socklen_t addrl = sizeof(addr);
+        int len = recvfrom(sockcan_fd, f, sizeof(can_ts_rw_property),
+                            0, (struct sockaddr*)&addr, &addrl);
+        if (len < 0) {
+	    DebugOut(DebugOut::Warning)<<"receiving frame: "<<len<<strerror(errno)<<endl;
+        } else {
+	    DebugOut(DebugOut::Warning)<<"receiving frame success: "<<len<<endl;
+            printf("%x, %lx, %x, %x, %d, ", f->id, f->ts, f->zone, f->val_type, f->data_len);
+            printFrameData(*f);
+        }
+
+        return len;
+}
+
+// can_id to index of caninfo
+// 0x73000000 -> 0
+// 0x73000100 -> K_COUNT_00 + 0
+// 0x73000200 -> K_COUNT_00 + K_COUNT_10 + 0
+int id2idx(int id)
+{
+        if(id & 0x73000000 != 0x73000000)
+                return -1;
+
+        if(id & 0x8CFFF000 > 0)
+                return -1;
+
+        return ((id & 0x100)?K_COUNT_00:0) +
+                ((id & 0x200)?(K_COUNT_10+K_COUNT_00):0) +
+                (id & 0xFF);
+}
+
+// transfer property zone to frame zone or
+// frame zone to property zone
+//
+// property zone definition:
+//
+//enum {
+//        None = 0,
+//        Front = 1,
+//        Middle = 1 << 1,
+//        Right = 1 << 2,
+//        Left = 1 << 3,
+//        Rear = 1 << 4,
+//        Center = 1 << 5,
+//        LeftSide = 1 << 6,
+//        RightSide = 1 << 7,
+//        FrontSide = 1 << 8,
+//        BackSide = 1 << 9
+//};
+int pzone2fzone(int zone, int type)
+{
+        if (type == NONE) {
+        } else if (type == ZONE) {
+        } else if (type == SEAT) {
+        } else if (type == DOOR) {
+        } else if (type == WINDOW) {
+        } else {
+            return -1;
+        }
+}
+
+int fzone2pzone(int zone, int type)
+{
+        if (type == NONE) {
+        } else if (type == ZONE) {
+        } else if (type == SEAT) {
+        } else if (type == DOOR) {
+        } else if (type == WINDOW) {
+        } else {
+            return -1;
+        }
+}
