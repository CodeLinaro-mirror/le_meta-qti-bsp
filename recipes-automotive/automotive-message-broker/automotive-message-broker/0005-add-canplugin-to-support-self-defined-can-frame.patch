+
+#include "canplugin.h"
+
+/* headers for thread operation */
+#include "thread.h"
+
+/* headers for socket operation */
+#include "canframe.h"
+
+int mode = 2;
+
+
+/* thread class*/
+class CANDataGen : public CUtil::Thread
+{
+public:
+    CANDataGen(AbstractRoutingEngine* input);
+    virtual bool start();
+
+    virtual void stop();
+
+    AbstractRoutingEngine* re;
+
+private:
+    virtual void run();
+
+private:
+};
+
+CANDataGen *gen = NULL;
+
+CANDataGen::CANDataGen(AbstractRoutingEngine* input)
+{
+    re = input;
+}
+
+bool CANDataGen::start()
+{
+    bool res = CUtil::Thread::start();
+    return res;
+}
+
+void CANDataGen::stop()
+{
+    CUtil::Thread::stop();
+    return;
+}
+
+void CANDataGen::run()
+{
+    while(isRunnable()) {
+            /*mode 2*/
+            can_ts_rw_property f;
+            canframe_recv(&f);
+
+            int idx;
+            if((idx = id2idx(f.id)) == -1) {
+                DebugOut(DebugOut::Warning)<<"receiving wrong id: "<<f.id<<endl;
+                continue;
+            }
+
+            //DebugOut(DebugOut::Warning)<<"receive value is "<<f.f_value<<endl;
+
+            AbstractPropertyType* value = caninfo[idx].v;
+            if (value == NULL) {
+                DebugOut(DebugOut::Warning)<<"VALUE IS NULL"<<endl;
+                continue;
+            }
+
+            if (f.val_type == VALUE_BOOL) {
+                ((BasicPropertyType<bool>*)value)->setValue((bool)f.bval);
+                DebugOut(DebugOut::Warning)<<"receive bool is "<<f.bval<<endl;
+            } else if (f.val_type == VALUE_FLOAT) {
+                ((BasicPropertyType<double>*)value)->setValue((double)((float)f.f_value));
+                DebugOut(DebugOut::Warning)<<"receive float is "<<f.f_value<<endl;
+            } else {
+	        DebugOut(DebugOut::Warning)<<"no matching value type"<<endl;
+                continue;
+            }
+            value->priority = AbstractPropertyType::Instant;
+            value->zone = fzone2pzone(f.zone, caninfo[idx].region_t);
+
+
+            //if (!re) {
+            //    DebugOut(DebugOut::Warning)<<"re is null!"<<endl;
+            //    return;
+            //}
+            //DebugOut(DebugOut::Warning)<<"enter updateproperty!"<<endl;
+            re->updateProperty(value, "becbbef9-6cc8-4b9e-8cd7-2fbe37b9b52a");
+    }
+}
+//----------------------------------------------------------------------------
+// CANPlugin
+//----------------------------------------------------------------------------
+
+// library exported function for plugin loader
+extern "C" void create(AbstractRoutingEngine* routingengine, std::map<std::string, std::string> config)
+{
+
+	AmbPlugin<CANPlugin> * plugin = new AmbPlugin<CANPlugin>(routingengine, config);
+	plugin->init();
+}
+
+//----------------------------------------------------------------------------
+// CANPlugin
+//----------------------------------------------------------------------------
+
+#define ADDPROPERTY(property, default_value, zone_value) \
+			addPropertySupport(zone_value, [](){ \
+				return new property ## Type(default_value); \
+			})
+
+CANPlugin::CANPlugin(AbstractRoutingEngine* re, const map<string, string>& config, AbstractSource& parent) :
+	AmbPluginImpl(re, config, parent)
+{
+	addPropertySupport(
+		Zone::None,
+		[](){
+			StringPropertyType *s = new StringPropertyType("MappingTable", "");
+			s->zone = Zone::None;
+			return s;
+		}
+	);
+
+	ADDPROPERTY(VehicleProperty::FuelLevelX, 0, Zone::None);
+	ADDPROPERTY(VehicleProperty::ExteriorTemperatureX, 0, Zone::None);
+	ADDPROPERTY(VehicleProperty::InteriorTemperatureX, 0, Zone::None);
+	ADDPROPERTY(VehicleProperty::VehicleSpeedX, 0, Zone::None);
+	ADDPROPERTY(VehicleProperty::OdometerX, 0, Zone::None);
+	ADDPROPERTY(VehicleProperty::TirePressureX, 0, Zone::None);
+	ADDPROPERTY(VehicleProperty::TireTemperatureX, 0, Zone::None);
+	ADDPROPERTY(VehicleProperty::WheelBrakeX, false, Zone::None);
+	ADDPROPERTY(VehicleProperty::DoorStatusX, false, Zone::None);
+	ADDPROPERTY(VehicleProperty::SeatBeltStatusX, false, Zone::None);
+	ADDPROPERTY(VehicleProperty::LightHazardX, false, Zone::None);
+	ADDPROPERTY(VehicleProperty::FanAC, false, Zone::None);
+	ADDPROPERTY(VehicleProperty::FanAuto, false, Zone::None);
+	ADDPROPERTY(VehicleProperty::FanRecirc, false, Zone::None);
+	ADDPROPERTY(VehicleProperty::FanRight, false, Zone::None);
+	ADDPROPERTY(VehicleProperty::FanDown, false, Zone::None);
+	ADDPROPERTY(VehicleProperty::FanUp, false, Zone::None);
+
+        if (canframe_init(mode) != 0)
+            return;
+
+        CANDataGen *gen = new CANDataGen(routingEngine);
+        gen->start();
+}
+
+CANPlugin::~CANPlugin()
+{
+}
+
+void CANPlugin::init()
+{
+}
+
+void CANPlugin::propertyChanged(AbstractPropertyType* value)
+{
+	if(!value)
+		return;
+}
+
+AsyncPropertyReply *CANPlugin::setProperty(const AsyncSetPropertyRequest &request)
+{
+        /*mode 2*/
+        int i = 0;
+        can_ts_rw_property* f = (can_ts_rw_property*)malloc(sizeof(can_ts_rw_property));
+        memset(f, 0, sizeof(can_ts_rw_property));
+
+        //TODO: hash search of right caninfo
+        for (i = 0; i < K_PROP_COUNT; i++) {
+                if (strncmp(request.value->name.c_str(), caninfo[i].property,
+                                        request.value->name.length()) == 0) {
+	            DebugOut(DebugOut::Warning)<<"caninfo index is "<<i<<endl;
+                    break;
+                }
+        }
+        if (i == K_PROP_COUNT)
+                return AmbPluginImpl::setProperty(request);
+
+        f->len = 60;
+        f->id = caninfo[i].can_id;
+        f->ts = 0;
+        f->zone = pzone2fzone(request.value->zone, caninfo[i].region_t);
+        f->val_type = caninfo[i].value_t;
+        f->data_len = caninfo[i].value_l;
+        if (caninfo[i].value_t == VALUE_BOOL) {
+            f->bval = (bool)((BasicPropertyType<bool>*)request.value)->basicValue();
+        } else if (caninfo[i].value_t == VALUE_INT32) {
+            f->val = (int32_t)((BasicPropertyType<int32_t>*)request.value)->basicValue();
+        } else {
+	    DebugOut(DebugOut::Warning)<<"no matching value type"<<endl;
+	    return AmbPluginImpl::setProperty(request);
+        }
+
+	DebugOut(DebugOut::Warning)<<"transmit framelen is "<<sizeof(can_ts_rw_property)<<endl;
+        canframe_send(f);
+
+	return AmbPluginImpl::setProperty(request);
+}
