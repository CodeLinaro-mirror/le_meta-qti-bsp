+// Zone::Type FrontRight;
+// Zone::Type FrontLeft;
+// Zone::Type MiddleRight;
+// Zone::Type MiddleLeft;
+// Zone::Type RearRight;
+// Zone::Type RearLeft;
 int pzone2fzone(int zone, int type)
 {
         if (type == NONE) {
+            return ZONE_VAL_NONE;
         } else if (type == ZONE) {
+            if (zone == Zone::FrontLeft) return FRONT_LEFT;
+            else if (zone == Zone::FrontRight) return FRONT_RIGHT;
+            else if (zone == Zone::MiddleLeft) return ROW_1_LEFT;
+            else if (zone == Zone::MiddleRight) return ROW_1_RIGHT;
+            else if (zone == Zone::RearLeft) return REAR_LEFT;
+            else if (zone == Zone::RearRight) return REAR_RIGHT;
+            else return ZONE_N_SUP;
         } else if (type == SEAT) {
+            if (zone == Zone::FrontLeft) return SEAT_DRIVER_LHD;
+            else if (zone == Zone::FrontRight) return SEAT_DRIVER_RHD;
+            else if (zone == Zone::MiddleLeft) return SEAT_ROW_1_PASSENGER_LEFT;
+            else if (zone == Zone::MiddleRight) return SEAT_ROW_1_PASSENGER_RIGHT;
+            else if (zone == Zone::RearLeft) return SEAT_ROW_2_PASSENGER_LEFT;
+            else if (zone == Zone::RearRight) return SEAT_ROW_2_PASSENGER_RIGHT;
+            else return ZONE_N_SUP;
         } else if (type == DOOR) {
+            if (zone == Zone::FrontLeft) return DOOR_ROW_1_LEFT;
+            else if (zone == Zone::FrontRight) return DOOR_ROW_1_RIGHT;
+            else if (zone == Zone::MiddleLeft) return DOOR_ROW_2_LEFT;
+            else if (zone == Zone::MiddleRight) return DOOR_ROW_2_RIGHT;
+            else if (zone == Zone::RearLeft) return DOOR_ROW_3_LEFT;
+            else if (zone == Zone::RearRight) return DOOR_ROW_3_RIGHT;
+            else return ZONE_N_SUP;
         } else if (type == WINDOW) {
+            if (zone == Zone::FrontLeft) return WINDOW_ROW_1_LEFT;
+            else if (zone == Zone::FrontRight) return WINDOW_ROW_1_RIGHT;
+            else if (zone == Zone::MiddleLeft) return WINDOW_ROW_2_LEFT;
+            else if (zone == Zone::MiddleRight) return WINDOW_ROW_2_RIGHT;
+            else if (zone == Zone::RearLeft) return WINDOW_ROW_3_LEFT;
+            else if (zone == Zone::RearRight) return WINDOW_ROW_3_RIGHT;
+            else return ZONE_N_SUP;
         } else {
-            return -1;
+            return ZONE_N_SUP;
         }
 }
 
 int fzone2pzone(int zone, int type)
 {
         if (type == NONE) {
+            return Zone::None;
         } else if (type == ZONE) {
+            if (zone == FRONT_LEFT) return Zone::FrontLeft;
+            else if (zone == FRONT_RIGHT) return Zone::FrontRight;
+            else if (zone == ROW_1_LEFT) return Zone::MiddleLeft;
+            else if (zone == ROW_1_RIGHT) return Zone::MiddleRight;
+            else if (zone == REAR_LEFT) return Zone::RearLeft;
+            else if (zone == REAR_RIGHT) return  Zone::RearRight;
+            else return ZONE_N_SUP;
         } else if (type == SEAT) {
+            if (zone == SEAT_DRIVER_LHD) return Zone::FrontLeft;
+            else if (zone == SEAT_DRIVER_RHD) return Zone::FrontRight;
+            else if (zone == SEAT_ROW_1_PASSENGER_LEFT) return Zone::MiddleLeft;
+            else if (zone == SEAT_ROW_1_PASSENGER_RIGHT) return Zone::MiddleRight;
+            else if (zone == SEAT_ROW_2_PASSENGER_LEFT) return Zone::RearLeft;
+            else if (zone == SEAT_ROW_2_PASSENGER_RIGHT) return  Zone::RearRight;
+            else return ZONE_N_SUP;
         } else if (type == DOOR) {
+            if (zone == DOOR_ROW_1_LEFT) return Zone::FrontLeft;
+            else if (zone == DOOR_ROW_1_RIGHT) return Zone::FrontRight;
+            else if (zone == DOOR_ROW_2_LEFT) return Zone::MiddleLeft;
+            else if (zone == DOOR_ROW_2_RIGHT) return Zone::MiddleRight;
+            else if (zone == DOOR_ROW_3_LEFT) return Zone::RearLeft;
+            else if (zone == DOOR_ROW_3_RIGHT) return  Zone::RearRight;
+            else return ZONE_N_SUP;
         } else if (type == WINDOW) {
+            if (zone == WINDOW_ROW_1_LEFT) return Zone::FrontLeft;
+            else if (zone == WINDOW_ROW_1_RIGHT) return Zone::FrontRight;
+            else if (zone == WINDOW_ROW_2_LEFT) return Zone::MiddleLeft;
+            else if (zone == WINDOW_ROW_2_RIGHT) return Zone::MiddleRight;
+            else if (zone == WINDOW_ROW_3_LEFT) return Zone::RearLeft;
+            else if (zone == WINDOW_ROW_3_RIGHT) return  Zone::RearRight;
+            else return ZONE_N_SUP;
         } else {
-            return -1;
+            return ZONE_N_SUP;
         }
 }
