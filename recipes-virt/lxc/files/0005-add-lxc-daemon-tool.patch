diff --git a/configure.ac b/configure.ac
index f8529c1aa..4ea996b1c 100644
--- a/configure.ac
+++ b/configure.ac
@@ -1104,6 +1104,7 @@ Binaries
    - lxc-start:      $enable_tools
    - lxc-stop:       $enable_tools
    - lxc-top:        $enable_tools
+   - lxc-daemon:     $enable_tools
    - lxc-unfreeze:   $enable_tools
    - lxc-unshare:    $enable_tools
    - lxc-wait:       $enable_tools
diff --git a/src/lxc/Makefile.am b/src/lxc/Makefile.am
index a1955a838..26978db30 100644
--- a/src/lxc/Makefile.am
+++ b/src/lxc/Makefile.am
@@ -309,6 +309,7 @@ bin_PROGRAMS = lxc-attach \
 	       lxc-start \
 	       lxc-stop \
 	       lxc-top \
+	       lxc-daemon \
 	       lxc-unfreeze \
 	       lxc-unshare \
 	       lxc-wait
@@ -1666,6 +1667,94 @@ endif
 endif
 endif
 
+lxc_daemon_SOURCES = tools/lxc_daemon.c \
+		  tools/arguments.c tools/arguments.h
+
+if ENABLE_STATIC_BINARIES
+lxc_daemon_SOURCES += $(liblxc_la_SOURCES)
+lxc_daemon_LDFLAGS = -all-static -pthread
+else
+lxc_daemon_SOURCES += af_unix.c af_unix.h \
+		    caps.c caps.h \
+		    cgroups/cgfsng.c \
+		    cgroups/cgroup.c cgroups/cgroup.h \
+		    cgroups/cgroup2_devices.c cgroups/cgroup2_devices.h \
+		    cgroups/cgroup_utils.c cgroups/cgroup_utils.h \
+		    commands.c commands.h \
+		    commands_utils.c commands_utils.h \
+		    conf.c conf.h \
+		    confile.c confile.h \
+		    confile_utils.c confile_utils.h \
+		    error.c error.h \
+		    file_utils.c file_utils.h \
+		    ../include/netns_ifaddrs.c ../include/netns_ifaddrs.h \
+		    initutils.c initutils.h \
+		    log.c log.h \
+		    lxclock.c lxclock.h \
+		    mainloop.c mainloop.h \
+		    monitor.c monitor.h \
+		    mount_utils.c mount_utils.h \
+		    namespace.c namespace.h \
+		    network.c network.h \
+		    nl.c nl.h \
+		    parse.c parse.h \
+		    process_utils.c process_utils.h \
+		    ringbuf.c ringbuf.h \
+		    start.c start.h \
+		    state.c state.h \
+		    storage/btrfs.c storage/btrfs.h \
+		    storage/dir.c storage/dir.h \
+		    storage/loop.c storage/loop.h \
+		    storage/lvm.c storage/lvm.h \
+		    storage/nbd.c storage/nbd.h \
+		    storage/overlay.c storage/overlay.h \
+		    storage/rbd.c storage/rbd.h \
+		    storage/rsync.c storage/rsync.h \
+		    storage/storage.c storage/storage.h \
+		    storage/storage_utils.c storage/storage_utils.h \
+		    storage/zfs.c storage/zfs.h \
+		    string_utils.c string_utils.h \
+		    sync.c sync.h \
+		    terminal.c terminal.h \
+		    utils.c utils.h \
+		    uuid.c uuid.h \
+		    $(LSM_SOURCES)
+if ENABLE_SECCOMP
+lxc_daemon_SOURCES += seccomp.c lxcseccomp.h
+endif
+
+if !HAVE_STRCHRNUL
+lxc_daemon_SOURCES += ../include/strchrnul.c ../include/strchrnul.h
+endif
+
+if !HAVE_STRLCPY
+lxc_daemon_SOURCES += ../include/strlcpy.c ../include/strlcpy.h
+endif
+
+if !HAVE_STRLCAT
+lxc_daemon_SOURCES += ../include/strlcat.c ../include/strlcat.h
+endif
+
+if !HAVE_OPENPTY
+lxc_daemon_SOURCES += ../include/openpty.c ../include/openpty.h
+endif
+
+if IS_BIONIC
+lxc_daemon_SOURCES += ../include/fexecve.c ../include/fexecve.h \
+		../include/lxcmntent.c ../include/lxcmntent.h
+endif
+
+if !HAVE_GETGRGID_R
+lxc_daemon_SOURCES += ../include/getgrgid_r.c ../include/getgrgid_r.h
+endif
+
+if !HAVE_PRLIMIT
+if HAVE_PRLIMIT64
+lxc_daemon_SOURCES += ../include/prlimit.c ../include/prlimit.h
+endif
+endif
+endif
+
 lxc_top_SOURCES = tools/lxc_top.c \
 		  tools/arguments.c tools/arguments.h
 
diff --git a/src/lxc/tools/lxc_daemon.c b/src/lxc/tools/lxc_daemon.c
new file mode 100644
index 000000000..e6b428b17
--- /dev/null
+++ b/src/lxc/tools/lxc_daemon.c
@@ -0,0 +1,61 @@
+//Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+//SPDX-License-Identifier: LGPL-2.1+
+
+#include <stdio.h>
+#include <unistd.h>
+#include <lxc/lxccontainer.h>
+
+int main(int argc, char *argv[])
+{
+    struct lxc_container *c;
+    const char *name = argv[1];
+    const char *lxcpath = NULL;
+
+    if (argc < 2) {
+        fprintf(stderr, "Usage: %s <container_name>\n", argv[0]);
+        return 1;
+    }
+
+    c = lxc_container_new(name, lxcpath);
+    if (!c) {
+        fprintf(stderr, "Failed to setup lxc_container struct for %s\n", name);
+        return 1;
+    }
+
+    if (!c->is_defined(c)) {
+        fprintf(stderr, "Container %s not defined\n", c->name);
+        lxc_container_put(c);
+        return 1;
+    }
+
+    printf("Daemon started for container: %s\n", c->name);
+
+    while (1) {
+        if (!c->is_running(c)) {
+            printf("Container is stopped. Attempting to start...\n");
+
+            if (!c->start(c, 0, NULL)) {
+                fprintf(stderr, "Failed to start container. Retrying in 5 seconds...\n");
+                sleep(5);
+                continue;
+            } else {
+                printf("Container started successfully.\n");
+                c->wait(c, "RUNNING", 10);
+            }
+        }
+
+        printf("Monitoring container status...\n");
+        bool stopped = c->wait(c, "STOPPED", -1);
+
+        if (stopped) {
+            printf("Detected container exit! Preparing to restart...\n");
+            sleep(1);
+        } else {
+            fprintf(stderr, "LXC wait error.\n");
+            sleep(2);
+        }
+    }
+
+    lxc_container_put(c);
+    return 0;
+}
diff --git a/src/lxc/tools/meson.build b/src/lxc/tools/meson.build
index 3fb8b68a5..241a829fd 100644
--- a/src/lxc/tools/meson.build
+++ b/src/lxc/tools/meson.build
@@ -163,6 +163,9 @@ tools_lxc_stop_sources = files(
 tools_lxc_top_sources = files(
 	'lxc_top.c') + tools_common_sources
 
+tools_lxc_daemon_sources = files(
+	'lxc_daemon.c') + tools_common_sources
+
 tools_lxc_unfreeze_sources = files(
 	'lxc_unfreeze.c') + tools_common_sources
 
@@ -298,6 +301,13 @@ public_programs += executable(
 		dependencies : liblxc_dep,
                 install : true)
 
+public_programs += executable(
+                'lxc-daemon',
+		tools_lxc_daemon_sources,
+                include_directories : tools_liblxc_includes,
+		dependencies : liblxc_dep,
+                install : true)
+
 public_programs += executable(
                 'lxc-unfreeze',
 		tools_lxc_unfreeze_sources,
