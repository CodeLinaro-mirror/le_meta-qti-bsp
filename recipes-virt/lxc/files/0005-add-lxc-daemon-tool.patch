 src/lxc/Makefile.am        | 89 ++++++++++++++++++++++++++++++++++++++
 src/lxc/tools/lxc_daemon.c | 61 ++++++++++++++++++++++++++
 src/lxc/tools/meson.build  | 10 +++++
 4 files changed, 161 insertions(+)
