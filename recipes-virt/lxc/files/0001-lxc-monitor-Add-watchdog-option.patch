From f7f4ef13c4d6952b29a081a22c1490a2e0a69e56 Mon Sep 17 00:00:00 2001
From: huayzhon <huayzhon@qti.qualcomm.com>
Date: Mon, 23 Mar 2026 18:48:13 +0800
Subject: [PATCH] lxc-monitor: Add watchdog option

This patch adds watchdog functionality to lxc-monitor,
allowing it to automatically restart containers when they stop.

Signed-off-by: huayzhon <huayzhon@qti.qualcomm.com>
---
 src/lxc/tools/lxc_monitor.c | 247 +++++++++++++++++++++++++++++++++++-
 1 file changed, 245 insertions(+), 2 deletions(-)

diff --git a/src/lxc/tools/lxc_monitor.c b/src/lxc/tools/lxc_monitor.c
index 6065f2683..ed7591722 100644
--- a/src/lxc/tools/lxc_monitor.c
+++ b/src/lxc/tools/lxc_monitor.c
@@ -16,6 +16,7 @@
 #include <sys/param.h>
 #include <sys/socket.h>
 #include <sys/stat.h>
+#include <sys/syscall.h>
 #include <sys/types.h>
 #include <sys/un.h>
 #include <sys/wait.h>
@@ -32,8 +33,18 @@
 #include "utils.h"
 
 #define LXC_MONITORD_PATH LIBEXECDIR "/lxc/lxc-monitord"
+#define LXC_MONITORD_PATH_HLOS "/vendor_early_services/vendor/vm-system/" LIBEXECDIR "/lxc/lxc-monitord"
 
 static bool quit_monitord;
+static bool watchdog_mode;
+
+static volatile sig_atomic_t quit_watchdog;
+
+static void watchdog_sig_handler(int sig)
+{
+	(void)sig;
+	quit_watchdog = 1;
+}
 
 lxc_log_define(lxc_monitor, lxc);
 
@@ -43,6 +54,9 @@ static int my_parser(struct lxc_arguments *args, int c, char *arg)
 	case 'Q':
 		quit_monitord = true;
 		break;
+	case 'W':
+		watchdog_mode = true;
+		break;
 	}
 
 	return 0;
@@ -50,6 +64,7 @@ static int my_parser(struct lxc_arguments *args, int c, char *arg)
 
 static const struct option my_longopts[] = {
 	{"quit", no_argument, 0, 'Q'},
+	{"watchdog", no_argument, 0, 'W'},
 	LXC_COMMON_OPTIONS
 };
 
@@ -63,7 +78,8 @@ lxc-monitor monitors the state of the NAME container\n\
 Options :\n\
   -n, --name=NAME   NAME of the container\n\
                     NAME may be a regular expression\n\
-  -Q, --quit        tell lxc-monitord to quit\n",
+  -Q, --quit        tell lxc-monitord to quit\n\
+  -W, --watchdog       restart container when it stops (daemonize)\n",
 	.name     = ".*",
 	.options  = my_longopts,
 	.parser   = my_parser,
@@ -146,6 +162,13 @@ static int lxc_tool_monitord_spawn(const char *lxcpath)
 		NULL,
 	};
 
+	char *const args_hlos[] = {
+		LXC_MONITORD_PATH_HLOS,
+		(char *)lxcpath,
+		pipefd_str,
+		NULL,
+	};
+
 	/* double fork to avoid zombies when monitord exits */
 	pid1 = fork();
 	if (pid1 < 0) {
@@ -210,18 +233,177 @@ static int lxc_tool_monitord_spawn(const char *lxcpath)
 		_exit(EXIT_FAILURE);
 	}
 
+	execvp(args_hlos[0], args_hlos);
 	execvp(args[0], args);
 	SYSERROR("Failed to exec lxc-monitord");
 
 	_exit(EXIT_FAILURE);
 }
 
+/*
+ * watchdog_do_restart - restart a named container with exponential back-off.
+ *
+ * Called both when a STOPPED message is received via the monitor socket and
+ * when a poll() timeout reveals the container is no longer running (e.g.
+ * after lxc-start was killed with SIGKILL and never sent a STOPPED
+ * notification).
+ */
+static void watchdog_do_restart(const char *name, const char *lxcpath)
+{
+	struct lxc_container *c;
+	int try, max_tries = 8;
+
+	INFO("'%s' stopped, restarting...", name);
+
+	for (try = 0; try < max_tries; try++) {
+		if (try > 0) {
+			INFO("'%s' restart attempt %d/%d after %us",
+			     name, try + 1, max_tries, 1 << (try - 1));
+			poll(NULL, 0, (int)((1 << (try - 1)) * 1000));
+		}
+
+		c = lxc_container_new(name, lxcpath);
+		if (!c) {
+			ERROR("Failed to create container handle for '%s'", name);
+			continue;
+		}
+
+		/* Confirm the container is not already running to avoid a race. */
+		if (c->is_running(c)) {
+			INFO("'%s' is already running", name);
+			lxc_container_put(c);
+			return;
+		}
+
+		if (c->start(c, 0, NULL)) {
+			INFO("'%s' restarted successfully", name);
+			lxc_container_put(c);
+			return;
+		}
+
+		ERROR("Failed to restart '%s': %s", name, c->error_string);
+		lxc_container_put(c);
+	}
+
+	ERROR("'%s' failed to restart after %d attempts, giving up", name, max_tries);
+}
+
+/*
+ * watchdog_run - poll-based watchdog loop (no socket/monitord dependency).
+ *
+ * Instead of subscribing to LXC state-change events via the monitor socket,
+ * this function directly polls the container's init process file descriptor
+ * (pidfd).  A pidfd becomes readable (POLLIN) the instant the process exits,
+ * giving reliable, zero-latency death detection without any dependency on
+ * lxc-monitord.
+ *
+ * Flow per iteration:
+ *   1. Wait (with 1-second poll intervals) until the container is running.
+ *   2. Obtain a pidfd for the init process:
+ *        a. Try c->init_pidfd(c)  – preferred, no extra syscall.
+ *        b. Fall back to pidfd_open(init_pid, 0) if init_pidfd() fails.
+ *   3. poll(POLLIN) on the pidfd with a 1-second timeout so that
+ *      SIGTERM/SIGINT (quit_watchdog) can be handled promptly.
+ *   4. On POLLIN (process exited), call watchdog_do_restart() and loop.
+ */
+static void watchdog_run(const char *name, const char *lxcpath)
+{
+	for (;;) {
+		struct lxc_container *c;
+		int watch_fd = -1;
+		pid_t init_pid_val = -1;
+		struct pollfd pfd;
+		int ret;
+
+		if (quit_watchdog)
+			return;
+
+		/* Step 1: wait until the container is running. */
+		for (;;) {
+			if (quit_watchdog)
+				return;
+
+			c = lxc_container_new(name, lxcpath);
+			if (c) {
+				if (c->is_running(c))
+					break;
+				lxc_container_put(c);
+				c = NULL;
+			}
+			/* 1-second sleep between checks. */
+			poll(NULL, 0, 1000);
+		}
+
+		/*
+		 * Step 2: obtain a pidfd for the init process.
+		 *
+		 * init_pidfd() asks the running lxc-start daemon for its
+		 * pidfd via a single command socket round-trip and returns
+		 * a new file descriptor that we own.
+		 */
+		watch_fd    = c->init_pidfd(c);
+		init_pid_val = c->init_pid(c);
+		lxc_container_put(c);
+
+		if (watch_fd < 0) {
+			ERROR("Failed to obtain pidfd for '%s' (init_pid=%d), "
+			      "retrying in 1s", name, (int)init_pid_val);
+			poll(NULL, 0, 1000);
+			continue;
+		}
+
+		INFO("Watching init_pid %d for container '%s' via pidfd %d",
+		     (int)init_pid_val, name, watch_fd);
+
+		/*
+		 * Step 3: poll the pidfd until the init process exits.
+		 *
+		 * Use a 1-second timeout so that SIGTERM/SIGINT (which set
+		 * quit_watchdog) are handled promptly even while blocking.
+		 */
+		pfd.fd     = watch_fd;
+		pfd.events = POLLIN;
+
+		for (;;) {
+			pfd.revents = 0;
+			ret = poll(&pfd, 1, 1000);
+
+			if (quit_watchdog) {
+				close(watch_fd);
+				return;
+			}
+
+			if (ret > 0)
+				break; /* POLLIN: init process has exited */
+
+			if (ret < 0 && errno != EINTR) {
+				SYSERROR("poll() on pidfd for '%s' failed", name);
+				break;
+			}
+			/* ret == 0 (timeout) or EINTR: keep waiting */
+		}
+
+		close(watch_fd);
+
+		if (ret < 0)
+			continue; /* poll error – retry from the top */
+
+		/* Step 4: init process exited – restart the container. 
+		 * Delay 300ms to wait lxc exit done
+		 */
+		poll(NULL, 0, 300);
+		INFO("'%s' init process %d exited, triggering restart",
+		     name, (int)init_pid_val);
+		watchdog_do_restart(name, lxcpath);
+	}
+}
+
 int main(int argc, char *argv[])
 {
 	char *regexp;
 	struct lxc_msg msg;
 	regex_t preg;
-	struct pollfd *fds;
+	struct pollfd *fds = NULL;
 	nfds_t nfds;
 	int len, rc_main, rc_snp, i;
 	struct lxc_log log;
@@ -243,6 +425,7 @@ int main(int argc, char *argv[])
 		if (lxc_log_init(&log))
 			exit(rc_main);
 	}
+	DEBUG("Starting lxc-monitor with watchdog_mode %u", watchdog_mode);
 
 	if (quit_monitord) {
 		int ret = EXIT_SUCCESS;
@@ -288,6 +471,66 @@ int main(int argc, char *argv[])
 		goto error;
 	}
 
+	/* In watchdog mode, daemonize and run the poll-based loop.
+	 * No socket connection to lxc-monitord is needed.         */
+	if (watchdog_mode) {
+		pid_t pid1, pid2;
+		int   fd;
+		struct sigaction sa;
+
+		/* First fork: parent exits so the shell prompt returns. */
+		pid1 = fork();
+		if (pid1 < 0) {
+			SYSERROR("Failed to fork");
+			goto cleanup;
+		}
+		if (pid1 > 0)
+			exit(EXIT_SUCCESS);
+
+		/* Create a new session to detach from the controlling terminal. */
+		if (setsid() < 0) {
+			SYSERROR("Failed to setsid");
+			goto cleanup;
+		}
+
+		/* Second fork: drop Session Leader status so the process
+		 * can never reacquire a controlling terminal.            */
+		pid2 = fork();
+		if (pid2 < 0) {
+			SYSERROR("Failed to fork");
+			goto cleanup;
+		}
+		if (pid2 > 0)
+			exit(EXIT_SUCCESS);
+
+		(void)chdir("/");
+
+		/* stdout/stderr are owned by the lxc log system.
+		 * Only redirect stdin to /dev/null.             */
+		fd = open("/dev/null", O_RDONLY);
+		if (fd >= 0) {
+			dup2(fd, STDIN_FILENO);
+			if (fd > STDIN_FILENO)
+				close(fd);
+		}
+
+		/* SIGTERM/SIGINT set the quit flag; the 1-second poll
+		 * timeout detects it and breaks out of the loop.     */
+		sigemptyset(&sa.sa_mask);
+		sa.sa_flags   = 0;
+		sa.sa_handler = watchdog_sig_handler;
+		sigaction(SIGTERM, &sa, NULL);
+		sigaction(SIGINT,  &sa, NULL);
+
+		INFO("watchdog daemonized for '%s'", my_args.name);
+
+		/* Run the poll-based watchdog loop (no monitord socket needed). */
+		watchdog_run(my_args.name, my_args.lxcpath[0]);
+		rc_main = 0;
+		goto cleanup;
+	}
+
+	/* Non-watchdog mode: open socket connections to lxc-monitord. */
 	fds = malloc(my_args.lxcpath_cnt * sizeof(struct pollfd));
 	if (!fds) {
 		ERROR("Out of memory");
